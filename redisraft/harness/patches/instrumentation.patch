+#include "tla_trace.h"
+/* Helper: extract node ID from a config change entry's data.
+ * Uses the get_node_id callback if available, else returns -1. */
+static raft_node_id_t __raft_trace_get_cfg_node_id(raft_server_t *me, raft_entry_t *ety) {
+    if (me->cb.get_node_id) {
+        return me->cb.get_node_id(me, me->udata, ety, 0);
+    }
+    return RAFT_NODE_ID_NONE;
+}
+#endif
