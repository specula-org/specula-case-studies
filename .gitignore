# Full local archive payloads
#
# Manifests and file inventories remain tracked as audit anchors. The complete
# captures stay on this machine and in the verified archive backup.
/systems/*/modules/*/runs/*/.record/source-indexes/
/systems/*/modules/*/runs/*/.record/source-snapshots/
/systems/*/modules/*/runs/*/.record/source-ref.json
**/.specula-output/

# Nested source checkouts
**/.git/
**/repo/

# Build products and dependency caches
**/build*/
**/target/
**/target-*/
**/target_*/
**/*-target/
**/bin/Debug/
**/bin/Release/
**/obj/Debug/
**/obj/Release/
**/node_modules/
*.o
*.a
*.so
*.dylib
*.dll
*.exe
*.class
*.jar
*.war
*.test

# Model-checker and trace scratch data
**/states/
**/output/
**/traces/
*_TTrace_*.tla
*.st
*.fp
*.bin
*.dot
*.ndjson
*.ndjson.raw
*counterexample*.json
*_ce.json

# Agent/runtime scratch data
*.pid
*.log
*.raw.json
*.usage.json
nohup*.out
.prompts/
.prompt.md
.prompt-extra.md
*-prompt.md
harness-baseline-*/

# Python caches and local environments
__pycache__/
*.py[cod]
.venv/
venv/

# Editor, operating-system, and temporary files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~
*.partial
*.tmp
