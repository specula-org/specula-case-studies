 #[derive(Default)]
 #[repr(align(4))]
@@ -195,6 +204,17 @@ impl Slots {
     pub(super) fn slot(&self) -> &Debt {
         &self.slot
     }

+    /// Test-only: reset the helping slot back to a clean state.  Used by the
+    /// generation-wrap reproduction test to clean up the control word it
+    /// leaves set to GEN_TAG when `confirm_helping` panics, so subsequent
