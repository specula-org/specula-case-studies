# instrumentation.patch
# TLA+ trace instrumentation additions to libspdm SPDM 1.3 event subscription code
# Guarded by #ifdef TLA_TRACE_ENABLED / #endif — zero overhead when not defined
# Apply with: patch -p0 < instrumentation.patch  (from libspdm-events root)

--- a/library/spdm_responder_lib/libspdm_rsp_key_exchange.c
+++ b/library/spdm_responder_lib/libspdm_rsp_key_exchange.c
@@ -6,8 +6,8 @@
 
 #include "internal/libspdm_responder_lib.h"
 #include "internal/libspdm_secured_message_lib.h"
+#ifdef TLA_TRACE_ENABLED
+#include "tla_trace.h"
 #endif
 
 #if LIBSPDM_ENABLE_CAPABILITY_KEY_EX_CAP

@@ -818,15 +818,15 @@
         session_info->session_policy = spdm_request->session_policy;
     }
     libspdm_set_session_state(spdm_context, session_id, LIBSPDM_SESSION_STATE_HANDSHAKING);
+#ifdef TLA_TRACE_ENABLED
     {
         bool tla_with_event_all =
             ((spdm_request->header.spdm_version >= SPDM_MESSAGE_VERSION_13) &&
              ((spdm_request->session_policy &
                SPDM_KEY_EXCHANGE_REQUEST_SESSION_POLICY_EVENT_ALL_POLICY) != 0));
+        tla_emit_key_exchange(tla_with_event_all);
     }
+#endif /* TLA_TRACE_ENABLED */
 
     return LIBSPDM_STATUS_SUCCESS;
 }

