diff --git a/artifact/libspdm/include/tla_trace.h b/artifact/libspdm/include/tla_trace.h
new file mode 100644
index 0000000..42a8451
--- /dev/null
+++ b/artifact/libspdm/include/tla_trace.h
@@ -0,0 +1,172 @@
+/* tla_trace.h -- NDJSON trace emission for libspdm PSK exchange harness
+ * One-file header: include it in each instrumented translation unit.
+ * File path is controlled by TLA_TRACE_FILE env var; default /tmp/trace.ndjson.
+ */
+#ifndef TLA_TRACE_H
+#define TLA_TRACE_H
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#include <stdint.h>
+#include <stdbool.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* ------------------------------------------------------------------
+ * File handle — opened lazily on first emit, never closed (process exit
+ * flushes it).  Two compilation units can both include this header; the
+ * static storage means each TU gets its own copy of the pointer.  Guard
+ * with a process-wide flag via a shared name:
+ *   we use a single .c file that defines g_tla_trace_fp externally.
+ * But for simplicity we use a single static per TU and guard with the env var.
+ * ------------------------------------------------------------------ */
+
+/* External linkage declaration — defined once in psk_trace_test.c */
+extern FILE *g_tla_trace_fp;
+
+/* ------------------------------------------------------------------
+ * Timestamp: epoch seconds * 1e9 (ANSI C99; avoids POSIX clock_gettime)
+ * ------------------------------------------------------------------ */
+static inline long long tla_ts_ns(void) {
+    return (long long)time(NULL) * 1000000000LL;
+}
+
+/* ------------------------------------------------------------------
+ * Low-level emit
+ * ------------------------------------------------------------------ */
+static inline void tla_emit_raw(const char *line) {
+    if (!g_tla_trace_fp) return;
+    fputs(line, g_tla_trace_fp);
+    fputc('\n', g_tla_trace_fp);
+    fflush(g_tla_trace_fp);
+}
+
+/* ------------------------------------------------------------------
+ * Mappings: C values → TLA+ strings
+ * ------------------------------------------------------------------ */
+
+/* LIBSPDM_SESSION_STATE_NOT_STARTED=0, HANDSHAKING=1, ESTABLISHED=2 */
+static inline const char *tla_state_str(int s) {
+    if (s == 1) return "HANDSHAKING";
+    if (s == 2) return "ESTABLISHED";
+    return "NOT_STARTED";
+}
+
+/* 0x1100 = SECURED_SPDM_VERSION_11 << SPDM_VERSION_NUMBER_SHIFT_BIT */
+#define TLA_VALID_VER ((uint16_t)0x1100u)
+
+static inline const char *tla_ver_str(uint16_t v) {
+    if (v == 0) return "V_NONE";
+    if (v == TLA_VALID_VER) return "V_VALID";
+    return "V_ALT";
+}
+
+/* ------------------------------------------------------------------
+ * Per-event emitters
+ * ------------------------------------------------------------------ */
+
+static inline void tla_emit_send_psk_exchange(uint32_t session_id,
+                                              bool has_opaque)
+{
+    char buf[512];
+    snprintf(buf, sizeof(buf),
+        "{\"tag\":\"trace\",\"ts\":\"%lld\","
+        "\"event\":\"SendPskExchange\",\"role\":\"requester\","
+        "\"session_id\":%u,\"session_state\":\"NOT_STARTED\","
+        "\"session_version\":\"V_NONE\",\"hmac_verified\":false,"
+        "\"has_opaque\":%s}",
+        tla_ts_ns(), session_id,
+        has_opaque ? "true" : "false");
+    tla_emit_raw(buf);
+}
+
+static inline void tla_emit_get_response_psk_exchange(uint32_t session_id)
+{
+    /* Emit PRE-STATE of GetResponsePskExchange (what ValidatePostStateRsp checks).
+     * - session_state: always NOT_STARTED (spec precondition)
+     * - session_version: always V_NONE (not yet assigned)
+     * - has_opaque: always false (rsp_has_opaque = FALSE before first call)
+     * - negotiated_version: always V_NONE (rsp_negotiated_version = V_NONE before first call)
+     * Actual opaque/version is driven by the message bag set in SendPskExchange. */
+    char buf[512];
+    snprintf(buf, sizeof(buf),
+        "{\"tag\":\"trace\",\"ts\":\"%lld\","
+        "\"event\":\"GetResponsePskExchange\",\"role\":\"responder\","
+        "\"session_id\":%u,\"session_state\":\"NOT_STARTED\","
+        "\"session_version\":\"V_NONE\",\"has_opaque\":false,"
+        "\"negotiated_version\":\"V_NONE\"}",
+        tla_ts_ns(), session_id);
+    tla_emit_raw(buf);
+}
+
+static inline void tla_emit_recv_psk_exchange_rsp(
+    uint32_t session_id, uint16_t neg_ver)
+{
+    /* Emit PRE-STATE fields + negotiated_version (POST-state, drives spec).
+     * - session_state: always HANDSHAKING (spec precondition)
+     * - session_version: always V_NONE (not yet set before RecvPskExchangeRsp)
+     * - hmac_verified: always false (not yet verified before RecvPskExchangeRsp)
+     * - negotiated_version: actual version negotiated; constrains req_negotiated_version' */
+    char buf[512];
+    snprintf(buf, sizeof(buf),
+        "{\"tag\":\"trace\",\"ts\":\"%lld\","
+        "\"event\":\"RecvPskExchangeRsp\",\"role\":\"requester\","
+        "\"session_id\":%u,\"session_state\":\"HANDSHAKING\","
+        "\"session_version\":\"V_NONE\",\"hmac_verified\":false,"
+        "\"negotiated_version\":\"%s\"}",
+        tla_ts_ns(), session_id,
+        tla_ver_str(neg_ver));
+    tla_emit_raw(buf);
+}
+
+static inline void tla_emit_send_psk_finish(uint32_t session_id,
+                                            int state, uint16_t ver)
+{
+    char buf[256];
+    snprintf(buf, sizeof(buf),
+        "{\"tag\":\"trace\",\"ts\":\"%lld\","
+        "\"event\":\"SendPskFinish\",\"role\":\"requester\","
+        "\"session_id\":%u,\"session_state\":\"%s\","
+        "\"session_version\":\"%s\",\"hmac_verified\":true}",
+        tla_ts_ns(), session_id,
+        tla_state_str(state), tla_ver_str(ver));
+    tla_emit_raw(buf);
+}
+
+static inline void tla_emit_get_response_psk_finish(uint32_t session_id,
+                                                    int state, uint16_t ver)
+{
+    char buf[256];
+    snprintf(buf, sizeof(buf),
+        "{\"tag\":\"trace\",\"ts\":\"%lld\","
+        "\"event\":\"GetResponsePskFinish\",\"role\":\"responder\","
+        "\"session_id\":%u,\"session_state\":\"%s\","
+        "\"session_version\":\"%s\"}",
+        tla_ts_ns(), session_id,
+        tla_state_str(state), tla_ver_str(ver));
+    tla_emit_raw(buf);
+}
+
+static inline void tla_emit_recv_psk_finish_rsp(uint32_t session_id,
+                                                int state, uint16_t ver)
+{
+    char buf[256];
+    snprintf(buf, sizeof(buf),
+        "{\"tag\":\"trace\",\"ts\":\"%lld\","
+        "\"event\":\"RecvPskFinishRsp\",\"role\":\"requester\","
+        "\"session_id\":%u,\"session_state\":\"%s\","
+        "\"session_version\":\"%s\",\"hmac_verified\":true}",
+        tla_ts_ns(), session_id,
+        tla_state_str(state), tla_ver_str(ver));
+    tla_emit_raw(buf);
+}
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* TLA_TRACE_H */
