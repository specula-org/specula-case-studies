diff --git a/raft-java-core/src/test/java/com/github/wenweihu86/raft/service/impl/InstallSnapshotBugTest.java b/raft-java-core/src/test/java/com/github/wenweihu86/raft/service/impl/InstallSnapshotBugTest.java
