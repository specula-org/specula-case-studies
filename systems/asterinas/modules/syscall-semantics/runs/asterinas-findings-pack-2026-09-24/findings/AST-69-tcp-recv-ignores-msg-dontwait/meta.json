  "mechanism": "StreamSocket::recvmsg always goes through SocketPrivate::block_on, which chooses between waiting and a single attempt only from the socket's O_NONBLOCK status, so a per-call MSG_DONTWAIT on a blocking TCP socket is ignored (RecvFlags::SUPPORTED lists only MSG_PEEK and MSG_TRUNC).",
  "sites": [
    "kernel/core/src/net/socket/ip/stream/mod.rs::StreamSocket::recvmsg",
    "kernel/core/src/net/socket/mod.rs::SocketPrivate::block_on",
    "kernel/core/src/syscall/recvfrom.rs::sys_recvfrom",
    "kernel/core/src/net/socket/util/message_flags.rs::RecvFlags"
  ],
  "syscalls": [
    "recvfrom",
    "recvmsg"
  ],
  "keywords": [
