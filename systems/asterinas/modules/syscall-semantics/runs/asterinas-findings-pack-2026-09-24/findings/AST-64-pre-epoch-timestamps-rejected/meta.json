  "mechanism": "vfs_utimes converts each explicit timespec with Duration::try_from, which rejects negative seconds, and do_futimesat rejects `sec < 0` for utimes and futimesat, so every attempt to set a pre-1970 atime or mtime fails with EINVAL.",
  "sites": [
    "kernel/core/src/syscall/utimens.rs::vfs_utimes",
    "kernel/core/src/syscall/utimens.rs::do_futimesat",
    "kernel/core/src/time/mod.rs::TryFrom<timespec_t> for Duration"
  ],
  "syscalls": [
