  "mechanism": "RamInode::read_at and ExfatInode::read_at compute the EOF-limited length but hand the caller's unlimited writer to the page cache; the cache is page-aligned and Vmo::read clips only against capacity, so bytes past the returned count are overwritten (or a fault past EOF becomes EFAULT).",
  "sites": [
    "kernel/core/src/fs/fs_impls/ramfs/fs.rs::RamInode::read_at",
    "kernel/core/src/fs/fs_impls/exfat/inode.rs::ExfatInode::read_at",
    "kernel/core/src/vm/page_cache/mod.rs::PageCache",
    "kernel/core/src/vm/page_cache/vmo/mod.rs::Vmo::read"
  ],
  "syscalls": [
    "read",
    "pread64",
    "readv",
    "preadv"
  ],
  "keywords": [
    "eof",
    "page cache",
    "capacity",
