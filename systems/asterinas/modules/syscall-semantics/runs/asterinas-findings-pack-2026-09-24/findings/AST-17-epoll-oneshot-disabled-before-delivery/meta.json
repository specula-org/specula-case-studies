  "mechanism": "Entry::poll calls Observer::reset_enabled for an EPOLLONESHOT entry while collecting the event, before do_epoll_pwait2 copies it out. An EFAULT leaves the interest disabled, ReadySet::push ignores later notifications, and only EPOLL_CTL_MOD (Entry::update) re-enables it.",
  "sites": [
    "kernel/core/src/events/epoll/entry.rs::Entry::poll",
    "kernel/core/src/syscall/epoll.rs::do_epoll_pwait2",
    "kernel/core/src/events/epoll/file.rs::EpollFile::pop_multi_ready",
    "kernel/core/src/events/epoll/entry.rs::ReadySet::push",
    "kernel/core/src/events/epoll/entry.rs::Entry::update"
  ],
  "syscalls": [
    "epoll_wait",
    "epoll_pwait",
    "epoll_pwait2",
    "epoll_ctl"
  ],
  "keywords": [
    "epoll",
