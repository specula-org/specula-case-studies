diff --git a/Makefile b/Makefile
index 0ee7af9..3679136 100644
--- a/Makefile
+++ b/Makefile
@@ -131,6 +131,18 @@ CARGO_OSDK_BUILD_ARGS += --kcmd-args="INTEL_TDX=$(INTEL_TDX)"
 CARGO_OSDK_BUILD_ARGS += --init-args="/test/run_regression_test.sh"
 else ifeq ($(AUTO_TEST), boot)
 CARGO_OSDK_BUILD_ARGS += --init-args="/test/boot_hello.sh"
+else ifeq ($(AUTO_TEST), specula)
+ENABLE_REGRESSION_TEST := true
+ifeq ($(strip $(SPECULA_SCENARIO)),)
+$(error SPECULA_SCENARIO must name a trace scenario)
+endif
+CARGO_OSDK_BUILD_ARGS += --init-args="/test/io/file_io/specula_trace.sh $(SPECULA_SCENARIO)"
+else ifeq ($(AUTO_TEST), mc1repro)
+ENABLE_REGRESSION_TEST := true
+CARGO_OSDK_BUILD_ARGS += --init-args="/test/io/file_io/specula_repro_mc1.sh"
+else ifeq ($(AUTO_TEST), mc4repro)
+ENABLE_REGRESSION_TEST := true
+CARGO_OSDK_BUILD_ARGS += --init-args="/test/io/file_io/specula_repro_mc4.sh"
 else ifeq ($(AUTO_TEST), vsock)
 ENABLE_REGRESSION_TEST := true
 export VSOCK=on
@@ -312,6 +324,15 @@ else ifeq ($(AUTO_TEST), regression)
 else ifeq ($(AUTO_TEST), boot)
 	@tail --lines 100 qemu.log | grep -q "^Successfully booted." \
 		|| (echo "Boot test failed" && exit 1)
+else ifeq ($(AUTO_TEST), specula)
+	@grep -q "^SPECULA_SCENARIO_DONE $(SPECULA_SCENARIO)" qemu.log \
+		|| (echo "Specula trace scenario failed" && exit 1)
+else ifeq ($(AUTO_TEST), mc1repro)
+	@grep -q "^MC1_REPRO_DONE" qemu.log \
+		|| (echo "MC-1 repro did not complete" && exit 1)
+else ifeq ($(AUTO_TEST), mc4repro)
+	@grep -q "^MC4_REPRO_DONE" qemu.log \
+		|| (echo "MC-4 repro did not complete" && exit 1)
 else ifeq ($(AUTO_TEST), vsock)
 	@tail --lines 100 qemu.log | grep -q "^Vsock test passed." \
 		|| (echo "Vsock test failed" && exit 1)
