diff --git a/test/initramfs/nix/specula/default.nix b/test/initramfs/nix/specula/default.nix
new file mode 100644
index 0000000..a14aded
--- /dev/null
+++ b/test/initramfs/nix/specula/default.nix
@@ -0,0 +1,23 @@
+{ lib, stdenv, glibc, hostPlatform, }:
+stdenv.mkDerivation {
+  pname = "specula-fd-epoll-trace";
+  version = "0.1.0";
+  src = lib.fileset.toSource {
+    root = ./../../src/regression;
+    fileset = lib.fileset.unions [
+      ./../../src/regression/common
+      ./../../src/regression/io/specula
+    ];
+  };
+
+  HOST_PLATFORM = "${hostPlatform.system}";
+  TEST_PLATFORM = "asterinas";
+  CC = "${stdenv.cc.targetPrefix}cc";
+  buildInputs = [ glibc glibc.static ];
+
+  buildCommand = ''
+    mkdir -p $out
+    make --no-print-directory BUILD_DIR=$(mktemp -d) OUTPUT_DIR=$out \
+      -C "$src/io/specula"
+  '';
+}
