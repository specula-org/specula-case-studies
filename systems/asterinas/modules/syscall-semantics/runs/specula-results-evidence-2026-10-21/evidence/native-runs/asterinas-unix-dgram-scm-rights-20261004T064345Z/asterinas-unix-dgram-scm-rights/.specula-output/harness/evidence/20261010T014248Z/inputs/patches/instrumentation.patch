         irq::{IRQ_CHIP, MappedIrqLine},
         kernel::acpi::get_acpi_tables,
     },
+    io::IoMem,
     irq::IrqLine,
-    mm::paddr_to_vaddr,
+    mm::{VmIoOnce, paddr_to_vaddr},
 };
 
 static HPET_INSTANCE: Once<Hpet> = Once::new();
 
+struct TraceClock {
+    registers: IoMem,
+    period: u32,
+}
+
+static TRACE_CLOCK: Once<TraceClock> = Once::new();
+
+/// Enables the shared HPET counter before the private tracing fixture starts.
+pub fn init_trace_clock() {
+    TRACE_CLOCK.call_once(|| {
+        let info = HpetInfo::new(get_acpi_tables().unwrap()).unwrap();
+        let base = info.base_address;
+        // MMIO is outside the RAM direct map and needs its own uncached mapping.
+        let registers = IoMem::acquire(base..base + 4096).unwrap();
+        let capabilities = registers.read_once::<u32>(0).unwrap();
+        assert_ne!(capabilities & 0x2000, 0);
+        let period = registers.read_once::<u32>(4).unwrap();
+        let configuration = registers.read_once::<u32>(0x10).unwrap();
+        // The fixture must not enable firmware timer interrupts or legacy routing.
+        assert_eq!(configuration & 2, 0);
+        for timer in 0..=((capabilities >> 8) & 31) {
+            assert_eq!(
+                registers
+                    .read_once::<u32>(0x100 + timer as usize * 0x20)
+                    .unwrap()
+                    & 4,
+                0
+            );
+        }
+        registers.write_once(0x10, &(configuration | 1)).unwrap();
+        TraceClock { registers, period }
+    });
+}
+
+/// Returns the hardware counter period in femtoseconds.
+pub fn trace_clock_period() -> u32 {
+    TRACE_CLOCK.get().unwrap().period
+}
+
+/// Reads the shared counter without a tracing lock or software sequence number.
+pub fn read_trace_clock() -> u64 {
+    let Some(clock) = TRACE_CLOCK.get() else {
+        return 0;
+    };
+    // SAFETY: MFENCE orders memory effects around the single, uncached MMIO read.
+    unsafe { core::arch::x86_64::_mm_mfence() };
+    let value = clock.registers.read_once::<u64>(0xf0).unwrap();
+    // SAFETY: The fence has no memory-safety preconditions.
+    unsafe { core::arch::x86_64::_mm_mfence() };
+    value
+}
+
 const OFFSET_ID_REGISTER: usize = 0x000;
 const OFFSET_CONFIGURATION_REGISTER: usize = 0x010;
 const OFFSET_INTERRUPT_STATUS_REGISTER: usize = 0x020;
