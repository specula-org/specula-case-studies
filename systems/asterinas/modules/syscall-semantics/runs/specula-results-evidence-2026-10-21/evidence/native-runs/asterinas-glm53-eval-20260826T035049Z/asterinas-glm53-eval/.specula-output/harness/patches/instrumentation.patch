+            return;
+        }
+        file.offset_owner.store(0, Ordering::Relaxed);
+        trace.op.phase = if is_vector(trace.op.kind) {
+            NEED_VECTOR_DISPATCH
+        } else {
+            NEED_SYSCALL_FINISH
+        };
+        let end = timestamp();
+        trace.append("InodeHandleReleaseOffset", start, end, EventArgs::Empty);
+    });
+}
