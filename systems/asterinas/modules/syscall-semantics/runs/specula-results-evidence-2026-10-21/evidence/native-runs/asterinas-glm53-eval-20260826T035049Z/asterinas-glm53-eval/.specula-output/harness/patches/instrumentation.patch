+fn with_trace_mut<R>(f: impl FnOnce(&mut ThreadTrace) -> R) -> Option<R> {
+    let task = Task::current()?;
+    let thread_local = task.as_thread_local()?;
+    Some(f(&mut thread_local.tla_trace().borrow_mut()))
