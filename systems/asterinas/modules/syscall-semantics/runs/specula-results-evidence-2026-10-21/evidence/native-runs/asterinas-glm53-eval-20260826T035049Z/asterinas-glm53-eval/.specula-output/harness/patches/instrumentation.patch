+/// Returns a fenced real TSC timestamp. The harness runs only on x86-64.
+pub(crate) fn timestamp() -> u64 {
+    fence(Ordering::SeqCst);
+    let value = ostd::arch::read_tsc();
+    fence(Ordering::SeqCst);
+    value
+}
