onsole\n-cargo run --example sim\n+cargo test -- --nocapture\n ```\n \n The run will print out a *seed* value such as:\n@@ -42,13 +42,13 @@ Seed: 10693013600028533629\n If the simulation triggers a problem, you can reproduce the exact same run by passing a seed to the simulator:\n \n ```console\n-cargo run --example sim 10693013600028533629\n+SEED=10693013600028533629 cargo test -- --nocapture\n ```\n \n You can also increase logging level to see more output of the run with:\n \n ```console\n-RUST_LOG=debug cargo run --example sim 10693013600028533629\n+RUST_LOG=debug cargo test\n ```\n \n ## References"},{"sha":"17de940eaf8f83aa43247a1a3e5902afdeecbc78","filename":"tests/simulation_test.rs","status":"renamed","additions":8,"deletions":7,"changes":15,"blob_url":"https://github.com/penberg/vsr-rs/blob/a988050893e63eb1aa51ace482f5a2cd093d264a/tests%2Fsimulation_test.rs","raw_url":"https://github.com/penberg/vsr-rs/raw/a988050893e63eb1aa51ace482f5a2cd093d264a/tests%2Fsimulation_test.rs","contents_url":"https://api.github.com/repos/penberg/vsr-rs/contents/tests%2Fsimulation_test.rs?ref=a988050893e63eb1aa51ace482f5a2cd093d264a","patch":"@@ -5,12 +5,13 @@ use rand_chacha::ChaCha8Rng;\n use std::sync::Arc;\n use vsr_rs::{Client, Config, Replica, StateMachine};\n \n-fn main() {\n-    let mut args = std::env::args().skip(1);\n-    let seed = match args.next() {\n-        Some(seed) => seed.parse::<u64>().unwrap(),\n-        None => rand::thread_rng().next_u64(),\n-    };\n+#[test]\n+fn test_simulation() {\n+    let seed = match std::env::var(\"SEED\") {\n+        Ok(seed) => seed.parse::<u64>().unwrap(),\n+        Err(_) => rand::thread_rng().next_u64(),\n+    };    \n+    \n     println!(\"Seed: {}\", seed);\n     env_logger::init();\n     let (client_tx, _client_rx) = crossbeam_channel::unbounded();\n@@ -136,4 +137,4 @@ impl StateMachine<Op> for Accumulator {\n             }\n         }\n     }\n-}\n+}\n\\ No newline at end of file","previous_filename":"examples/sim.rs"}]}