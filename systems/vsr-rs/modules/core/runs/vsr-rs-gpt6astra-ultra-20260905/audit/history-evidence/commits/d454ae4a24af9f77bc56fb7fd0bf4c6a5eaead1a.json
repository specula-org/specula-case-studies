{"sha":"d454ae4a24af9f77bc56fb7fd0bf4c6a5eaead1a","node_id":"C_kwDOIU23VNoAKGQ0NTRhZTRhMjRhZjlmNzdiYzU2ZmI3ZmQwYmY0YzZhNWVhZWFkMWE","commit":{"author":{"name":"Pekka Enberg","email":"penberg@iki.fi","date":"2026-09-03T09:38:54Z"},"committer":{"name":"Pekka Enberg","email":"penberg@iki.fi","date":"2026-09-03T09:38:54Z"},"message":"Viewer: messages move again\n\nThe tick counter in a snapshot is the number of ticks completed, and a\nframe shows the interval before the next one. Measuring a message's\nprogress from the counter itself put every message at its destination\nfor the whole tick. Measure from the last completed tick plus the\nfraction of the next one that has elapsed, so a message sent in the\nlast tick glides from sender to receiver over the current one.","tree":{"sha":"fdb366cc4a613c474033a2070dea63ef42754de3","url":"https://api.github.com/repos/penberg/vsr-rs/git/trees/fdb366cc4a613c474033a2070dea63ef42754de3"},"url":"https://api.github.com/repos/penberg/vsr-rs/git/commits/d454ae4a24af9f77bc56fb7fd0bf4c6a5eaead1a","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/penberg/vsr-rs/commits/d454ae4a24af9f77bc56fb7fd0bf4c6a5eaead1a","html_url":"https://github.com/penberg/vsr-rs/commit/d454ae4a24af9f77bc56fb7fd0bf4c6a5eaead1a","comments_url":"https://api.github.com/repos/penberg/vsr-rs/commits/d454ae4a24af9f77bc56fb7fd0bf4c6a5eaead1a/comments","author":{"login":"penberg","id":81939,"node_id":"MDQ6VXNlcjgxOTM5","avatar_url":"https://avatars.githubusercontent.com/u/81939?v=4","gravatar_id":"","url":"https://api.github.com/users/penberg","html_url":"https://github.com/penberg","followers_url":"https://api.github.com/users/penberg/followers","following_url":"https://api.github.com/users/penberg/following{/other_user}","gists_url":"https://api.github.com/users/penberg/gists{/gist_id}","starred_url":"https://api.github.com/users/penberg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/penberg/subscriptions","organizations_url":"https://api.github.com/users/penberg/orgs","repos_url":"https://api.github.com/users/penberg/repos","events_url":"https://api.github.com/users/penberg/events{/privacy}","received_events_url":"https://api.github.com/users/penberg/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"penberg","id":81939,"node_id":"MDQ6VXNlcjgxOTM5","avatar_url":"https://avatars.githubusercontent.com/u/81939?v=4","gravatar_id":"","url":"https://api.github.com/users/penberg","html_url":"https://github.com/penberg","followers_url":"https://api.github.com/users/penberg/followers","following_url":"https://api.github.com/users/penberg/following{/other_user}","gists_url":"https://api.github.com/users/penberg/gists{/gist_id}","starred_url":"https://api.github.com/users/penberg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/penberg/subscriptions","organizations_url":"https://api.github.com/users/penberg/orgs","repos_url":"https://api.github.com/users/penberg/repos","events_url":"https://api.github.com/users/penberg/events{/privacy}","received_events_url":"https://api.github.com/users/penberg/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"32181e4da5941ddde7310f4c05c9a7817560ea68","url":"https://api.github.com/repos/penberg/vsr-rs/commits/32181e4da5941ddde7310f4c05c9a7817560ea68","html_url":"https://github.com/penberg/vsr-rs/commit/32181e4da5941ddde7310f4c05c9a7817560ea68"}],"stats":{"total":6,"additions":5,"deletions":1},"files":[{"sha":"3ec675c2ad4ab8c31932c6f0dc8a5f35e6802630","filename":"simulator/tui.rs","status":"modified","additions":5,"deletions":1,"changes":6,"blob_url":"https://github.com/penberg/vsr-rs/blob/d454ae4a24af9f77bc56fb7fd0bf4c6a5eaead1a/simulator%2Ftui.rs","raw_url":"https://github.com/penberg/vsr-rs/raw/d454ae4a24af9f77bc56fb7fd0bf4c6a5eaead1a/simulator%2Ftui.rs","contents_url":"https://api.github.com/repos/penberg/vsr-rs/contents/simulator%2Ftui.rs?ref=d454ae4a24af9f77bc56fb7fd0bf4c6a5eaead1a","patch":"@@ -478,7 +478,11 @@ fn draw_cluster(frame: &mut Frame, area: Rect, app: &App, snapshot: &Snapshot) {\n     // Width of one character in canvas units, to center labels.\n     let char_width = (x_bounds[1] - x_bounds[0]) / area.width.max(1) as f64;\n     let line_height = (y_bounds[1] - y_bounds[0]) / area.height.max(1) as f64;\n-    let now = snapshot.tick as f64 + app.carry;\n+    // The snapshot's tick count is the number of ticks completed; the\n+    // frame shows the interval before the next one, `carry` of the way\n+    // through it. A message sent in the last completed tick is `carry` of\n+    // the way to its receiver.\n+    let now = snapshot.tick.saturating_sub(1) as f64 + app.carry;\n     let canvas = Canvas::default()\n         .block(Block::bordered().title(\" cluster \"))\n         .x_bounds(x_bounds)"}]}