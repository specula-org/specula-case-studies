diff --git a/specula_observe.rs b/specula_observe.rs
new file mode 100644
index 0000000000000000000000000000000000000000..2e396eee41c24514444f4beb74fbbb6cc63806ad
--- /dev/null
+++ b/specula_observe.rs
@@ -0,0 +1,371 @@
+//! Read-only access to real VSR state; enabled only for trace collection.
+//!
+//! Serialization bounds live on these accessors, never on protocol handlers.
+//! Execution and received-message provenance are captured by feature-gated
+//! hooks inside the real implementation and remain typed until serialization.
+
+use crate::{Client, LogEntry, Message, Replica, Reply, StateMachine};
+use serde_json::{json, Value};
+use std::collections::BTreeMap;
+use std::fmt::Debug;
+use std::sync::{Mutex, OnceLock};
+
+/// Equality-preserving normalization into the vocabulary of Trace.tla.
+pub trait TraceValue {
+    fn trace_value(&self) -> Value;
+}
+
+fn value_dictionary() -> &'static Mutex<BTreeMap<String, String>> {
+    static VALUES: OnceLock<Mutex<BTreeMap<String, String>>> = OnceLock::new();
+    VALUES.get_or_init(|| {
+        Mutex::new(BTreeMap::from([
+            ("A".to_owned(), "A".to_owned()),
+            ("AA".to_owned(), "AA".to_owned()),
+            ("B".to_owned(), "B".to_owned()),
+        ]))
+    })
+}
+
+/// Register a raw application value before observing it. Registrations never
+/// change an existing value's meaning; callers must preserve equality among
+/// values that occur in the same scenario. This permits a proven long wire
+/// value and its strict prefix to use the finite AA/A trace vocabulary.
+pub fn register_value(raw: &str, normalized: &str) {
+    assert!(
+        matches!(normalized, "A" | "AA" | "B"),
+        "unsupported normalized value: {normalized:?}"
+    );
+    assert_ne!(
+        raw, "nil",
+        "the literal nil value is outside this trace abstraction"
+    );
+    let mut values = value_dictionary()
+        .lock()
+        .expect("trace value dictionary poisoned");
+    if let Some(previous) = values.get(raw) {
+        assert_eq!(
+            previous, normalized,
+            "a registered raw value cannot change meaning"
+        );
+    } else {
+        values.insert(raw.to_owned(), normalized.to_owned());
+    }
+}
+
+pub fn normalize_value(raw: &str) -> Value {
+    let values = value_dictionary()
+        .lock()
+        .expect("trace value dictionary poisoned");
+    json!(values.get(raw).unwrap_or_else(|| panic!(
+        "unregistered application value outside trace abstraction: {raw:?}"
+    )))
+}
+
+impl TraceValue for str {
+    fn trace_value(&self) -> Value {
+        normalize_value(self)
+    }
+}
+
+impl TraceValue for String {
+    fn trace_value(&self) -> Value {
+        normalize_value(self)
+    }
+}
+
+impl TraceValue for Option<String> {
+    fn trace_value(&self) -> Value {
+        self.as_deref().map(normalize_value).unwrap_or(json!("nil"))
+    }
+}
+
+/// Read the actual application value; never reconstruct it from the log.
+pub trait TraceStateMachine: StateMachine {
+    fn trace_app(&self) -> Value;
+}
+
+#[derive(Debug)]
+pub(crate) struct Execution<Input, Output> {
+    pub pos: usize,
+    pub entry: LogEntry<Input>,
+    pub result: Output,
+    pub view: usize,
+}
+
+pub fn neutral_entry() -> Value {
+    json!({"client": -1, "request": -1, "op": {"kind": "Get", "value": "nil"}})
+}
+
+pub fn entry<Op: TraceValue>(e: &LogEntry<Op>) -> Value {
+    json!({"client": e.client_id, "request": e.request_number, "op": e.op.trace_value()})
+}
+
+fn entries<Op: TraceValue>(log: &[LogEntry<Op>]) -> Vec<Value> {
+    log.iter().map(entry).collect()
+}
+
+fn neutral_message(src: usize, dst: usize) -> Value {
+    json!({
+        "kind": "Commit", "src": src, "dst": dst, "view": 0,
+        "opnum": 0, "commit": 0, "entry": neutral_entry(), "log": [],
+        "start": 0, "lastNormal": 0, "nonce": 0, "hasState": false,
+        "result": "nil"
+    })
+}
+
+/// Serialize the exact immutable queued message. For variants with no sender
+/// payload, `src` must be the sender supplied by the real owner/transport.
+pub fn normalize_message<Op: TraceValue>(src: usize, dst: usize, m: &Message<Op>) -> Value {
+    let mut v = neutral_message(src, dst);
+    match m {
+        Message::Request {
+            client_id,
+            request_number,
+            op,
+        } => {
+            assert_eq!(
+                src, *client_id,
+                "request provenance must be the actual client"
+            );
+            v["kind"] = json!("Request");
+            v["entry"] =
+                json!({"client": client_id, "request": request_number, "op": op.trace_value()});
+        }
+        Message::Prepare {
+            view_number,
+            op_number,
+            client_id,
+            request_number,
+            op,
+            commit_number,
+        } => {
+            v["kind"] = json!("Prepare");
+            v["view"] = json!(view_number);
+            v["opnum"] = json!(op_number);
+            v["commit"] = json!(commit_number);
+            v["entry"] =
+                json!({"client": client_id, "request": request_number, "op": op.trace_value()});
+        }
+        Message::PrepareOk {
+            view_number,
+            op_number,
+            replica_id,
+        } => {
+            assert_eq!(src, *replica_id, "PrepareOk sender provenance");
+            v["kind"] = json!("PrepareOk");
+            v["view"] = json!(view_number);
+            v["opnum"] = json!(op_number);
+        }
+        Message::Commit {
+            view_number,
+            commit_number,
+        } => {
+            v["kind"] = json!("Commit");
+            v["view"] = json!(view_number);
+            v["commit"] = json!(commit_number);
+        }
+        Message::GetState {
+            replica_id,
+            view_number,
+            op_number,
+        } => {
+            assert_eq!(src, *replica_id, "GetState sender provenance");
+            v["kind"] = json!("GetState");
+            v["view"] = json!(view_number);
+            v["opnum"] = json!(op_number);
+        }
+        Message::NewState {
+            view_number,
+            log,
+            op_number_start,
+            op_number_end,
+            commit_number,
+        } => {
+            v["kind"] = json!("NewState");
+            v["view"] = json!(view_number);
+            v["log"] = json!(entries(log));
+            v["start"] = json!(op_number_start);
+            v["opnum"] = json!(op_number_end);
+            v["commit"] = json!(commit_number);
+        }
+        Message::StartViewChange {
+            view_number,
+            replica_id,
+        } => {
+            assert_eq!(src, *replica_id, "StartViewChange sender provenance");
+            v["kind"] = json!("StartViewChange");
+            v["view"] = json!(view_number);
+        }
+        Message::DoViewChange {
+            view_number,
+            replica_id,
+            last_normal_view,
+            log,
+            op_number,
+            commit_number,
+        } => {
+            assert_eq!(src, *replica_id, "DoViewChange sender provenance");
+            v["kind"] = json!("DoViewChange");
+            v["view"] = json!(view_number);
+            v["lastNormal"] = json!(last_normal_view);
+            v["log"] = json!(entries(log));
+            v["opnum"] = json!(op_number);
+            v["commit"] = json!(commit_number);
+        }
+        Message::StartView {
+            view_number,
+            log,
+            op_number,
+            commit_number,
+        } => {
+            v["kind"] = json!("StartView");
+            v["view"] = json!(view_number);
+            v["log"] = json!(entries(log));
+            v["opnum"] = json!(op_number);
+            v["commit"] = json!(commit_number);
+        }
+        Message::Recovery {
+            replica_id,
+            nonce,
+            view_number,
+        } => {
+            assert_eq!(src, *replica_id, "Recovery sender provenance");
+            v["kind"] = json!("Recovery");
+            v["nonce"] = json!(nonce);
+            v["view"] = json!(view_number);
+        }
+        Message::RecoveryResponse {
+            view_number,
+            nonce,
+            replica_id,
+            state,
+        } => {
+            assert_eq!(src, *replica_id, "RecoveryResponse sender provenance");
+            v["kind"] = json!("RecoveryResponse");
+            v["view"] = json!(view_number);
+            v["nonce"] = json!(nonce);
+            v["hasState"] = json!(state.is_some());
+            if let Some(state) = state {
+                v["log"] = json!(entries(&state.log));
+                v["commit"] = json!(state.commit_number);
+            }
+        }
+    }
+    v
+}
+
+pub fn normalize_reply<Output: TraceValue>(src: usize, r: &Reply<Output>) -> Value {
+    let mut v = neutral_message(src, r.client_id);
+    v["kind"] = json!("Reply");
+    v["view"] = json!(r.view_number);
+    v["entry"]["client"] = json!(r.client_id);
+    v["entry"]["request"] = json!(r.request_number);
+    v["result"] = r.result.trace_value();
+    v
+}
+
+pub fn replica_snapshot<SM>(r: &Replica<SM>) -> Value
+where
+    SM: TraceStateMachine,
+    SM::Input: TraceValue,
+    SM::Output: TraceValue,
+{
+    assert_eq!(
+        r.observed_dvc.len(),
+        r.do_view_change_from.len(),
+        "DVC provenance and actual map diverged"
+    );
+    assert_eq!(
+        r.observed_recovery_responses.len(),
+        r.recovery_responses.len(),
+        "recovery provenance and actual map diverged"
+    );
+    let acks: Vec<Value> = r
+        .acks
+        .iter()
+        .map(|(opnum, from)| json!({"opnum": opnum, "from": from}))
+        .collect();
+    let table: Vec<Value> = r
+        .client_table
+        .iter()
+        .map(|(client, e)| {
+            json!({
+                "client": client, "request": e.request_number,
+                "hasReply": e.reply.is_some(),
+                "result": e.reply.as_ref().map(TraceValue::trace_value).unwrap_or(json!("nil"))
+            })
+        })
+        .collect();
+    let dvc: Vec<Value> = r
+        .do_view_change_from
+        .iter()
+        .map(|(src, actual)| {
+            let (dst, message) = r
+                .observed_dvc
+                .get(src)
+                .expect("missing DVC reception provenance");
+            let normalized = normalize_message(*src, *dst, message);
+            assert_eq!(normalized["log"], json!(entries(&actual.log)));
+            assert_eq!(normalized["lastNormal"], json!(actual.last_normal_view));
+            assert_eq!(normalized["commit"], json!(actual.commit_number));
+            normalized
+        })
+        .collect();
+    let responses: Vec<Value> = r
+        .recovery_responses
+        .iter()
+        .map(|(src, actual)| {
+            let (dst, message) = r
+                .observed_recovery_responses
+                .get(src)
+                .expect("missing RecoveryResponse reception provenance");
+            let normalized = normalize_message(*src, *dst, message);
+            assert_eq!(normalized["view"], json!(actual.view_number));
+            assert_eq!(normalized["hasState"], json!(actual.state.is_some()));
+            if let Some(state) = &actual.state {
+                assert_eq!(normalized["log"], json!(entries(&state.log)));
+                assert_eq!(normalized["commit"], json!(state.commit_number));
+            }
+            normalized
+        })
+        .collect();
+    let messages: Vec<Value> = r
+        .outbox
+        .iter()
+        .map(|(dst, message)| normalize_message(r.self_id, *dst, message))
+        .collect();
+    let replies: Vec<Value> = r
+        .replies
+        .iter()
+        .map(|reply| normalize_reply(r.self_id, reply))
+        .collect();
+    let executed: Vec<Value> = r.observed_executions.iter().map(|e| json!({
+        "pos": e.pos, "entry": entry(&e.entry), "result": e.result.trace_value(), "view": e.view
+    })).collect();
+    json!({
+        "status": format!("{:?}", r.status), "view": r.view_number,
+        "lastNormal": r.last_normal_view, "log": entries(&r.log), "commit": r.commit_number,
+        "acks": acks, "table": table, "heard": r.heard_from_primary,
+        "waiting": r.idle_periods_waiting, "attempts": r.view_change_attempts,
+        "stable": r.idle_periods_stable, "svc": r.start_view_change_from,
+        "dvcSent": r.do_view_change_sent, "dvc": dvc, "catching": r.catching_up,
+        "nonce": r.recovery_nonce, "responses": responses, "messages": messages,
+        "replies": replies, "app": r.state_machine.trace_app(), "executed": executed
+    })
+}
+
+/// `last_entry` is retained invocation metadata after the real Client clears
+/// pending; pending=true always serializes the real pending request itself.
+pub fn client_snapshot<Op>(c: &Client<Op>, last_entry: &Value) -> Value
+where
+    Op: Clone + Debug + TraceValue,
+{
+    let pending_entry = match &c.pending {
+        Some((request, op)) => {
+            json!({"client": c.client_id, "request": request, "op": op.trace_value()})
+        }
+        None => last_entry.clone(),
+    };
+    json!({"id": c.client_id, "view": c.view_number, "next": c.next_request_number,
+        "pending": c.pending.is_some(), "entry": pending_entry})
+}
