diff --git a/examples/kvstore/specula_frame_probe.rs b/examples/kvstore/specula_frame_probe.rs
new file mode 100644
index 0000000000000000000000000000000000000000..9809cc7a03f22b7730fd6a97ba35ac756d9519bf
--- /dev/null
+++ b/examples/kvstore/specula_frame_probe.rs
@@ -0,0 +1,430 @@
+//! Localhost-only regression experiments using the unchanged kvstore sender,
+//! encoder, decoder, and acceptor. No operation or network payload is invented.
+use super::super::{decode, encode, run_peer_acceptor, run_sender, Event, Frame};
+use super::*;
+use std::io::{ErrorKind, Read};
+use std::net::{Shutdown, TcpListener, TcpStream};
+use std::os::fd::AsRawFd;
+use std::path::Path;
+use std::process::{Child, Command, Stdio};
+use std::sync::{
+    mpsc::{self, Sender},
+    OnceLock,
+};
+use std::time::Duration;
+
+#[derive(Debug)]
+enum LineResult {
+    Ok(usize),
+    Error(ErrorKind),
+    End,
+}
+static OBSERVER: OnceLock<Mutex<Option<Sender<LineResult>>>> = OnceLock::new();
+pub(crate) fn observe_line_result(result: &std::io::Result<String>) {
+    if let Some(tx) = OBSERVER
+        .get_or_init(Default::default)
+        .lock()
+        .unwrap()
+        .as_ref()
+    {
+        let observation = match result {
+            Ok(line) => LineResult::Ok(line.len()),
+            Err(e) => LineResult::Error(e.kind()),
+        };
+        let _ = tx.send(observation);
+    }
+}
+pub(crate) fn observe_connection_end() {
+    if let Some(tx) = OBSERVER
+        .get_or_init(Default::default)
+        .lock()
+        .unwrap()
+        .as_ref()
+    {
+        let _ = tx.send(LineResult::End);
+    }
+}
+unsafe extern "C" {
+    fn setsockopt(fd: i32, level: i32, name: i32, val: *const std::ffi::c_void, len: u32) -> i32;
+}
+fn socket_option<T>(fd: i32, name: i32, value: &T) {
+    // Linux SOL_SOCKET=1, SO_RCVBUF=8, SO_LINGER=13.
+    assert_eq!(
+        unsafe {
+            setsockopt(
+                fd,
+                1,
+                name,
+                value as *const T as *const _,
+                std::mem::size_of::<T>() as u32,
+            )
+        },
+        0
+    );
+}
+fn full_value() -> String {
+    "A".repeat(32 * 1024 * 1024)
+}
+fn hash(path: &Path) -> String {
+    let out = Command::new("sha256sum").arg(path).output().unwrap();
+    assert!(out.status.success());
+    String::from_utf8(out.stdout)
+        .unwrap()
+        .split_whitespace()
+        .next()
+        .unwrap()
+        .to_owned()
+}
+fn write_evidence(dir: &Path, name: &str, data: &[u8]) -> Value {
+    let p = dir.join(name);
+    std::fs::write(&p, data).unwrap();
+    json!({"file":name,"bytes":data.len(),"sha256":hash(&p)})
+}
+
+/// Invoked only as a local child process by start_sender. The sender body is
+/// the original function; SIGKILL interrupts its ordinary blocking write_all.
+#[test]
+#[ignore]
+fn sender_child() {
+    let dir = PathBuf::from(std::env::var("SPECULA_FRAME_CHILD_DIR").unwrap());
+    let address = std::env::var("SPECULA_FRAME_CHILD_ADDR")
+        .unwrap()
+        .parse()
+        .unwrap();
+    let original = std::fs::read_to_string(dir.join("encoded-body.bin")).unwrap();
+    let frame = decode(&original).unwrap();
+    assert_eq!(encode(&frame), original);
+    let (tx, rx) = mpsc::channel();
+    let (events, _) = mpsc::channel();
+    tx.send((1, frame)).unwrap();
+    drop(tx);
+    std::fs::write(dir.join("sender-entered"), std::process::id().to_string()).unwrap();
+    run_sender(0, vec![address, address, address], rx, events);
+    std::fs::write(dir.join("sender-returned"), b"write_all completed").unwrap();
+}
+struct PartialProbe {
+    child: Child,
+    socket: TcpStream,
+    bytes: Vec<u8>,
+    original: Vec<u8>,
+    dir: PathBuf,
+    pid: u32,
+}
+struct Interrupted {
+    bytes: Vec<u8>,
+    original: Vec<u8>,
+    dir: PathBuf,
+    pid: u32,
+}
+fn start_sender(message: &Message<Operation>, dir: &Path, partial: bool) -> PartialProbe {
+    create_dir_all(dir).unwrap();
+    for marker in ["sender-entered", "sender-returned"] {
+        let _ = std::fs::remove_file(dir.join(marker));
+    }
+    let original = encode(&Frame::Message(message.clone())).into_bytes();
+    write_evidence(dir, "encoded-body.bin", &original);
+    let listener = TcpListener::bind("127.0.0.1:0").unwrap();
+    if partial {
+        socket_option(listener.as_raw_fd(), 8, &4096i32);
+    }
+    listener.set_nonblocking(true).unwrap();
+    let child = Command::new(std::env::current_exe().unwrap())
+        .args([
+            "--exact",
+            "specula_harness::frame_probe::sender_child",
+            "--ignored",
+            "--nocapture",
+        ])
+        .env("SPECULA_FRAME_CHILD_DIR", dir)
+        .env(
+            "SPECULA_FRAME_CHILD_ADDR",
+            listener.local_addr().unwrap().to_string(),
+        )
+        .stdout(Stdio::from(File::create(dir.join("sender.log")).unwrap()))
+        .stderr(Stdio::from(
+            File::create(dir.join("sender.stderr")).unwrap(),
+        ))
+        .spawn()
+        .unwrap();
+    let pid = child.id();
+    let start = std::time::Instant::now();
+    let socket = loop {
+        match listener.accept() {
+            Ok((s, _)) => break s,
+            Err(e) if e.kind() == ErrorKind::WouldBlock => {
+                assert!(
+                    start.elapsed() < Duration::from_secs(10),
+                    "local sender connect timed out"
+                );
+                std::thread::sleep(Duration::from_millis(5));
+            }
+            Err(e) => panic!("accept: {e}"),
+        }
+    };
+    socket
+        .set_read_timeout(Some(Duration::from_secs(10)))
+        .unwrap();
+    PartialProbe {
+        child,
+        socket,
+        bytes: vec![],
+        original,
+        dir: dir.to_owned(),
+        pid,
+    }
+}
+fn begin_partial(message: &Message<Operation>, dir: &Path) -> PartialProbe {
+    let mut p = start_sender(message, dir, true);
+    let mut buf = [0u8; 4096];
+    // TCP may split the header itself across reads. Wait only until the
+    // actual accumulated prefix contains the final value token.
+    loop {
+        let n = p.socket.read(&mut buf).unwrap();
+        assert!(n > 0);
+        p.bytes.extend_from_slice(&buf[..n]);
+        assert!(p.original.starts_with(&p.bytes));
+        assert!(p.bytes.len() < p.original.len());
+        assert!(!p.bytes.contains(&b'\n'));
+        if matches!(decode(std::str::from_utf8(&p.bytes).unwrap()),Ok(Frame::Message(Message::Prepare{op:Operation::Put(_,v),..})) if !v.is_empty())
+        {
+            break;
+        }
+        assert!(
+            p.bytes.len() < 16384,
+            "valid encoder header exceeded experiment bound"
+        );
+    }
+    assert!(p.child.try_wait().unwrap().is_none());
+    assert!(!dir.join("sender-returned").exists());
+    write_evidence(dir, "initial-received-prefix.bin", &p.bytes);
+    p
+}
+impl PartialProbe {
+    fn kill_and_drain(mut self) -> Interrupted {
+        assert!(self.child.try_wait().unwrap().is_none());
+        self.child.kill().unwrap();
+        let status = self.child.wait().unwrap();
+        assert!(!status.success());
+        // Every surviving byte is retained. EOF is measured by read_to_end,
+        // while read errors cause this experiment to fail rather than relabel.
+        self.socket
+            .read_to_end(&mut self.bytes)
+            .expect("sender crash must yield measured clean EOF for this witness");
+        assert!(self.original.starts_with(&self.bytes));
+        assert!(self.bytes.len() < self.original.len());
+        assert!(!self.bytes.contains(&b'\n'));
+        assert!(!self.dir.join("sender-returned").exists());
+        let raw = write_evidence(&self.dir, "received-prefix.bin", &self.bytes);
+        let metadata = json!({"revision":"3ac0104a567092139534c9022205d02281a2da41","parent_pid":std::process::id(),"sender_pid":self.pid,
+            "sender_status":status.to_string(),"sender_function":"examples/kvstore/main.rs:run_sender (unchanged)",
+            "source_eof":"read_to_end returned Ok after child SIGKILL","sender_returned":false,
+            "strict_prefix":true,"contains_newline":false,"received":raw,
+            "original":{"file":"encoded-body.bin","bytes":self.original.len(),"sha256":hash(&self.dir.join("encoded-body.bin"))},
+            "transport":"localhost byte-preserving store-and-forward proxy; all surviving sender bytes forwarded without shortening"});
+        std::fs::write(
+            self.dir.join("provenance.json"),
+            serde_json::to_vec_pretty(&metadata).unwrap(),
+        )
+        .unwrap();
+        Interrupted {
+            bytes: self.bytes,
+            original: self.original,
+            dir: self.dir,
+            pid: self.pid,
+        }
+    }
+}
+fn accept_bytes(
+    bytes: &[u8],
+    reset: bool,
+    fragmented: bool,
+    dir: &Path,
+) -> Option<Message<Operation>> {
+    let (ltx, lrx) = mpsc::channel();
+    *OBSERVER.get_or_init(Default::default).lock().unwrap() = Some(ltx);
+    let (tx, rx) = mpsc::channel();
+    let listener = TcpListener::bind("127.0.0.1:0").unwrap();
+    let addr = listener.local_addr().unwrap();
+    // The shipped acceptor owns a blocking infinite accept loop. Its thread is
+    // confined to this test executable and exits with it; per-connection worker
+    // completion is synchronized by the read observation and dispatch channel.
+    std::thread::spawn(move || run_peer_acceptor(listener, tx));
+    let mut socket = TcpStream::connect(addr).unwrap();
+    socket
+        .set_write_timeout(Some(Duration::from_secs(10)))
+        .unwrap();
+    if fragmented {
+        for chunk in bytes.chunks(7) {
+            socket.write_all(chunk).unwrap();
+        }
+    } else {
+        socket.write_all(bytes).unwrap();
+    }
+    let line = if reset {
+        // All supplied bytes are valid sender traffic; the injected fault is
+        // the connection's RST. Actual lines() error proves no dispatch.
+        #[repr(C)]
+        struct Linger {
+            on: i32,
+            seconds: i32,
+        }
+        socket_option(socket.as_raw_fd(), 13, &Linger { on: 1, seconds: 0 });
+        drop(socket);
+        lrx.recv_timeout(Duration::from_secs(10))
+            .expect("read-error observation")
+    } else {
+        socket.shutdown(Shutdown::Write).unwrap();
+        lrx.recv_timeout(Duration::from_secs(10))
+            .expect("line observation")
+    };
+    // End is emitted after map_while and every possible dispatch have
+    // completed. No-dispatch is now checked after a synchronization boundary.
+    assert!(matches!(
+        lrx.recv_timeout(Duration::from_secs(10))
+            .expect("receive loop completion"),
+        LineResult::End
+    ));
+    let result = if reset {
+        assert!(
+            matches!(line, LineResult::Error(ErrorKind::ConnectionReset)),
+            "actual line outcome {line:?}"
+        );
+        assert!(
+            matches!(rx.try_recv(), Err(mpsc::TryRecvError::Empty)),
+            "read error dispatched a message"
+        );
+        None
+    } else {
+        assert!(
+            matches!(line,LineResult::Ok(n) if n==bytes.len()-usize::from(bytes.last()==Some(&b'\n')))
+        );
+        match rx.recv_timeout(Duration::from_secs(10)).unwrap() {
+            Event::Message(m) => Some(m),
+            _ => panic!("unexpected event"),
+        }
+    };
+    *OBSERVER.get().unwrap().lock().unwrap() = None;
+    std::fs::write(dir.join("receiver.json"),serde_json::to_vec_pretty(&json!({"line_result":format!("{line:?}"),"receive_loop_completed":true,"dispatched":result.is_some(),"reset":reset,"fragmented":fragmented,"forwarded_bytes":bytes.len(),"forwarded_sha256":hash(&dir.join(if reset||!fragmented{"received-prefix.bin"}else{"received-complete.bin"}))})).unwrap()).unwrap();
+    result
+}
+impl Interrupted {
+    fn prefix_value(&self) -> String {
+        assert!(self.original.starts_with(&self.bytes));
+        assert!(self.pid > 0);
+        match decode(std::str::from_utf8(&self.bytes).unwrap()).unwrap() {
+            Frame::Message(Message::Prepare {
+                op: Operation::Put(_, v),
+                ..
+            }) => v,
+            _ => panic!("unsupported frame"),
+        }
+    }
+    fn finish_clean_eof(self) -> Message<Operation> {
+        accept_bytes(&self.bytes, false, false, &self.dir).unwrap()
+    }
+    fn finish_reset(self) {
+        assert!(accept_bytes(&self.bytes, true, false, &self.dir).is_none());
+    }
+}
+fn complete_fragmented(message: &Message<Operation>, dir: &Path) -> Message<Operation> {
+    let mut p = start_sender(message, dir, false);
+    p.socket.read_to_end(&mut p.bytes).unwrap();
+    assert!(p.child.wait().unwrap().success());
+    let mut expected = p.original.clone();
+    expected.push(b'\n');
+    assert_eq!(p.bytes, expected);
+    let evidence = write_evidence(dir, "received-complete.bin", &p.bytes);
+    std::fs::write(dir.join("provenance.json"),serde_json::to_vec_pretty(&json!({"revision":"3ac0104a567092139534c9022205d02281a2da41","sender_pid":p.pid,"parent_pid":std::process::id(),"sender_returned":true,"content_preserving":true,"received":evidence})).unwrap()).unwrap();
+    accept_bytes(&p.bytes, false, true, dir).unwrap()
+}
+fn frame_message(c: &Cluster, id: usize) -> Message<Operation> {
+    match &c.frames[id].sent.payload {
+        Payload::Message(m) => m.clone(),
+        _ => panic!("not protocol frame"),
+    }
+}
+
+#[test]
+fn specula_frame_complete() {
+    let mut c = Cluster::new("specula_frame_complete", 3, true);
+    c.request(100, Operation::Put("k".into(), "AA".into()));
+    c.deliver(0);
+    for id in 0..2 {
+        let actual = complete_fragmented(
+            &frame_message(&c, id),
+            &c.trace_dir.join(format!("frame-evidence/complete-{id}")),
+        );
+        c.frame_complete(id, actual);
+    }
+    c.pump(400);
+    c.idle(0);
+    c.pump(400);
+    c.request(101, Operation::Get("k".into()));
+    c.pump(400);
+    assert_eq!(c.responses.last().unwrap()["result"], "AA");
+    c.finish();
+}
+#[test]
+fn specula_frame_eof() {
+    let raw = full_value();
+    register_value(&raw, "AA");
+    let mut c = Cluster::new("specula_frame_eof", 3, true);
+    c.request(100, Operation::Put("k".into(), raw));
+    c.deliver(0);
+    let probe = begin_partial(
+        &frame_message(&c, 0),
+        &c.trace_dir.join("frame-evidence/eof"),
+    );
+    c.frame_partial(0);
+    let interrupted = probe.kill_and_drain();
+    c.crash(0);
+    let prefix = interrupted.prefix_value();
+    register_value(&prefix, "A");
+    let actual = interrupted.finish_clean_eof();
+    c.frame_eof(0, actual);
+    c.pump(400);
+    // Surviving replica 1 starts a view using the actual admitted log. Replica
+    // 2 learns that log via unchanged StartView; there is no transport mutation.
+    for _ in 0..4 {
+        c.idle(1);
+        c.pump(400);
+    }
+    assert_eq!(c.replica(1).status(), Status::Normal);
+    assert_eq!(c.replica(1).view_number(), 1);
+    c.idle(1);
+    c.pump(400);
+    c.client_idle(100);
+    c.pump(400);
+    assert!(c
+        .responses
+        .iter()
+        .any(|r| r["client"] == 100 && r["result"] == "nil"));
+    c.request(101, Operation::Get("k".into()));
+    c.client_idle(101);
+    c.pump(400);
+    assert_eq!(c.responses.last().unwrap()["result"], "A");
+    c.recover(0);
+    c.pump(400);
+    assert_eq!(c.replica(0).state_machine().map.get("k"), Some(&prefix));
+    c.finish();
+}
+#[test]
+fn specula_frame_reset() {
+    let raw = full_value();
+    register_value(&raw, "AA");
+    let mut c = Cluster::new("specula_frame_reset", 3, true);
+    c.request(100, Operation::Put("k".into(), raw));
+    c.deliver(0);
+    let probe = begin_partial(
+        &frame_message(&c, 0),
+        &c.trace_dir.join("frame-evidence/reset"),
+    );
+    c.frame_partial(0);
+    let interrupted = probe.kill_and_drain();
+    c.crash(0);
+    interrupted.finish_reset();
+    c.frame_error(0);
+    assert_eq!(c.replica(1).op_number(), 0);
+    assert!(c.network().is_empty());
+    c.finish();
+}
