@@ -0,0 +1,561 @@
+//! Coordinated owner of real Replica/Client and the shipped kvstore Store.
+//! Derived from tests/cluster.rs's message-driving test infrastructure.
+use super::{persist_view, Op as Operation, Store};
+use serde_json::{json, Value};
+use std::collections::{BTreeMap, VecDeque};
+use std::fs::{create_dir_all, File};
+use std::io::{BufWriter, Write};
+use std::path::PathBuf;
+use std::sync::Mutex;
+use std::time::{SystemTime, UNIX_EPOCH};
+use vsr_rs::specula_observe::{self as observe, TraceStateMachine, TraceValue};
+use vsr_rs::{Client, Config, LogEntry, Message, Replica, Reply, Status};
+
+// Literal core values are preserved. The frame experiment registers exactly
+// two proven byte strings (long original and actual received prefix).
+fn value(v: &str) -> Value {
+    observe::normalize_value(v)
+}
+fn register_value(raw: &str, normalized: &str) {
+    observe::register_value(raw, normalized);
+}
+impl TraceValue for Operation {
+    fn trace_value(&self) -> Value {
+        match self {
+            Operation::Put(k, v) => {
+                assert_eq!(k, "k");
+                json!({"kind":"Put","value":value(v)})
+            }
+            Operation::Get(k) => {
+                assert_eq!(k, "k");
+                json!({"kind":"Get","value":"nil"})
+            }
+        }
+    }
+}
+impl TraceStateMachine for Store {
+    fn trace_app(&self) -> Value {
+        assert!(self.map.keys().all(|k| k == "k"));
+        self.map.get("k").cloned().trace_value()
+    }
+}
+
+#[derive(Clone)]
+enum Payload {
+    Message(Message<Operation>),
+    Reply(Reply<Option<String>>),
+}
+#[derive(Clone)]
+struct Envelope {
+    src: usize,
+    dst: usize,
+    payload: Payload,
+}
+impl Envelope {
+    fn normalized(&self) -> Value {
+        match &self.payload {
+            Payload::Message(m) => observe::normalize_message(self.src, self.dst, m),
+            Payload::Reply(r) => observe::normalize_reply(self.src, r),
+        }
+    }
+}
+struct Node {
+    replica: Option<Replica<Store>>,
+    durable: usize,
+    owner: &'static str,
+    incarnation: u64,
+    messages: VecDeque<Envelope>,
+    replies: VecDeque<Envelope>,
+    path: PathBuf,
+}
+struct FrameState {
+    sent: Envelope,
+    stage: &'static str,
+    admitted: Envelope,
+}
+struct Cluster {
+    config: Config,
+    nodes: Vec<Node>,
+    clients: BTreeMap<usize, Client<Operation>>,
+    retained: BTreeMap<usize, Value>,
+    queue: VecDeque<Envelope>,
+    frames: Vec<FrameState>,
+    integration: bool,
+    phase: &'static str,
+    healthy: Vec<usize>,
+    invocations: Vec<Value>,
+    responses: Vec<Value>,
+    happens_before: Vec<Value>,
+    history: Vec<Value>,
+    writer: Mutex<Option<BufWriter<File>>>,
+    trace_dir: PathBuf,
+}
+fn insert_set(xs: &mut Vec<Value>, x: Value) {
+    if !xs.contains(&x) {
+        xs.push(x);
+    }
+}
+impl Cluster {
+    fn new(name: &str, n: usize, integration: bool) -> Self {
+        let trace_dir =
+            PathBuf::from(std::env::var("SPECULA_TRACE_DIR").expect("SPECULA_TRACE_DIR"));
+        create_dir_all(&trace_dir).unwrap();
+        let run_dir = trace_dir.join(format!(".{name}-views"));
+        create_dir_all(&run_dir).unwrap();
+        let mut config = Config::new();
+        for _ in 0..n {
+            config.add_replica();
+        }
+        config.set_primary_timeout(3);
+        let nodes = (0..n)
+            .map(|i| {
+                let path = run_dir.join(format!("replica-{i}.view"));
+                persist_view(path.to_str().unwrap(), &mut None, 0);
+                Node {
+                    replica: Some(Replica::new(i, config.clone(), Store::default())),
+                    durable: 0,
+                    owner: "ready",
+                    incarnation: 0,
+                    messages: VecDeque::new(),
+                    replies: VecDeque::new(),
+                    path,
+                }
+            })
+            .collect();
+        let mut c = Self {
+            config: config.clone(),
+            nodes,
+            clients: [100, 101]
+                .into_iter()
+                .map(|id| (id, Client::new(id, config.clone())))
+                .collect(),
+            retained: [100, 101]
+                .into_iter()
+                .map(|id| (id, observe::neutral_entry()))
+                .collect(),
+            queue: VecDeque::new(),
+            frames: vec![],
+            integration,
+            phase: "faults",
+            healthy: (0..n).collect(),
+            invocations: vec![],
+            responses: vec![],
+            happens_before: vec![],
+            history: vec![],
+            writer: Mutex::new(Some(BufWriter::new(
+                File::create(trace_dir.join(format!("{name}.ndjson"))).unwrap(),
+            ))),
+            trace_dir,
+        };
+        c.emit(
+            "Init",
+            json!({"config":{"revision":"3ac0104a567092139534c9022205d02281a2da41",
+            "servers":(0..n).collect::<Vec<_>>(),"clients":[100,101],"values":["A","AA","B"],
+            "primary_timeout":3,"failure_budget":(n-1)/2,"integration_mode":integration,
+            "full_value":"AA","prefix_value":"A"}}),
+        );
+        c
+    }
+    fn replica(&self, i: usize) -> &Replica<Store> {
+        self.nodes[i].replica.as_ref().expect("node is down")
+    }
+    fn state(&self, i: usize) -> Value {
+        let node = &self.nodes[i];
+        let mut s = if let Some(r) = &node.replica {
+            observe::replica_snapshot(r)
+        } else {
+            let mut s =
+                observe::replica_snapshot(&Replica::new(i, self.config.clone(), Store::default()));
+            s["status"] = json!("Down");
+            s
+        };
+        // Drained outputs remain owned here until one PublishOutput at a time.
+        let mut msgs: Vec<_> = node.messages.iter().map(Envelope::normalized).collect();
+        msgs.extend(s["messages"].as_array().unwrap().iter().cloned());
+        let mut reps: Vec<_> = node.replies.iter().map(Envelope::normalized).collect();
+        reps.extend(s["replies"].as_array().unwrap().iter().cloned());
+        s["messages"] = json!(msgs);
+        s["replies"] = json!(reps);
+        s
+    }
+    fn network(&self) -> Vec<Value> {
+        self.queue.iter().map(Envelope::normalized).collect()
+    }
+    fn snapshot(&self) -> Value {
+        let mut net = vec![];
+        for m in self.network() {
+            insert_set(&mut net, m);
+        }
+        json!({"replicas":self.nodes.iter().enumerate().map(|(id,n)| json!({"id":id,"durable":n.durable,
+            "owner":n.owner,"incarnation":n.incarnation,"state":self.state(id)})).collect::<Vec<_>>(),
+            "clients":self.clients.iter().map(|(id,c)| {let mut s=observe::client_snapshot(c,&self.retained[id]);s["id"]=json!(id);s}).collect::<Vec<_>>(),
+            "network":net,"frames":self.frames.iter().enumerate().map(|(id,f)|json!({"id":id,"sent":f.sent.normalized(),"stage":f.stage,"admitted":f.admitted.normalized()})).collect::<Vec<_>>(),
+            "nextFrame":self.frames.len(),"phase":self.phase,"healthySet":self.healthy,
+            "invocations":self.invocations,"responses":self.responses,"happensBefore":self.happens_before,"committedHistory":self.history})
+    }
+    fn emit(&mut self, name: &str, mut fields: Value) {
+        for i in 0..self.nodes.len() {
+            for e in self.state(i)["executed"].as_array().unwrap() {
+                insert_set(&mut self.history, e.clone());
+            }
+        }
+        fields["tag"] = json!("trace");
+        fields["event"] = json!(name);
+        fields["ts"] = json!(SystemTime::now()
+            .duration_since(UNIX_EPOCH)
+            .unwrap()
+            .as_nanos()
+            .to_string());
+        fields["post"] = self.snapshot();
+        let mut guard = self.writer.lock().unwrap();
+        let out = guard.as_mut().unwrap();
+        serde_json::to_writer(&mut *out, &fields).unwrap();
+        writeln!(out).unwrap();
+        out.flush().unwrap();
+    }
+    fn finish(&mut self) {
+        if let Some(mut out) = self.writer.lock().unwrap().take() {
+            out.flush().unwrap();
+        }
+    }
+    fn drain_owner(&mut self, i: usize) {
+        let node = &mut self.nodes[i];
+        let r = node.replica.as_mut().unwrap();
+        node.messages
+            .extend(r.drain_messages().map(|(dst, m)| Envelope {
+                src: i,
+                dst,
+                payload: Payload::Message(m),
+            }));
+        node.replies.extend(r.drain_replies().map(|r| Envelope {
+            src: i,
+            dst: r.client_id,
+            payload: Payload::Reply(r),
+        }));
+    }
+    fn persist(&mut self, i: usize) {
+        assert_eq!(self.nodes[i].owner, "persist");
+        let view = self.replica(i).view_number();
+        let node = &mut self.nodes[i];
+        let mut previous = Some(node.durable);
+        persist_view(node.path.to_str().unwrap(), &mut previous, view);
+        assert_eq!(
+            std::fs::read_to_string(&node.path)
+                .unwrap()
+                .trim()
+                .parse::<usize>()
+                .unwrap(),
+            view
+        );
+        node.durable = view;
+        self.drain_owner(i);
+        let node = &mut self.nodes[i];
+        node.owner = if node.messages.is_empty() && node.replies.is_empty() {
+            "ready"
+        } else {
+            "publish"
+        };
+        self.emit("PersistView", json!({"node":i}));
+    }
+    fn publish(&mut self, i: usize) {
+        let n = &mut self.nodes[i];
+        assert_eq!(n.owner, "publish");
+        assert_eq!(n.durable, n.replica.as_ref().unwrap().view_number());
+        let m = n
+            .messages
+            .pop_front()
+            .or_else(|| n.replies.pop_front())
+            .unwrap();
+        n.owner = if n.messages.is_empty() && n.replies.is_empty() {
+            "ready"
+        } else {
+            "publish"
+        };
+        if self.integration
+            && matches!(
+                &m.payload,
+                Payload::Message(Message::Prepare {
+                    op: Operation::Put(..),
+                    ..
+                })
+            )
+        {
+            self.frames.push(FrameState {
+                sent: m.clone(),
+                admitted: m,
+                stage: "queued",
+            });
+        } else {
+            self.queue.push_back(m);
+        }
+        self.emit("PublishOutput", json!({"node":i}));
+    }
+    fn flush(&mut self, i: usize) {
+        if self.nodes[i].owner == "persist" {
+            self.persist(i);
+        }
+        while self.nodes[i].owner == "publish" {
+            self.publish(i);
+        }
+    }
+    fn request(&mut self, id: usize, op: Operation) {
+        assert!(
+            !observe::client_snapshot(&self.clients[&id], &self.retained[&id])["pending"]
+                .as_bool()
+                .unwrap()
+        );
+        let normalized = op.trace_value();
+        let c = self.clients.get_mut(&id).unwrap();
+        let request = c.on_request(op.clone());
+        let e = observe::entry(&LogEntry {
+            client_id: id,
+            request_number: request,
+            op,
+        });
+        self.retained.insert(id, e.clone());
+        self.invocations.push(e);
+        for r in &self.responses {
+            self.happens_before
+                .push(json!([[r["client"], r["request"]], [id, request]]));
+        }
+        self.queue.extend(c.drain().map(|(dst, m)| Envelope {
+            src: id,
+            dst,
+            payload: Payload::Message(m),
+        }));
+        self.emit("ClientOnRequest", json!({"client":id,"op":normalized}));
+    }
+    fn client_idle(&mut self, id: usize) {
+        if !observe::client_snapshot(&self.clients[&id], &self.retained[&id])["pending"]
+            .as_bool()
+            .unwrap()
+        {
+            return;
+        }
+        let c = self.clients.get_mut(&id).unwrap();
+        c.on_idle();
+        self.queue.extend(c.drain().map(|(dst, m)| Envelope {
+            src: id,
+            dst,
+            payload: Payload::Message(m),
+        }));
+        self.emit("ClientOnIdle", json!({"client":id}));
+    }
+    fn idle_raw(&mut self, i: usize) {
+        assert_eq!(self.nodes[i].owner, "ready");
+        self.nodes[i].replica.as_mut().unwrap().on_idle();
+        self.nodes[i].owner = "persist";
+        self.emit("OnIdle", json!({"node":i}));
+    }
+    fn idle(&mut self, i: usize) {
+        self.idle_raw(i);
+        self.flush(i);
+    }
+    fn receive(&mut self, index: usize) {
+        let m = self.queue.remove(index).unwrap();
+        let normalized = m.normalized();
+        let keep = self.queue.iter().any(|x| x.normalized() == normalized);
+        if let Payload::Reply(r) = m.payload {
+            let accepted = self
+                .clients
+                .get_mut(&m.dst)
+                .unwrap()
+                .on_reply(r.request_number, r.view_number);
+            if accepted {
+                self.responses.push(json!({"client":r.client_id,"request":r.request_number,"result":r.result.trace_value()}));
+            }
+            self.emit("ClientOnReply", json!({"message":normalized,"keep":keep}));
+            return;
+        }
+        if self.nodes[m.dst].owner == "down" {
+            if !keep {
+                self.emit("DiscardUnavailable", json!({"message":normalized}));
+            }
+            return;
+        }
+        assert_eq!(self.nodes[m.dst].owner, "ready");
+        let s = self.state(m.dst);
+        let event = if s["status"] == "Recovering" && normalized["kind"] != "RecoveryResponse" {
+            "RecoveringDrop".to_owned()
+        } else {
+            match normalized["kind"].as_str().unwrap() {
+                "Prepare" => if s["status"] != "Normal"
+                    || s["view"] != normalized["view"]
+                    || self.replica(m.dst).is_primary()
+                {
+                    "OnPrepareRejected"
+                } else {
+                    let len = s["log"].as_array().unwrap().len() as u64;
+                    let op = normalized["opnum"].as_u64().unwrap();
+                    if op > len + 1 {
+                        "OnPrepareGap"
+                    } else if op == len + 1 {
+                        "OnPrepareAppend"
+                    } else {
+                        "OnPrepareDuplicate"
+                    }
+                }
+                .to_owned(),
+                "NewState" => if s["status"] == "StateTransfer" {
+                    "OnNewStateTransfer"
+                } else if s["status"] == "ViewChange" && s["catching"] == true {
+                    "OnNewStateCatchUp"
+                } else {
+                    "OnNewStateIgnored"
+                }
+                .to_owned(),
+                kind => format!("On{kind}"),
+            }
+        };
+        if let Payload::Message(msg) = m.payload {
+            self.nodes[m.dst].replica.as_mut().unwrap().on_message(msg);
+        }
+        self.nodes[m.dst].owner = "persist";
+        self.emit(
+            &event,
+            json!({"node":m.dst,"message":normalized,"keep":keep}),
+        );
+    }
+    fn deliver(&mut self, index: usize) {
+        let dst = self.queue[index].dst;
+        self.receive(index);
+        if dst < self.nodes.len() {
+            self.flush(dst);
+        }
+    }
+    fn deliver_where(&mut self, p: impl Fn(&Value) -> bool) -> bool {
+        if let Some(i) = self.queue.iter().position(|m| p(&m.normalized())) {
+            self.deliver(i);
+            true
+        } else {
+            false
+        }
+    }
+    fn pump(&mut self, limit: usize) {
+        for _ in 0..limit {
+            if self.queue.is_empty() {
+                return;
+            }
+            self.deliver(0);
+        }
+        assert!(self.queue.is_empty(), "pump bound exceeded");
+    }
+    fn lose(&mut self, index: usize) {
+        assert_eq!(self.phase, "faults");
+        let m = self.queue.remove(index).unwrap().normalized();
+        if !self.queue.iter().any(|x| x.normalized() == m) {
+            self.emit("LoseMessage", json!({"message":m}));
+        }
+    }
+    fn lose_where(&mut self, p: impl Fn(&Value) -> bool) -> bool {
+        if let Some(i) = self.queue.iter().position(|m| p(&m.normalized())) {
+            self.lose(i);
+            true
+        } else {
+            false
+        }
+    }
+    fn crash(&mut self, i: usize) {
+        assert_eq!(self.phase, "faults");
+        assert_ne!(self.nodes[i].owner, "down");
+        let unavailable = self
+            .nodes
+            .iter()
+            .filter(|n| n.replica.as_ref().map_or(true, Replica::is_recovering))
+            .count();
+        assert!(self.replica(i).is_recovering() || unavailable < (self.nodes.len() - 1) / 2);
+        let n = &mut self.nodes[i];
+        n.replica = None;
+        n.messages.clear();
+        n.replies.clear();
+        n.owner = "down";
+        for f in &mut self.frames {
+            if f.sent.src == i {
+                f.stage = match f.stage {
+                    "queued" => "lost",
+                    "partial" => "eof",
+                    s => s,
+                };
+            }
+        }
+        self.emit("Crash", json!({"node":i}));
+    }
+    fn recover_raw(&mut self, i: usize) {
+        let n = &mut self.nodes[i];
+        assert_eq!(n.owner, "down");
+        n.incarnation += 1;
+        let durable = std::fs::read_to_string(&n.path)
+            .unwrap()
+            .trim()
+            .parse::<usize>()
+            .unwrap();
+        assert_eq!(durable, n.durable);
+        n.replica = Some(Replica::recover(
+            i,
+            self.config.clone(),
+            Store::default(),
+            durable,
+            n.incarnation,
+        ));
+        n.owner = "persist";
+        self.emit("Recover", json!({"node":i}));
+    }
+    fn recover(&mut self, i: usize) {
+        self.recover_raw(i);
+        self.flush(i);
+    }
+    fn stabilize(&mut self, healthy: Vec<usize>) {
+        assert_eq!(self.phase, "faults");
+        assert!(healthy.len() >= self.config.quorum());
+        for i in 0..self.nodes.len() {
+            if !healthy.contains(&i) {
+                assert_eq!(self.nodes[i].owner, "down");
+            }
+        }
+        self.healthy = healthy.clone();
+        self.phase = "stable";
+        self.emit("Stabilize", json!({"healthy":healthy}));
+    }
+    // Called only after matching observations from the real socket experiment.
+    fn frame_partial(&mut self, id: usize) {
+        assert_eq!(self.frames[id].stage, "queued");
+        self.frames[id].stage = "partial";
+        self.emit("RunSenderBeginPartial", json!({"frame":id}));
+    }
+    fn frame_complete(&mut self, id: usize, actual: Message<Operation>) {
+        let f = &mut self.frames[id];
+        assert!(["queued", "partial"].contains(&f.stage));
+        let m = Envelope {
+            src: f.sent.src,
+            dst: f.sent.dst,
+            payload: Payload::Message(actual),
+        };
+        assert_eq!(m.normalized(), f.sent.normalized());
+        f.stage = "complete";
+        self.queue.push_back(m);
+        self.emit("RunSenderComplete", json!({"frame":id}));
+    }
+    fn frame_eof(&mut self, id: usize, actual: Message<Operation>) {
+        let f = &mut self.frames[id];
+        assert_eq!(f.stage, "eof");
+        let m = Envelope {
+            src: f.sent.src,
+            dst: f.sent.dst,
+            payload: Payload::Message(actual),
+        };
+        f.admitted = m.clone();
+        f.stage = "admitted";
+        self.queue.push_back(m);
+        self.emit("RunPeerAcceptorEOF", json!({"frame":id}));
+    }
+    fn frame_error(&mut self, id: usize) {
+        assert!(["partial", "eof"].contains(&self.frames[id].stage));
+        self.frames[id].stage = "lost";
+        self.emit("RunPeerAcceptorReadError", json!({"frame":id}));
+    }
+}
