+//! Deterministic extensions of tests/cluster.rs's real Replica/Client owner.
+//! These functions schedule calls and queued messages; all protocol decisions
+//! and key-value operations execute in the shipped library and kvstore Store.
+
+use super::*;
+use serde_json::Value;
+use vsr_rs::Status;
+
+fn put(value: &str) -> Operation {
+    Operation::Put("k".into(), value.into())
+}
+
+fn get() -> Operation {
+    Operation::Get("k".into())
+}
+
+fn deliver_matching(c: &mut Cluster, predicate: impl Fn(&Value) -> bool) {
+    assert!(
+        c.deliver_where(predicate),
+        "expected queued message; queue={:?}",
+        c.network()
+    );
+}
+
+fn drain_matching(c: &mut Cluster, predicate: impl Fn(&Value) -> bool) {
+    for _ in 0..400 {
+        if !c.deliver_where(|m| predicate(m)) {
+            return;
+        }
+    }
+    panic!("bounded selective drain exhausted; queue={:?}", c.network());
+}
+
+fn completed(c: &Cluster, client: usize, request: usize, result: &str) {
+    let state = c.snapshot();
+    assert!(
+        state["responses"]
+            .as_array()
+            .unwrap()
+            .iter()
+            .any(|r| { r["client"] == client && r["request"] == request && r["result"] == result }),
+        "missing completion ({client}, {request}, {result}); responses={}",
+        state["responses"]
+    );
+}
+
+fn pending(c: &Cluster, client: usize) -> bool {
+    c.snapshot()["clients"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .find(|row| row["id"] == client)
+        .unwrap()["pending"]
+        .as_bool()
+        .unwrap()
+}
+
+fn normal_at_same_view(c: &Cluster, nodes: &[usize]) -> bool {
+    let view = c.replica(nodes[0]).view_number();
+    nodes.iter().all(|&node| {
+        c.replica(node).status() == Status::Normal && c.replica(node).view_number() == view
+    })
+}
+
+fn retry_and_pump(c: &mut Cluster, client: usize) {
+    if pending(c, client) {
+        c.client_idle(client);
+    }
+    c.pump(400);
+}
+
+/// Reorders real Prepare messages as test_prepare_reordered_during_state_transfer
+/// does, while respecting the documented single outstanding request per client.
+/// Real primary retransmission and StateTransfer idle retry create duplicates;
+/// no message payload or trace event is manufactured by the scenario.
+#[test]
+fn specula_normal_transfer() {
+    let mut c = Cluster::new("specula_normal_transfer", 3, false);
+    c.request(100, put("AA"));
+    deliver_matching(&mut c, |m| m["kind"] == "Request" && m["dst"] == 0);
+    c.idle(0); // Commit before retransmitted Prepare, exactly as on_idle emits.
+    deliver_matching(&mut c, |m| m["kind"] == "Prepare" && m["dst"] == 1);
+    deliver_matching(&mut c, |m| m["kind"] == "Prepare" && m["dst"] == 1);
+    deliver_matching(&mut c, |m| m["kind"] == "PrepareOk" && m["src"] == 1);
+    assert!(c.lose_where(|m| m["kind"] == "Reply" && m["dst"] == 100));
+    c.client_idle(100); // Cached reply repairs actual client-visible reply loss.
+    drain_matching(&mut c, |m| m["dst"] != 2);
+    completed(&c, 100, 0, "nil");
+
+    c.request(101, get()); // Invoked after the other client's accepted reply.
+    deliver_matching(&mut c, |m| m["kind"] == "Request" && m["dst"] == 0);
+    deliver_matching(&mut c, |m| {
+        m["kind"] == "Prepare" && m["dst"] == 2 && m["opnum"] == 2
+    });
+    assert_eq!(c.replica(2).status(), Status::StateTransfer);
+    // Earlier op arrives only after the gap started state transfer: rejected.
+    deliver_matching(&mut c, |m| {
+        m["kind"] == "Prepare" && m["dst"] == 2 && m["opnum"] == 1
+    });
+    c.idle(2); // A second authentic GetState produces a delayed equal NewState.
+    deliver_matching(&mut c, |m| m["kind"] == "GetState" && m["src"] == 2);
+    deliver_matching(&mut c, |m| m["kind"] == "GetState" && m["src"] == 2);
+    deliver_matching(&mut c, |m| m["kind"] == "NewState" && m["dst"] == 2);
+    assert_eq!(c.replica(2).status(), Status::Normal);
+    deliver_matching(&mut c, |m| m["kind"] == "NewState" && m["dst"] == 2);
+    c.pump(400);
+    c.idle(0);
+    c.pump(400);
+    completed(&c, 101, 0, "AA");
+    for node in 0..3 {
+        assert_eq!(c.replica(node).commit_number(), 2);
+        assert_eq!(
+            c.replica(node)
+                .state_machine()
+                .map
+                .get("k")
+                .map(String::as_str),
+            Some("AA")
+        );
+    }
+
+    // Keep replica 2 outside a completed view change, then let a new-view
+    // Prepare overtake StartView. The real rejected-Prepare path asks for the
+    // suffix after its committed prefix and installs it through CatchUp.
+    for _ in 0..5 {
+        if c.replica(1).status() == Status::ViewChange {
+            break;
+        }
+        c.idle(1);
+    }
+    drain_matching(&mut c, |m| m["dst"] != 2);
+    assert_eq!(c.replica(1).view_number(), 1);
+    assert_eq!(c.replica(1).status(), Status::Normal);
+    assert_eq!(c.replica(2).view_number(), 0);
+    c.request(100, put("B"));
+    c.client_idle(100);
+    deliver_matching(&mut c, |m| m["kind"] == "Request" && m["dst"] == 1);
+    deliver_matching(&mut c, |m| {
+        m["kind"] == "Prepare" && m["dst"] == 2 && m["view"] == 1
+    });
+    assert_eq!(c.replica(2).status(), Status::ViewChange);
+    deliver_matching(&mut c, |m| m["kind"] == "GetState" && m["src"] == 2);
+    deliver_matching(&mut c, |m| m["kind"] == "NewState" && m["dst"] == 2);
+    assert_eq!(c.replica(2).status(), Status::Normal);
+    c.pump(400);
+    completed(&c, 100, 1, "nil");
+    c.request(101, get());
+    retry_and_pump(&mut c, 101);
+    completed(&c, 101, 1, "B");
+    c.idle(1);
+    c.pump(400);
+    for node in 0..3 {
+        assert_eq!(c.replica(node).commit_number(), 4);
+    }
+    c.finish();
+}
+
+/// Extends test_recovery_after_reboot with delayed immutable response snapshots,
+/// recovery concurrent with a view change, and sequential reboots of all nodes.
+#[test]
+fn specula_rolling_recovery() {
+    let mut c = Cluster::new("specula_rolling_recovery", 3, false);
+    c.request(100, put("AA"));
+    c.pump(400);
+    c.idle(0);
+    c.pump(400);
+    completed(&c, 100, 0, "nil");
+
+    c.crash(2);
+    c.recover(2);
+    // Keep the view-0 response snapshots in transport across the view change.
+    deliver_matching(&mut c, |m| m["kind"] == "Recovery" && m["dst"] == 0);
+    deliver_matching(&mut c, |m| m["kind"] == "Recovery" && m["dst"] == 1);
+    c.request(101, get());
+    deliver_matching(&mut c, |m| m["kind"] == "Request" && m["dst"] == 0);
+    deliver_matching(&mut c, |m| m["kind"] == "Prepare" && m["dst"] == 2);
+    assert!(c.replica(2).is_recovering());
+    drain_matching(&mut c, |m| m["dst"] != 2 && m["kind"] != "Reply");
+    assert_eq!(c.replica(0).commit_number(), 2);
+
+    // Replica 1 suspects primary 0 while replica 2 is still recovering.
+    for _ in 0..5 {
+        if c.replica(1).status() == Status::ViewChange {
+            break;
+        }
+        c.idle(1);
+    }
+    assert_eq!(c.replica(1).view_number(), 1);
+    drain_matching(&mut c, |m| m["dst"] != 2 && m["kind"] != "Reply");
+    assert_eq!(c.replica(1).status(), Status::Normal);
+    assert_eq!(c.replica(1).view_number(), 1);
+
+    c.idle(2);
+    deliver_matching(&mut c, |m| m["kind"] == "Recovery" && m["dst"] == 0);
+    deliver_matching(&mut c, |m| m["kind"] == "Recovery" && m["dst"] == 1);
+    // Newer response is overwritten by an older authentic response from the
+    // same sender. There is still only one distinct responder at this point.
+    deliver_matching(&mut c, |m| {
+        m["kind"] == "RecoveryResponse" && m["src"] == 0 && m["view"] == 1
+    });
+    deliver_matching(&mut c, |m| {
+        m["kind"] == "RecoveryResponse" && m["src"] == 0 && m["view"] == 0
+    });
+    assert!(c.replica(2).is_recovering());
+    deliver_matching(&mut c, |m| {
+        m["kind"] == "RecoveryResponse" && m["src"] == 1 && m["view"] == 1
+    });
+    assert_eq!(c.replica(2).status(), Status::Normal);
+    assert_eq!(c.replica(2).view_number(), 1);
+    c.pump(400);
+    completed(&c, 101, 0, "AA");
+    c.idle(1);
+    c.pump(400);
+
+    // Start view 2 on replica 0, persist it, then release just the first SVC.
+    // Crash loses its unpublished second SVC but preserves the first envelope.
+    for _ in 0..5 {
+        c.idle_raw(0);
+        if c.replica(0).status() == Status::ViewChange {
+            break;
+        }
+        c.flush(0);
+    }
+    assert_eq!(c.replica(0).view_number(), 2);
+    c.persist(0);
+    c.publish(0);
+    c.crash(0);
+    c.recover(0);
+    c.pump(400);
+    for _ in 0..8 {
+        if normal_at_same_view(&c, &[0, 1, 2]) {
+            break;
+        }
+        for node in 0..3 {
+            c.idle(node);
+            c.pump(400);
+        }
+    }
+    assert!(normal_at_same_view(&c, &[0, 1, 2]));
+    assert!(c.replica(0).view_number() >= 2);
+
+    c.request(100, put("B"));
+    retry_and_pump(&mut c, 100);
+    completed(&c, 100, 1, "nil");
+    let primary = c.replica(0).view_number() % 3;
+    c.idle(primary);
+    c.pump(400);
+    c.crash(1);
+    c.recover(1);
+    c.pump(400);
+    assert!(normal_at_same_view(&c, &[0, 1, 2]));
+    c.request(101, get());
+    retry_and_pump(&mut c, 101);
+    completed(&c, 101, 1, "B");
+    c.idle(primary);
+    c.pump(400);
+    for node in 0..3 {
+        assert_eq!(c.replica(node).commit_number(), 4);
+        assert_eq!(
+            c.replica(node)
+                .state_machine()
+                .map
+                .get("k")
+                .map(String::as_str),
+            Some("B")
+        );
+    }
+    c.finish();
+}
+
+/// The round-robin primary of view 1 is permanently down. After Stabilize every
+/// healthy node gets one idle per round and each call's output is fully drained.
+/// This is finite progress coverage, not a proof of eventual service.
+#[test]
+fn specula_stable_minority() {
+    let mut c = Cluster::new("specula_stable_minority", 3, false);
+    c.request(100, put("AA"));
+    c.pump(400);
+    c.idle(0);
+    c.pump(400);
+    c.crash(1);
+    for _ in 0..5 {
+        if c.replica(2).status() == Status::ViewChange {
+            break;
+        }
+        c.idle(2);
+    }
+    c.pump(400);
+    for node in [0, 2] {
+        assert_eq!(c.replica(node).view_number(), 1);
+        assert_eq!(c.replica(node).status(), Status::ViewChange);
+    }
+    c.stabilize(vec![0, 2]);
+    c.request(101, get());
+    c.pump(400);
+    for _ in 0..12 {
+        for node in [0, 2] {
+            c.idle(node);
+            c.pump(400);
+        }
+        retry_and_pump(&mut c, 101);
+        if normal_at_same_view(&c, &[0, 2]) && !pending(&c, 101) {
+            break;
+        }
+    }
+    assert!(normal_at_same_view(&c, &[0, 2]));
+    assert!(c.replica(2).view_number() >= 2);
+    completed(&c, 101, 0, "AA");
+    c.request(100, put("B"));
+    retry_and_pump(&mut c, 100);
+    completed(&c, 100, 1, "nil");
+    c.request(101, get());
+    retry_and_pump(&mut c, 101);
+    completed(&c, 101, 1, "B");
+    // Additional stable rounds establish repeated service after the skipped view.
+    for _ in 0..3 {
+        for node in [0, 2] {
+            c.idle(node);
+            c.pump(400);
+        }
+    }
+    for node in [0, 2] {
+        assert_eq!(c.replica(node).commit_number(), 4);
+    }
+    c.finish();
+}
+
+/// N=2 traces declare failure_budget=0. Both members remain available; the
+/// request must await both acknowledgments and a view change uses both states.
+#[test]
+fn specula_two_replica() {
+    let mut c = Cluster::new("specula_two_replica", 2, false);
+    c.request(100, put("AA"));
+    deliver_matching(&mut c, |m| m["kind"] == "Request");
+    assert_eq!(c.replica(0).commit_number(), 0);
+    c.idle(0);
+    deliver_matching(&mut c, |m| m["kind"] == "Prepare");
+    deliver_matching(&mut c, |m| m["kind"] == "Prepare");
+    assert_eq!(c.replica(0).commit_number(), 0);
+    c.pump(400);
+    completed(&c, 100, 0, "nil");
+    c.idle(0);
+    c.pump(400);
+    c.request(101, get());
+    c.pump(400);
+    completed(&c, 101, 0, "AA");
+    for _ in 0..5 {
+        if c.replica(1).status() == Status::ViewChange {
+            break;
+        }
+        c.idle(1);
+    }
+    c.pump(400);
+    assert!(normal_at_same_view(&c, &[0, 1]));
+    assert_eq!(c.replica(1).view_number(), 1);
+    c.request(100, put("B"));
+    retry_and_pump(&mut c, 100);
+    completed(&c, 100, 1, "nil");
+    c.request(101, get());
+    retry_and_pump(&mut c, 101);
+    completed(&c, 101, 1, "B");
+    c.idle(1);
+    c.pump(400);
+    assert_eq!(c.replica(0).commit_number(), 4);
+    assert_eq!(c.replica(1).commit_number(), 4);
+    c.finish();
+}
