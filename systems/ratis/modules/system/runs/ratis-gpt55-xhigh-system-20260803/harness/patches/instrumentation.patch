+  private static long noteTraceableEntry(String raw, long rawIndex) {
+    if (!enabled || raw == null || rawIndex <= RaftLog.INVALID_LOG_INDEX) {
+      return 0L;
+    }
+    synchronized (LOCK) {
+      final Map<Long, Long> entries = RAW_TO_LOGICAL_INDEX.computeIfAbsent(raw, key -> new LinkedHashMap<>());
+      final Long existing = entries.get(rawIndex);
+      if (existing != null) {
+        return existing;
+      }
+      final long logical = LOGICAL_END.getOrDefault(raw, 0L) + 1;
+      entries.put(rawIndex, logical);
+      LOGICAL_END.put(raw, logical);
+      return logical;
+    }
+  }
