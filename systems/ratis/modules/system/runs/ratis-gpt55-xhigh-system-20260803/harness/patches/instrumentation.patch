+    final String raw = raw(id);
+    if (!enabled || raw == null) {
+      return false;
+    }
+    synchronized (LOCK) {
+      return PENDING_REQUESTS.remove(raw);
+    }
+  }
+
+  private static boolean recordReset(RaftPeerId id) {
+    final String raw = raw(id);
+    if (!enabled || raw == null) {
+      return false;
+    }
+    synchronized (LOCK) {
+      final long count = RESET_COUNT.getOrDefault(raw, 0L);
+      if (count >= 4L) {
+        return false;
+      }
+      RESET_COUNT.put(raw, count + 1L);
+      return true;
+    }
+  }
