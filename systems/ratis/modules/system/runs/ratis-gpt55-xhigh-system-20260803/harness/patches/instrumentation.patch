+  private static Map<String, Object> logState(RaftServer.Division server) {
+    final Map<String, Object> state = coreState(server);
+    final RaftServerImpl impl = asImpl(server);
+    if (impl == null) {
+      return state;
+    }
+    final String raw = raw(server);
+    try {
+      final RaftLog log = impl.getState().getLog();
+      state.put("logStart", logicalLogStart(raw, log.getStartIndex()));
+      state.put("logEnd", logicalEnd(raw));
+      state.put("flushIndex", logicalAtOrBefore(raw, log.getFlushIndex()));
+      state.put("commitIndex", logicalAtOrBefore(raw, log.getLastCommittedIndex()));
+      state.put("appliedIndex", logicalAtOrBefore(raw, impl.getState().getLastAppliedIndex()));
+      state.put("snapshotIndex", logicalAtOrBefore(raw, impl.getState().getSnapshotIndex()));
+      state.put("installedSnapshotIndex", logicalAtOrBefore(raw, impl.getState().getLatestInstalledSnapshotIndex()));
+    } catch (RuntimeException e) {
+      state.put("traceStateError", JavaUtils.getClassSimpleName(e.getClass()));
+    }
+    return state;
+  }
