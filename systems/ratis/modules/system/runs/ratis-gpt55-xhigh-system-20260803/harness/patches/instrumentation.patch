+      LOGICAL_END.clear();
+      LAST_COMMIT.clear();
+      LAST_APPLIED.clear();
+      LAST_REPLY_MATCH.clear();
+      RESET_COUNT.clear();
+      PENDING_CANDIDATES.clear();
+      PENDING_LEADERS.clear();
+      PENDING_REQUESTS.clear();
+      COMPOSED_PENDING.clear();
+      TRACE_COUNT.set(0);
+
+      if (tracePath == null || tracePath.isEmpty()) {
+        enabled = false;
+        output = null;
+        return;
+      }
+
+      output = Paths.get(tracePath);
+      Files.createDirectories(output.getParent());
+      writer = Files.newBufferedWriter(output, StandardCharsets.UTF_8,
+          StandardOpenOption.CREATE, StandardOpenOption.TRUNCATE_EXISTING, StandardOpenOption.WRITE);
+      enabled = true;
+
+      final TreeSet<RaftPeer> sorted = new TreeSet<>(Comparator.comparing(p -> p.getId().toString()));
+      sorted.addAll(peers);
+      int i = 1;
+      for (RaftPeer peer : sorted) {
+        RAW_TO_MODEL.put(peer.getId().toString(), "s" + i++);
+        TRACE_ROLE.put(peer.getId().toString(), "FOLLOWER");
+        RAW_TO_LOGICAL_INDEX.put(peer.getId().toString(), new LinkedHashMap<>());
+        LOGICAL_END.put(peer.getId().toString(), 0L);
+        LAST_COMMIT.put(peer.getId().toString(), 0L);
+        LAST_APPLIED.put(peer.getId().toString(), 0L);
+        LAST_REPLY_MATCH.put(peer.getId().toString(), 0L);
+        RESET_COUNT.put(peer.getId().toString(), 0L);
+      }
+
+      final Map<String, Object> config = new LinkedHashMap<>();
+      config.put("servers", new ArrayList<>(RAW_TO_MODEL.values()));
+      writeEnvelope("config", "config", config);
+    }
+  }
