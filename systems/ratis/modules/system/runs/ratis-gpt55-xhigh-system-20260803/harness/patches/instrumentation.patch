+      return;
+    }
+    final long modelMatch = logicalAtOrBefore(follower.getId(), reply.getMatchIndex());
+    if (modelMatch <= 0) {
+      return;
+    }
+    if (!recordReplyMatch(follower.getId(), modelMatch)) {
+      return;
+    }
+    removePendingRequest(follower.getId());
+    flushPendingLeader(leader);
+    final Map<String, Object> event = event(leader, oldStream
+        ? "GrpcLogAppender_AppendLogResponseHandler_onNext_SUCCESS_OldStream"
+        : "GrpcLogAppender_AppendLogResponseHandler_onNext_SUCCESS");
+    event.put("follower", nid(follower.getId()));
+    event.put("matchIndex", modelMatch);
+    final Map<String, Object> state = coreState(leader);
+    putFollowerProgress(state, follower);
+    event.put("state", state);
+    emit(event);
+  }
