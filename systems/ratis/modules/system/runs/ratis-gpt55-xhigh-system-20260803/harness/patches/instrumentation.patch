+    }
+  }
+
+  private static boolean recordMonotonic(Map<String, Long> store, String raw, long logicalIndex) {
+    if (!enabled || raw == null || logicalIndex <= 0) {
+      return false;
+    }
+    synchronized (LOCK) {
+      final long previous = store.getOrDefault(raw, 0L);
+      if (logicalIndex <= previous) {
+        return false;
+      }
+      store.put(raw, logicalIndex);
+      return true;
+    }
+  }
