+  private static LogEntryProto firstTraceable(RaftServer.Division server, List<LogEntryProto> entries) {
+    if (entries == null || entries.isEmpty()) {
+      return null;
+    }
+    for (LogEntryProto entry : entries) {
+      final String value = valueOf(entry);
+      if (isConfigValue(value) && !Boolean.getBoolean("specula.trace.config.events")) {
+        markBootstrapIndex(server, entry.getIndex());
+        continue;
+      }
+      if (isEntryValue(value) || isConfigValue(value) && Boolean.getBoolean("specula.trace.config.events")) {
+        return entry;
+      }
+    }
+    return null;
+  }
+
+  private static String valueOf(LogEntryProto entry) {
+    if (entry == null) {
+      return NONE;
+    }
+    if (entry.hasConfigurationEntry()) {
+      final RaftConfigurationProto conf = entry.getConfigurationEntry();
+      return conf.getOldPeersCount() > 0 || conf.getOldListenersCount() > 0 ? CONFIG_OLD_NEW : CONFIG_NEW;
+    }
+    if (entry.hasStateMachineLogEntry()) {
+      final String data = entry.getStateMachineLogEntry().getLogData().toStringUtf8();
+      return isEntryValue(data) ? data : NONE;
+    }
+    return NONE;
+  }
