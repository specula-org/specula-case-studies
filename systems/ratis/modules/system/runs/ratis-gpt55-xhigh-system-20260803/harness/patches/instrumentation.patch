+  }
+
+  private static boolean recordApplied(RaftServer.Division server, long logicalIndex) {
+    return recordMonotonic(LAST_APPLIED, raw(server), logicalIndex);
+  }
+
+  private static boolean recordReplyMatch(RaftPeerId id, long logicalIndex) {
