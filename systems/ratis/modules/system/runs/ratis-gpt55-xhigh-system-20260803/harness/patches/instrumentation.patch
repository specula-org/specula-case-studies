+  private static void flushPendingCandidate(String raw) {
+    if (!enabled || raw == null) {
+      return;
+    }
+    final List<Map<String, Object>> pending;
+    synchronized (LOCK) {
+      pending = PENDING_CANDIDATES.remove(raw);
+    }
+    if (pending == null || pending.isEmpty()) {
+      return;
+    }
+    for (Map<String, Object> event : pending) {
+      rememberRole(raw, "CANDIDATE");
+      emit(event);
+    }
+  }
