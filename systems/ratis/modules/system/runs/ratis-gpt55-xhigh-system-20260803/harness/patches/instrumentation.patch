+  private static long logicalEntryIndex(String raw, long rawIndex) {
+    if (raw == null || rawIndex <= RaftLog.INVALID_LOG_INDEX) {
+      return 0L;
+    }
+    synchronized (LOCK) {
+      return RAW_TO_LOGICAL_INDEX.getOrDefault(raw, new LinkedHashMap<>()).getOrDefault(rawIndex, 0L);
+    }
+  }
+
+  private static long logicalAtOrBefore(RaftServer.Division server, long rawIndex) {
+    return logicalAtOrBefore(raw(server), rawIndex);
+  }
+
+  private static long logicalAtOrBefore(RaftPeerId id, long rawIndex) {
+    return logicalAtOrBefore(raw(id), rawIndex);
+  }
+
+  private static long logicalAtOrBefore(String raw, long rawIndex) {
+    if (raw == null || rawIndex <= RaftLog.INVALID_LOG_INDEX) {
+      return 0L;
+    }
+    synchronized (LOCK) {
+      long logical = 0L;
+      for (Map.Entry<Long, Long> entry : RAW_TO_LOGICAL_INDEX.getOrDefault(raw, new LinkedHashMap<>()).entrySet()) {
+        if (entry.getKey() <= rawIndex) {
+          logical = Math.max(logical, entry.getValue());
+        }
+      }
+      return logical;
+    }
+  }
+
+  private static long logicalEnd(String raw) {
+    synchronized (LOCK) {
+      return LOGICAL_END.getOrDefault(raw, 0L);
+    }
+  }
+
+  private static long logicalNextIndex(RaftPeerId id, long rawNextIndex) {
+    return logicalNextIndex(raw(id), rawNextIndex);
+  }
+
+  private static long logicalNextIndex(String raw, long rawNextIndex) {
+    if (rawNextIndex <= RaftLog.LEAST_VALID_LOG_INDEX) {
+      return 1L;
+    }
+    return Math.max(1L, logicalAtOrBefore(raw, rawNextIndex - 1) + 1);
+  }
+
+  private static long logicalLogStart(String raw, long rawStartIndex) {
+    if (rawStartIndex <= RaftLog.LEAST_VALID_LOG_INDEX) {
+      return 1L;
+    }
+    return Math.max(1L, logicalAtOrBefore(raw, rawStartIndex - 1) + 1);
+  }
