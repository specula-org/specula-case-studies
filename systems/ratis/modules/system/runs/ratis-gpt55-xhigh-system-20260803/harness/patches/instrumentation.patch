+        RaftTestUtil.assertSuccessReply(client.io().send(new RaftTestUtil.SimpleMessage("v2")));
+        RaftTestUtil.assertSuccessReply(client.io().send(new RaftTestUtil.SimpleMessage("v1")));
+        RaftTestUtil.assertSuccessReply(client.io().send(new RaftTestUtil.SimpleMessage("v2")));
+      }
+
+      JavaUtils.attempt(() -> Assertions.assertNotNull(leader.getStateMachine().getLatestSnapshot()),
+          30, TimeDuration.ONE_SECOND, "leader latest snapshot", LOG);
+      final SnapshotInfo snapshot = leader.getStateMachine().getLatestSnapshot();
+      final long snapshotIndex = snapshot.getIndex();
+      Assertions.assertTrue(snapshotIndex > RaftLog.INVALID_LOG_INDEX);
+      leader.getRaftLog().purge(snapshotIndex).get(30, TimeUnit.SECONDS);
+      JavaUtils.attempt(() -> Assertions.assertTrue(leader.getRaftLog().getStartIndex()
+          > RaftLog.LEAST_VALID_LOG_INDEX), 30, TimeDuration.ONE_SECOND, "leader purge after snapshot", LOG);
+
+      cluster.restartServer(slowFollower, false);
+      waitForLeader(cluster);
+      JavaUtils.attempt(() -> {
+        Assertions.assertTrue(cluster.getDivision(slowFollower).getInfo().getLastAppliedIndex() >= snapshotIndex);
+      }, 30, TimeDuration.ONE_SECOND, "snapshot catch-up applied", LOG);
+    });
+  }
+
+  private void runScenario(String name, CheckedConsumer<MiniRaftClusterWithGrpc, Exception> scenario) throws Exception {
+    final Path traceFile = traceDir().resolve(name + ".ndjson");
+    Files.createDirectories(traceFile.getParent());
+    final MiniRaftClusterWithGrpc cluster = newCluster(3);
+    SpeculaTrace.reset(traceFile.toString(), cluster.getGroup().getPeers());
+    try {
+      cluster.start();
+      scenario.accept(cluster);
+    } finally {
+      try {
+        cluster.shutdown();
+      } finally {
+        SpeculaTrace.close();
+      }
+    }
+  }
+
+  private Path traceDir() {
+    return Paths.get(System.getProperty("specula.trace.dir", "target/specula-traces"));
+  }
+
+  private void waitForApplied(MiniRaftClusterWithGrpc cluster, long logicalIndex) throws Exception {
+    JavaUtils.attempt(() -> {
+      for (RaftServer.Division server : cluster.iterateDivisions()) {
+        if (server.getInfo().isAlive()) {
+          Assertions.assertTrue(server.getInfo().getLastAppliedIndex() >= logicalIndex);
+        }
+      }
+    }, 30, TimeDuration.ONE_SECOND, "wait for applied index " + logicalIndex, LOG);
+  }
+}
