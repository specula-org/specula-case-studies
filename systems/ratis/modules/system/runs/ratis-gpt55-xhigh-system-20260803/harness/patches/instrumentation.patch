+  private static long modelIndex(String raw, long real, long min) {
+    if (real <= RaftLog.INVALID_LOG_INDEX) {
+      return Math.max(0L, min == 0L ? 0L : min);
+    }
+    final long translated = real - INDEX_OFFSET.getOrDefault(raw, 0L);
+    return Math.max(min, translated);
