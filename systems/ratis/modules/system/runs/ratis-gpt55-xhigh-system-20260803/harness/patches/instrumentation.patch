+  private static void closeLocked() {
+    if (writer != null) {
+      try {
+        writer.flush();
+        writer.close();
+      } catch (IOException e) {
+        throw new UncheckedIOException(e);
+      } finally {
+        writer = null;
+        enabled = false;
+      }
+    } else {
+      enabled = false;
+    }
+  }
