+    ///
+    /// # Description
+    ///
+    /// Returns a read-only reference to the interrupt reason recorded for this thread, if any.
+    ///
+    /// Used by the Specula trace harness to observe the interrupt reason carried by a resumed
+    /// thread without consuming it (unlike [`Self::take_interrupt_reason`]).
+    ///
+    #[cfg(feature = "test")]
+    pub(crate) fn interrupt_reason_ref(&self) -> Option<&InterruptReason> {
+        self.interrupt_reason.as_ref()
+    }
+
+    ///
+    /// # Description
+    ///
+    /// Clears the recorded interrupt reason. Used by the Specula trace harness to model the
+    /// dispatcher's return-to-user checkpoint, which consumes the reason of a resumed thread that
+    /// returns to user mode rather than exiting.
+    ///
+    #[cfg(feature = "test")]
+    pub(crate) fn clear_interrupt_reason(&mut self) {
+        self.interrupt_reason = None;
+    }
+
+    ///
+    /// # Description
+    ///
+    /// Re-installs an interrupt reason on this thread. Used by the Specula trace harness to keep the
+    /// per-thread interrupt reason observable after `ReadyThread::run` has extracted it into the
+    /// dispatcher return value: the spec models `threadReason` as persisting on the thread until the
+    /// dispatcher checkpoint consumes it, whereas the implementation carries it out-of-band, so the
+    /// harness re-stores the real reason for snapshotting only.
+    ///
+    #[cfg(feature = "test")]
+    pub(crate) fn set_interrupt_reason_trace(&mut self, reason: InterruptReason) {
+        self.interrupt_reason = Some(reason);
+    }
+
