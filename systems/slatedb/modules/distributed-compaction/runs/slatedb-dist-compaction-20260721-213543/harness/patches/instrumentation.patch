+    pub(crate) fn trace_durable_view(
+        &self,
+    ) -> Result<(VersionedManifest, VersionedCompactions), SlateDBError> {
+        let manifest = self.manifest.prepare_dirty()?;
+        let compactions = self.compactions.prepare_dirty()?;
