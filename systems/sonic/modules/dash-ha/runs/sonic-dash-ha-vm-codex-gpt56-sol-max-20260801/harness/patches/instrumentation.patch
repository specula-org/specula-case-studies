+        HaState::InitializingToStandby => "InitializingToStandby",
+        HaState::PendingActiveActivation => "PendingActiveActivation",
+        HaState::PendingStandbyActivation => "PendingStandbyActivation",
+        HaState::Active => "Active",
+        HaState::Standby => "Standby",
+        HaState::Standalone => "Standalone",
+        HaState::SwitchingToActive => "SwitchingToActive",
+        HaState::SwitchingToStandby => "SwitchingToStandby",
+        HaState::SwitchingToStandalone => "SwitchingToStandalone",
+        HaState::Destroying => "Destroying",
+        _ => "Dead",
+    }
+}
