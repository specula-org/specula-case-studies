+#ifdef SONIC_FDB_TRACE
+#include "tla_trace.h"
+static string tla_origin_str(FdbOrigin o) {
+    switch (o) {
+        case FDB_ORIGIN_LEARN: return "learn";
+        case FDB_ORIGIN_PROVISIONED: return "provisioned";
+        case FDB_ORIGIN_VXLAN_ADVERTIZED: return "vxlan_advertized";
+        case FDB_ORIGIN_MCLAG_ADVERTIZED: return "mclag_advertized";
+        default: return "invalid";
+    }
+}
+static string tla_vlan_name(PortsOrch* portsOrch, sai_object_id_t bv_id) {
+    Port vlan;
+    if (portsOrch->getPort(bv_id, vlan))
+        return "Vlan" + to_string(vlan.m_vlan_info.vlan_id);
+    return "";
+}
+#endif
+
 extern sai_fdb_api_t    *sai_fdb_api;
 
