#!/usr/bin/env bash
set -euo pipefail

state_dir=${SPECULA_FAKE_STATE_DIR:?}
operation=${1:-}
shift || true

case "$operation" in
    is-enabled)
        echo enabled
        ;;
    stop)
        service=${1:?}
        if [[ "$service" == *@"${SPECULA_FAIL_STOP_ASIC:-1}" ]]; then
            exit 1
        fi
        : > "${state_dir}/stopped_${service//@/_}"
        ;;
    is-active)
        [[ "${1:-}" == --quiet ]] && shift
        service=${1:?}
        if [[ -f "${state_dir}/stopped_${service//@/_}" ]]; then
            exit 3
        fi
        exit 0
        ;;
    *)
        exit 0
        ;;
esac
