#!/usr/bin/env bash
set -euo pipefail

state_dir=${SPECULA_FAKE_STATE_DIR:?}
command_line=" $* "

if [[ "$command_line" == *" keys WARM_RESTART_ENABLE_TABLE|* "* ]]; then
    [[ "$(<"${state_dir}/warm")" == true ]] && echo 'WARM_RESTART_ENABLE_TABLE|system'
    exit 0
fi

if [[ "$command_line" == *" hget WARM_RESTART_ENABLE_TABLE|"*" enable "* ]]; then
    cat "${state_dir}/warm"
    exit 0
fi

if [[ "$command_line" == *" hget FAST_RESTART_ENABLE_TABLE|system enable "* ]]; then
    cat "${state_dir}/fast"
    exit 0
fi

if [[ "$command_line" == *" HSET FAST_RESTART_ENABLE_TABLE|system enable true "* ]]; then
    printf '%s\n' true > "${state_dir}/fast"
    exit 0
fi

if [[ "$command_line" == *" HSET FAST_RESTART_ENABLE_TABLE|system enable false "* ]]; then
    printf '%s\n' false > "${state_dir}/fast"
    exit 0
fi

exit 0
