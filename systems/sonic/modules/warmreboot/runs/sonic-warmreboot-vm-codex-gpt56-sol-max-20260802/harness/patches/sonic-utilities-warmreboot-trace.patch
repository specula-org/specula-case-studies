+        systemctl is-active --quiet "${service_name}" && writer_stopped=false
+        if [[ $stop_rc -eq 0 ]]; then
+            specula_trace_emit "StopSystemdService_Success" \
+                "asic=$(specula_trace_asic)" \
+                "writer_stopped=${writer_stopped}"
+        else
+            specula_trace_emit "StopSystemdService_MaskedFailure" \
+                "asic=$(specula_trace_asic)" \
+                "writer_stopped=${writer_stopped}"
+        fi
+    fi
 }
 
