+# Specula trace instrumentation is inert unless the harness exports a client
+# and collector socket.  Test-only path overrides keep trace scenarios away
+# from host reboot state without changing the production defaults.
+if [[ -n "${SPECULA_TRACE_TEST_MODE:-}" ]]; then
+    WARM_DIR="${SPECULA_TRACE_WARM_DIR:-${WARM_DIR}}"
+    SHUTDOWN_ORDER_FILE="${SPECULA_TRACE_SHUTDOWN_ORDER_FILE:-${SHUTDOWN_ORDER_FILE}}"
+fi
+
+function specula_trace_emit()
+{
+    [[ -n "${SPECULA_TRACE_CLIENT:-}" && -n "${SPECULA_TRACE_SOCKET:-}" ]] || return 0
+
+    local -r event_name="$1"
+    shift
+    python3 "${SPECULA_TRACE_CLIENT}" emit \
+        --socket "${SPECULA_TRACE_SOCKET}" \
+        --event "${event_name}" \
+        --owner-token "${SPECULA_TRACE_OWNER_TOKEN}" \
+        --process "${REBOOT_SCRIPT_NAME}@${DEV:-global}" \
+        --pid "${BASHPID}" \
+        "$@" || /bin/true
+}
+
+if [[ -n "${SPECULA_TRACE_CLIENT:-}" && -n "${SPECULA_TRACE_SOCKET:-}" ]]; then
+    SPECULA_TRACE_OWNER_TOKEN="${BASHPID}:$(sed -n 's/^\([^)]*\)) \([^ ]* \)\{19\}\([^ ]*\).*/\3/p' "/proc/${BASHPID}/stat")"
+    export SPECULA_TRACE_OWNER_TOKEN
+fi
+
+function specula_trace_asic()
+{
+    if [[ -n "${DEV:-}" ]]; then
+        echo "asic_${DEV}"
+    else
+        echo "asic_0"
+    fi
+}
+
+function specula_trace_bool()
+{
+    [[ "${1,,}" == "true" || "$1" == "1" ]] && echo true || echo false
+}
+
+function specula_trace_warm_flag()
+{
+    local key
+    while read -r key; do
+        if [[ -n "$key" ]] && \
+           [[ "$(sonic-db-cli -n "${NETNS:-}" STATE_DB hget "$key" enable 2>/dev/null)" == "true" ]]; then
+            echo true
+            return 0
+        fi
+    done < <(sonic-db-cli -n "${NETNS:-}" STATE_DB keys "WARM_RESTART_ENABLE_TABLE|*" 2>/dev/null)
+    echo false
+}
+
+function specula_trace_fast_flag()
+{
+    local value
+    value=$(sonic-db-cli STATE_DB hget "FAST_RESTART_ENABLE_TABLE|system" enable 2>/dev/null)
+    specula_trace_bool "$value"
+}
+
 EXIT_SUCCESS=0
 EXIT_FAILURE=1
 EXIT_NOT_SUPPORTED=2
