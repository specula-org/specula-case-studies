---------------- MODULE RecoveryFairness ----------------
EXTENDS MCContract
WriterSteps(o) ==
    \/ B!TaskWriterDequeue(o)
    \/ B!AssignTaskIDs(o)
    \/ B!CreateTasksBegin(o)
    \/ B!CreateTasksCommit(o)
    \/ B!CreateTasksConditionFailed(o)
    \/ B!CreateTasksUncertainReturn(o)
    \/ B!SignalNewTasksBypass(o)
    \/ B!SignalNewTasksWake(o)
    \/ B!SignalReadersDone(o)
    \/ B!TaskWriterPublish(o)
    \/ B!TaskWriterPublishReplacement(o)
    \/ B!RenewLeaseBegin(o)
    \/ B!RenewLeaseRetry(o)
    \/ B!RenewLeaseFailure(o)
    \/ \E reply \in {"ok","condition","definite","unknown"}: B!CreateTasksReturn(o,reply)
ReaderSteps(o) ==
    \/ B!GetTasksPump(o)
    \/ B!GetTaskBatchMax(o)
    \/ B!GetTasksIssue(o)
    \/ B!GetTasksSnapshot(o)
    \/ B!GetTaskBatchReturn(o)
    \/ B!ProcessTaskBatch(o)
    \/ B!ProcessTaskBatchDone(o)
    \/ B!SetReadLevelAfterGapStale(o)
    \/ B!SetReadLevelAfterGap(o)
    \/ B!SetReadLevelAfterGapAck(o)
    \/ B!UpdateAckLevelAfterGap(o)
    \/ B!BackoffSignal(o)
MetadataFinish(o) ==
    \/ B!TakeOverTaskQueueSnapshot(o)
    \/ B!UpdateTaskQueueCommit(o)
    \/ B!VerifyOwnership(o)
    \/ B!UpdateTaskQueueConditionFailed(o)
    \/ B!UpdateTaskQueueReturn(o)
CompletionSteps(o) ==
    \/ B!AckTaskLockedDrained(o)
    \/ B!UpdateAckLevelAndBacklogStats(o)
    \/ \E launch \in BOOLEAN : B!MaybeGCLocked(o,launch)
    \/ \E r \in 1..ProgressIdCeiling : B!AddTaskToMatcher(o,r) \/ B!AddTaskToMatcherClosed(o,r)
PollerSteps(p) ==
    \/ B!RecordTaskStarted(p)
    \/ B!RecordTaskStartedReply(p)
    \/ B!CompleteTaskTransient(p)
    \/ B!RespoolTaskAfterError(p)
    \/ B!RespoolTaskReturn(p)
    \/ B!RespoolTaskRetry(p)
    \/ B!RespoolTaskShutdown(p)
    \/ B!CompleteTaskAck(p)
    \/ B!PollTaskQueueResponse(p)
    \/ B!PollTaskErrorReturn(p)
    \/ \E q \in StartIds : B!RecordTaskStartedBegin(p,q)
    \/ \E o \in Owners : \E r \in 1..ProgressIdCeiling : B!PollTask(o,r,p)
RecoveryScheduling ==
    /\ \A o \in Owners : SF_mcvars(Track(WriterSteps(o)) /\ UNCHANGED faults)
    /\ \A o \in Owners : SF_mcvars(Track(ReaderSteps(o)) /\ UNCHANGED faults)
    /\ \A o \in Owners : SF_mcvars(Track(CompletionSteps(o)) /\ UNCHANGED faults)
    /\ \A o \in Owners : WF_mcvars(Track(MetadataFinish(o)) /\ UNCHANGED faults)
    /\ \A p \in Pollers : SF_mcvars(Track(PollerSteps(p)) /\ UNCHANGED faults)
=============================================================================
