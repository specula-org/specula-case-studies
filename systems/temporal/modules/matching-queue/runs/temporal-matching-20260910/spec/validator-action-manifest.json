{
  "extension": "root-validator",
  "base_actions": 85,
  "actions": [
    {
      "name": "ValidationMatch",
      "source": "service/matching/pri_matcher.go:validateTasksOnRoot",
      "postKeys": [
        "owner",
        "dispatch",
        "validationHolds"
      ]
    },
    {
      "name": "ValidationResult",
      "source": "service/matching/pri_matcher.go:validateTasksOnRoot",
      "postKeys": [
        "dispatch",
        "history"
      ]
    },
    {
      "name": "ValidationDone",
      "source": "service/matching/pri_matcher.go:validateTasksOnRoot",
      "postKeys": [
        "validationHolds"
      ]
    }
  ]
}
