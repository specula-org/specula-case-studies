ed-learning","pet","privacy-protection","python"],"visibility":"public","forks":281,"open_issues":30,"watchers":968,"default_branch":"main","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/NVIDIA/NVFlare/pulls/5092","html_url":"https://github.com/NVIDIA/NVFlare/pull/5092","diff_url":"https://github.com/NVIDIA/NVFlare/pull/5092.diff","patch_url":"https://github.com/NVIDIA/NVFlare/pull/5092.patch","merged_at":"2026-08-12T22:43:29Z"},"body":"## Summary\n\n- add portable `num_of_cpus` and host `memory` requirements alongside `num_of_gpus`\n- add `resource_spec[\"@default\"]` with shallow per-site overrides\n- use the same resolved requirements for scheduling, dispatch, cancellation, and launcher enforcement\n- translate the portable fields to Docker, Kubernetes, and Slurm while preserving legacy resource specifications\n\n## Backend mappings\n\n| Field | Docker | Kubernetes | Slurm |\n|---|---|---|---|\n| `num_of_gpus` | GPU device requests | `nvidia.com/gpu` request and limit | `--gres` |\n| `num_of_cpus` | `nano_cpus` | CPU request and limit | `--cpus-per-task` |\n| `memory` | `mem_limit` in bytes | memory request and limit | `--mem` in MiB |\n\nGPU memory and other backend-specific topology or policy remain outside the portable contract.\n\n## Validation\n\n- `557 passed` across the focused scheduler, validator, utility, Docker, Kubernetes, and Slurm tests\n- `./runtest.sh -s`\n- `git diff --check`\n\nCloses #5083\n","reactions":{"url":"https://api.github.com/repos/NVIDIA/NVFlare/issues/5092/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/NVIDIA/NVFlare/issues/5092/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"id":29369489955,"node_id":"CE_lADOFy3KIc8AAAABMO53Ks8AAAAG1o7aIw","url":"https://api.github.com/repos/NVIDIA/NVFlare/issu