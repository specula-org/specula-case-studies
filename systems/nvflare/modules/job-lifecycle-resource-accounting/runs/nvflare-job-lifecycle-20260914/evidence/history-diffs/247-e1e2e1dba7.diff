+            self.get_conn_client()
+            if self.conn_client:
+                data = {"command": AdminCommandNames.AUX_COMMAND, "data": shareable}
+                self.conn_client.send(data)
+                reply = self.conn_client.recv()
+                return reply
+            else:
+                return make_reply(ReturnCode.EXECUTION_EXCEPTION)
+        except:
+            return make_reply(ReturnCode.EXECUTION_EXCEPTION)
