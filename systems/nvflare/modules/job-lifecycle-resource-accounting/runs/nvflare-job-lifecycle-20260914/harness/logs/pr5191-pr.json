  "locked": false,
  "title": "Handle unexpected job admission failures",
  "user": {
    "login": "YuanTingHsieh",
    "id": 13113932,
    "node_id": "MDQ6VXNlcjEzMTEzOTMy",
    "avatar_url": "https://avatars.githubusercontent.com/u/13113932?v=4",
    "gravatar_id": "",
    "url": "https://api.github.com/users/YuanTingHsieh",
    "html_url": "https://github.com/YuanTingHsieh",
    "followers_url": "https://api.github.com/users/YuanTingHsieh/followers",
    "following_url": "https://api.github.com/users/YuanTingHsieh/following{/other_user}",
    "gists_url": "https://api.github.com/users/YuanTingHsieh/gists{/gist_id}",
    "starred_url": "https://api.github.com/users/YuanTingHsieh/starred{/owner}{/repo}",
    "subscriptions_url": "https://api.github.com/users/YuanTingHsieh/subscriptions",
    "organizations_url": "https://api.github.com/users/YuanTingHsieh/orgs",
    "repos_url": "https://api.github.com/users/YuanTingHsieh/repos",
    "events_url": "https://api.github.com/users/YuanTingHsieh/events{/privacy}",
    "received_events_url": "https://api.github.com/users/YuanTingHsieh/received_events",
    "type": "User",
