+for mode in ('pristine', 'patched-disabled', 'patched-noop'):
+    root = source if mode == 'pristine' else h / 'build/nvflare_src'
+    env = dict(os.environ, PYTHONPATH=f'{root}:{source}:{h / "src"}', EXPECT_NVFLARE_ROOT=str(root),
