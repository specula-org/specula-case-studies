+		speculatrace.Fingerprint(persisted.ConsensusParams),
+		current.LastHeightConsensusParamsChanged,
+		persisted.LastHeightConsensusParamsChanged,
+		phase,
+		pendingBlockHeight,
+		pendingParam,
+		validationOutcome,
+	)
+}
