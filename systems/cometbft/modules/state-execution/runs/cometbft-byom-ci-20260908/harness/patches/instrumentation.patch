+package state_test
+
+import (
+	"context"
+	"testing"
+
+	"github.com/stretchr/testify/mock"
+	"github.com/stretchr/testify/require"
+
+	dbm "github.com/cometbft/cometbft-db"
+	abci "github.com/cometbft/cometbft/abci/types"
+	cmtproto "github.com/cometbft/cometbft/api/cometbft/types/v1"
+	"github.com/cometbft/cometbft/internal/speculatrace"
+	sm "github.com/cometbft/cometbft/internal/state"
+	"github.com/cometbft/cometbft/internal/store"
+	"github.com/cometbft/cometbft/libs/log"
+	mpmocks "github.com/cometbft/cometbft/mempool/mocks"
+	"github.com/cometbft/cometbft/proxy"
+	"github.com/cometbft/cometbft/types"
+)
+
+type speculaInvalidParamsApp struct {
+	abci.BaseApplication
+}
+
+func (speculaInvalidParamsApp) FinalizeBlock(
+	_ context.Context,
+	req *abci.FinalizeBlockRequest,
+) (*abci.FinalizeBlockResponse, error) {
+	txResults := make([]*abci.ExecTxResult, len(req.Txs))
+	for i := range txResults {
+		txResults[i] = &abci.ExecTxResult{Code: abci.CodeTypeOK}
+	}
+	return &abci.FinalizeBlockResponse{
+		TxResults: txResults,
+		ConsensusParamUpdates: &cmtproto.ConsensusParams{
+			Block: &cmtproto.BlockParams{MaxBytes: 0, MaxGas: 1},
+		},
+	}, nil
+}
+
+func speculaApplyOneBlock(
+	t *testing.T,
+	app abci.Application,
+) (sm.State, sm.Store, error) {
+	t.Helper()
+	require.NoError(t, speculatrace.Reset())
+
+	clientCreator := proxy.NewLocalClientCreator(app)
+	proxyApp := proxy.NewAppConns(clientCreator, proxy.NopMetrics())
+	require.NoError(t, proxyApp.Start())
+	t.Cleanup(func() { require.NoError(t, proxyApp.Stop()) })
+
+	state, stateDB, _ := makeState(1, 1)
+	stateStore := sm.NewStore(stateDB, sm.StoreOptions{DiscardABCIResponses: false})
+	blockStore := store.NewBlockStore(dbm.NewMemDB())
+
+	mp := &mpmocks.Mempool{}
+	mp.On("Lock").Return()
+	mp.On("Unlock").Return()
+	mp.On("FlushAppConn", mock.Anything).Return(nil)
+	mp.On("Update", mock.Anything, mock.Anything, mock.Anything, mock.Anything, mock.Anything).Return(nil)
+
+	blockExec := sm.NewBlockExecutor(
+		stateStore,
+		log.TestingLogger(),
+		proxyApp.Consensus(),
+		mp,
+		sm.EmptyEvidencePool{},
+		blockStore,
+	)
+	block := makeBlock(state, 1, new(types.Commit))
+	parts, err := block.MakePartSet(testPartSize)
+	require.NoError(t, err)
+	blockID := types.BlockID{Hash: block.Hash(), PartSetHeader: parts.Header()}
+	seenCommit := &types.Commit{Height: block.Height, BlockID: blockID}
+	blockStore.SaveBlock(block, parts, seenCommit)
+
+	newState, err := blockExec.ApplyBlock(state, blockID, block)
+	return newState, stateStore, err
+}
+
+func TestSpeculaTraceApplyValidUpdate(t *testing.T) {
+	state, _, err := speculaApplyOneBlock(t, &testApp{})
+	require.NoError(t, err)
+	require.EqualValues(t, 1, state.LastBlockHeight)
+	require.EqualValues(t, 1, state.Version.Consensus.App)
+	require.EqualValues(t, 2, state.LastHeightConsensusParamsChanged)
+}
+
+func TestSpeculaTraceApplyRejectedUpdate(t *testing.T) {
+	state, stateStore, err := speculaApplyOneBlock(t, speculaInvalidParamsApp{})
+	require.Error(t, err)
+	require.EqualValues(t, 0, state.LastBlockHeight)
+	persisted, loadErr := stateStore.Load()
+	require.NoError(t, loadErr)
+	require.EqualValues(t, 0, persisted.LastBlockHeight)
+	require.Equal(t, persisted.ConsensusParams, state.ConsensusParams)
+}
