new file mode 100644
index 0000000..fe40cdb
--- /dev/null
+++ b/internal/speculatrace/trace.go
@@ -0,0 +1,169 @@
+// Package speculatrace provides opt-in NDJSON tracing for the Specula V0
+// harness. When SPECULA_TRACE_FILE is unset every operation is a no-op.
+package speculatrace
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"os"
+	"sync"
+	"time"
+)
+
+const NoParam = "NoParam"
+
+var traceState struct {
+	sync.Mutex
+	file           *os.File
+	path           string
+	replay         bool
+	appHeight      int64
+	responseHeight int64
+	responseParam  string
+}
+
+// Enabled reports whether this process was launched for trace collection.
+func Enabled() bool {
+	return os.Getenv("SPECULA_TRACE_FILE") != ""
+}
+
+// Reset truncates the configured trace file. It is used at the real Handshake
+// entry point so test-fixture setup does not contaminate recovery traces.
+func Reset() error {
+	path := os.Getenv("SPECULA_TRACE_FILE")
+	if path == "" {
+		return nil
+	}
+	traceState.Lock()
+	defer traceState.Unlock()
+	if traceState.file != nil {
+		_ = traceState.file.Close()
+	}
+	f, err := os.OpenFile(path, os.O_CREATE|os.O_TRUNC|os.O_WRONLY, 0o600)
+	if err != nil {
+		return err
+	}
+	traceState.file = f
+	traceState.path = path
+	traceState.replay = false
+	traceState.appHeight = 0
+	traceState.responseHeight = 0
+	traceState.responseParam = NoParam
+	return nil
+}
+
+// Fingerprint gives a stable symbolic identity to a complete consensus
+// parameter value without baking its large Go representation into the model.
+func Fingerprint(v any) string {
+	b, err := json.Marshal(v)
+	if err != nil {
+		return "marshal-error"
+	}
+	sum := sha256.Sum256(b)
+	return hex.EncodeToString(sum[:])
+}
+
+func SetReplay(v bool) {
+	traceState.Lock()
+	defer traceState.Unlock()
+	traceState.replay = v
+}
+
+func IsReplay() bool {
+	traceState.Lock()
+	defer traceState.Unlock()
+	return traceState.replay
+}
+
+func SetAppHeight(h int64) {
+	traceState.Lock()
+	defer traceState.Unlock()
+	traceState.appHeight = h
+}
+
+func AppHeight() int64 {
+	traceState.Lock()
+	defer traceState.Unlock()
+	return traceState.appHeight
+}
+
+func SetResponse(height int64, param string) {
+	traceState.Lock()
+	defer traceState.Unlock()
+	traceState.responseHeight = height
+	traceState.responseParam = param
+}
+
+func Response() (int64, string) {
+	traceState.Lock()
+	defer traceState.Unlock()
+	return traceState.responseHeight, traceState.responseParam
+}
+
+// LifecycleState constructs the state object consumed by Trace.tla.
+func LifecycleState(
+	blockStoreHeight, stateStoreHeight, inMemoryStateHeight int64,
+	activeParam, persistedParam string,
+	lastParamChange, persistedLastParamChange int64,
+	phase string,
+	pendingBlockHeight int64,
+	pendingParam, validationOutcome string,
+) map[string]any {
+	traceState.Lock()
+	defer traceState.Unlock()
+	return map[string]any{
+		"blockStoreHeight":         blockStoreHeight,
+		"appHeight":                traceState.appHeight,
+		"stateStoreHeight":         stateStoreHeight,
+		"stateHeight":              inMemoryStateHeight,
+		"activeParam":              activeParam,
+		"persistedParam":           persistedParam,
+		"lastParamChange":          lastParamChange,
+		"persistedLastParamChange": persistedLastParamChange,
+		"phase":                    phase,
+		"replayMutatesState":       traceState.replay,
+		"responseHeight":           traceState.responseHeight,
+		"responseParam":            traceState.responseParam,
+		"pendingBlockHeight":       pendingBlockHeight,
+		"pendingParam":             pendingParam,
+		"validationOutcome":        validationOutcome,
+	}
+}
+
+// Emit appends one mutex-serialized event with a real wall-clock timestamp.
+// Instrumentation deliberately ignores its returned error at call sites so it
+// cannot change the system's functional error paths.
+func Emit(name string, state map[string]any, msg map[string]any) error {
+	path := os.Getenv("SPECULA_TRACE_FILE")
+	if path == "" {
+		return nil
+	}
+	traceState.Lock()
+	defer traceState.Unlock()
+	if traceState.file == nil || traceState.path != path {
+		if traceState.file != nil {
+			_ = traceState.file.Close()
+		}
+		f, err := os.OpenFile(path, os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0o600)
+		if err != nil {
+			return err
+		}
+		traceState.file = f
+		traceState.path = path
+	}
+	event := map[string]any{
+		"tag": "trace",
+		"ts":  time.Now().UnixNano(),
+		"event": map[string]any{
+			"name":  name,
+			"nid":   "node",
+			"state": state,
+			"msg":   msg,
+		},
+	}
+	if err := json.NewEncoder(traceState.file).Encode(event); err != nil {
+		return err
+	}
+	return traceState.file.Sync()
+}
