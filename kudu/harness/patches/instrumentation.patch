@@ -367,6 +368,27 @@ void LeaderElection::VoteResponseRpcCallback(const string& voter_uuid) {
     }
   }

+  // --- TLA+ trace: HandleRequestVoteResponse (remote vote) ---
+  if (tla_trace::IsEnabled()) {
+    bool is_pre = request_.is_pre_election();
+    int64_t cand_term = is_pre ? request_.candidate_term() - 1
+                               : request_.candidate_term();
+    tla_trace::TraceState ts;
+    ts.term = cand_term;
+    ts.role = "Candidate";
+    ts.votedFor = is_pre ? "" : tla_trace::Nid(request_.candidate_uuid());
+    ts.commitIndex = trace_commit_index_;
+    ts.lastLogIndex = request_.candidate_status().last_received().index();
+    ts.lastLogTerm = request_.candidate_status().last_received().term();
+    std::lock_guard guard2(lock_);
+    VoterState* vstate = FindOrDie(voter_state_, voter_uuid).get();
+    int64_t resp_term = vstate->response.has_responder_term()
+        ? vstate->response.responder_term() : cand_term;
+    tla_trace::TraceEvent("HandleRequestVoteResponse")
+        .Node(tla_trace::Nid(request_.candidate_uuid()))
+        .State(ts)
+        .MsgStr("from", tla_trace::Nid(voter_uuid))
+        .MsgStr("to", tla_trace::Nid(request_.candidate_uuid()))
+        .MsgBool("voteGranted", vstate->response.vote_granted())
+        .MsgInt("term", resp_term)
+        .Emit();
+  }
+
   // Check for a decision outside the lock.
   CheckForDecision();
 }
