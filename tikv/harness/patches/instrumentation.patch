+// Bug reproduction: raft-rs #511
+// PreVote + priority at term=0 causes fatal panic when a high-priority node
+// rejects a PreVote from a lower-priority node. The rejection response carries
+// term=self.term=0, but send() asserts that vote/prevote messages must have
+// non-zero term (raft.rs:631-648).
+//
+// Trigger: 3 fresh nodes (term=0), pre_vote=true, different priorities.
+// Low-priority node starts PreVote election. High-priority node rejects.
+// Rejection response has term=0 -> fatal! panic in send().
+#[test]
+fn test_bug_prevote_priority_panic_at_term_zero() {
+    let l = default_logger();
+
+    // Create 3 nodes with pre_vote=true. Do NOT call become_follower to keep term=0.
+    let mut n1 = new_test_raft_with_prevote(1, vec![1, 2, 3], 10, 1, new_storage(), true, &l);
+    let mut n2 = new_test_raft_with_prevote(2, vec![1, 2, 3], 10, 1, new_storage(), true, &l);
+    let mut n3 = new_test_raft_with_prevote(3, vec![1, 2, 3], 10, 1, new_storage(), true, &l);
+
+    // Node 1: low priority (will campaign). Nodes 2,3: high priority (will reject).
+    n1.set_priority(1);
+    n2.set_priority(5);
+    n3.set_priority(5);
+
+    // Verify all nodes are at term=0 (fresh initialization).
+    assert_eq!(n1.term, 0, "node 1 should start at term 0");
+    assert_eq!(n2.term, 0, "node 2 should start at term 0");
+    assert_eq!(n3.term, 0, "node 3 should start at term 0");
+
+    let mut network = Network::new(vec![Some(n1), Some(n2), Some(n3)], &l);
+
+    // Node 1 (low priority) triggers PreVote election.
+    // Node 2/3 (high priority, term=0) will reject -> send PreVoteResponse with term=0.
+    // The send() function fatally panics on term=0 vote messages.
+    let result = panic::catch_unwind(AssertUnwindSafe(|| {
+        network.send(vec![new_message(1, 1, MessageType::MsgHup, 0)]);
+    }));
+
+    // Bug #511: this SHOULD succeed without panic, but currently panics.
+    assert!(
+        result.is_err(),
+        "BUG CONFIRMED: PreVote rejection at term=0 should have caused a panic (raft-rs #511)"
+    );
+
+    // Verify the panic message mentions the term=0 assertion.
+    if let Err(panic_info) = &result {
+        let msg = if let Some(s) = panic_info.downcast_ref::<String>() {
+            s.clone()
+        } else if let Some(s) = panic_info.downcast_ref::<&str>() {
+            s.to_string()
+        } else {
+            "unknown panic".to_string()
+        };
+        assert!(
+            msg.contains("term should be set when sending"),
+            "Panic message should be about term=0 in vote message, got: {msg}"
+        );
+    }
+}
