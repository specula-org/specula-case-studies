+// Bug reproduction: Priority blocks CAMPAIGN_TRANSFER votes.
+// When the leader transfers leadership to a low-priority node, high-priority
+// voters reject the transfer election even though CAMPAIGN_TRANSFER bypasses
+// the lease check. The priority check at raft.rs:1499 is NOT bypassed for
+// transfer elections, causing the transfer to fail.
+//
+// Scenario: 3-node cluster where all other voters have higher priority than
+// the transfer target. The target cannot get a majority because both voters
+// reject based on priority, even though the transfer was explicitly requested.
+#[test]
+fn test_bug_priority_blocks_leader_transfer() {
+    let l = default_logger();
+
+    // 3-node cluster. Node 1 will be leader and transfer target is node 2.
+    // Node 2: low priority (transfer target). Nodes 1,3: high priority (voters).
+    let mut n1 = new_test_raft_with_prevote(1, vec![1, 2, 3], 10, 1, new_storage(), true, &l);
+    let mut n2 = new_test_raft_with_prevote(2, vec![1, 2, 3], 10, 1, new_storage(), true, &l);
+    let mut n3 = new_test_raft_with_prevote(3, vec![1, 2, 3], 10, 1, new_storage(), true, &l);
+
+    n1.set_priority(10);
+    n2.set_priority(1); // Transfer target: lowest priority
+    n3.set_priority(10);
+
+    // Initialize to term=1 to avoid the term=0 panic (bug #511).
+    n1.become_follower(1, INVALID_ID);
+    n2.become_follower(1, INVALID_ID);
+    n3.become_follower(1, INVALID_ID);
+
+    let mut network = Network::new(vec![Some(n1), Some(n2), Some(n3)], &l);
+
+    // Elect node 1 as leader (highest priority tied with node 3, but node 1 campaigns first).
+    network.send(vec![new_message(1, 1, MessageType::MsgHup, 0)]);
+    assert_eq!(
+        network.peers[&1].state,
+        StateRole::Leader,
+        "node 1 should become leader"
+    );
+
+    // Replicate an entry so all logs are synchronized.
+    network.send(vec![new_message(1, 1, MessageType::MsgPropose, 1)]);
+
+    // Transfer leadership from node 1 (priority=10) to node 2 (priority=1).
+    // Node 2's log is up to date. Leader sends MsgTimeoutNow to node 2.
+    // Node 2 campaigns with CAMPAIGN_TRANSFER (which bypasses lease check but NOT priority).
+    let transfer_msg = new_message(2, 1, MessageType::MsgTransferLeader, 0);
+    network.send(vec![transfer_msg]);
+
+    // Analysis of the vote:
+    // - Node 2 votes for itself: 1 vote
+    // - Node 1 (priority=10) receives vote request from node 2 (priority=1):
+    //   m.index == node1.last_index (equal logs) -> falls to priority check
+    //   node1.priority(10) <= node2.priority(1) -> FALSE -> REJECTED
+    // - Node 3 (priority=10) receives vote request from node 2 (priority=1):
+    //   m.index == node3.last_index (equal logs) -> falls to priority check
+    //   node3.priority(10) <= node2.priority(1) -> FALSE -> REJECTED
+    // - Node 2 gets 1/3 votes -> election fails
+    //
+    // The transfer should succeed, but priority blocks it.
+    let node2_is_leader = network.peers[&2].state == StateRole::Leader;
+
+    // This assertion documents the bug: transfer fails when it should succeed.
+    assert!(
+        !node2_is_leader,
+        "BUG CONFIRMED: transfer to low-priority node 2 is blocked by priority check"
+    );
+
+    // Verify node 1 stepped down (it received a higher-term vote request).
+    assert_ne!(
+        network.peers[&1].state,
+        StateRole::Leader,
+        "old leader (node 1) should have stepped down"
+    );
+
+    // No node is leader — the cluster is leaderless until a new election.
+    // This is a liveness regression: the explicitly requested transfer failed,
+    // AND the original leader stepped down, leaving the cluster without a leader.
+    let any_leader = (1..=3).any(|id| network.peers[&id].state == StateRole::Leader);
+    assert!(
+        !any_leader,
+        "BUG: no node is leader after failed transfer — cluster is stuck until election timeout"
+    );
+}
+
+// Bug reproduction: Leader removed from config does not step down.
+// When a configuration change removes the current leader from the voter set,
+// post_conf_change() at raft.rs:2747-2757 detects the removal but does NOT
+// step down. It just sets promotable=false and returns early. Two explicit
+// TODOs from the etcd/raft authors acknowledge this.
+//
+// Impact: The removed leader continues sending heartbeats, suppressing
+// elections on remaining voters. Without check_quorum, the cluster is
+// blocked indefinitely — no new leader can be elected.
+#[test]
+fn test_bug_removed_leader_does_not_step_down() {
+    let l = default_logger();
+    let mut nt = Network::new(vec![None, None, None], &l);
+
+    // Elect node 1 as leader.
+    nt.send(vec![new_message(1, 1, MessageType::MsgHup, 0)]);
+    assert_eq!(nt.peers[&1].state, StateRole::Leader);
+
+    // Replicate an entry so all logs are synchronized.
+    nt.send(vec![new_message(1, 1, MessageType::MsgPropose, 1)]);
+
+    // Apply committed entries on the leader so we can apply the conf change.
+    let committed = nt.peers[&1].raft_log.committed;
+    nt.peers.get_mut(&1).unwrap().commit_apply(committed);
+
+    // Remove the leader (node 1) from the voter set.
+    let cs = nt.peers.get_mut(&1).unwrap().apply_conf_change(&remove_node(1)).unwrap();
+
+    // Verify node 1 was removed from the voter set.
+    assert!(
+        !cs.voters.contains(&1),
+        "node 1 should no longer be a voter"
+    );
+
+    // BUG: node 1 is still the leader even though it's no longer a voter!
+    assert_eq!(
+        nt.peers[&1].state,
+        StateRole::Leader,
+        "BUG CONFIRMED: removed leader does not step down (raft.rs:2747-2757 TODO)"
+    );
+
+    // Verify it's no longer promotable (the partial fix that exists).
+    assert!(
+        !nt.peers[&1].promotable(),
+        "removed leader should not be promotable"
+    );
+
+    // Now demonstrate the liveness impact: the removed leader's heartbeats
+    // suppress elections on remaining voters.
+    //
+    // Tick node 1 enough to trigger heartbeat sending.
+    let heartbeat_timeout = nt.peers[&1].heartbeat_timeout();
+    for _ in 0..heartbeat_timeout {
+        nt.peers.get_mut(&1).unwrap().tick();
+    }
+
+    // Collect heartbeat messages from the removed leader.
+    let msgs = nt.peers.get_mut(&1).unwrap().read_messages();
+    let heartbeats: Vec<_> = msgs
+        .iter()
+        .filter(|m| m.get_msg_type() == MessageType::MsgHeartbeat)
+        .collect();
+
+    // BUG IMPACT: removed leader still sends heartbeats to remaining voters.
+    assert!(
+        !heartbeats.is_empty(),
+        "BUG IMPACT: removed leader still sends heartbeats, suppressing elections"
+    );
+
+    // Deliver these heartbeats to node 2 and collect responses.
+    for hb in &heartbeats {
+        if hb.to == 2 {
+            let _ = nt.peers.get_mut(&2).unwrap().step((**hb).clone());
+        }
+    }
+
+    // Node 2 should still be a follower with node 1 as leader.
+    assert_eq!(
+        nt.peers[&2].state,
+        StateRole::Follower,
+        "node 2 should still be a follower — heartbeats from removed leader suppress elections"
+    );
+    assert_eq!(
+        nt.peers[&2].leader_id, 1,
+        "node 2 still thinks the removed node 1 is leader"
+    );
+}
+
+// Bug reproduction: Auto-leave joint consensus stalls on leader change.
+// The auto-leave mechanism at raft.rs:987-1007 only triggers when
+// self.state == StateRole::Leader. If a follower applies the enter-joint
+// entry, the auto_leave check is skipped.
+//
+// This test demonstrates two consequences:
+// 1. A follower applying the enter-joint entry does NOT trigger auto_leave
+//    (the state != Leader guard prevents it).
+// 2. If the joint config adds nodes that don't yet exist in the cluster,
+//    the cluster gets stuck: no new leader can be elected (joint consensus
+//    requires quorum from both old and new configs), and auto_leave cannot
+//    fire because there is no leader.
+#[test]
+fn test_bug_auto_leave_joint_stalls_on_leader_crash() {
+    let l = default_logger();
+    let mut nt = Network::new(vec![None, None, None], &l);
+
+    // Elect node 1 as leader.
+    nt.send(vec![new_message(1, 1, MessageType::MsgHup, 0)]);
+    assert_eq!(nt.peers[&1].state, StateRole::Leader);
+
+    // Replicate an entry so logs are synchronized.
+    nt.send(vec![new_message(1, 1, MessageType::MsgPropose, 1)]);
+
+    // Apply all committed entries on all nodes.
+    for id in 1..=3 {
+        let committed = nt.peers[&id].raft_log.committed;
+        nt.peers.get_mut(&id).unwrap().commit_apply(committed);
+    }
+
+    // Propose a joint config change: add node 4 + add node 5 (multi-change
+    // triggers joint consensus with auto_leave=true via ConfChangeTransition::Auto).
+    let mut cc = ConfChangeV2::default();
+    cc.set_changes(
+        vec![
+            new_conf_change_single(4, ConfChangeType::AddNode),
+            new_conf_change_single(5, ConfChangeType::AddNode),
+        ]
+        .into(),
+    );
+    let mut e = Entry::default();
+    e.set_entry_type(EntryType::EntryConfChangeV2);
+    e.set_data(cc.write_to_bytes().unwrap().into());
+    let m = new_message_with_entries(1, 1, MessageType::MsgPropose, vec![e]);
+    nt.send(vec![m]);
+
+    // The enter-joint entry should be committed (nodes 1, 2, 3 form quorum).
+    let enter_joint_index = nt.peers[&1].raft_log.committed;
+
+    // Crash the leader BEFORE it applies the enter-joint entry.
+    nt.isolate(1);
+
+    // ---- Part 1: Follower applies enter-joint, auto_leave does NOT trigger ----
+
+    // Node 2 applies the enter-joint entry as a FOLLOWER.
+    let committed_2 = nt.peers[&2].raft_log.committed;
+    let cs_2 = nt.peers
+        .get_mut(&2)
+        .unwrap()
+        .apply_conf_change(&cc)
+        .unwrap();
+
+    // Verify we're in joint consensus with auto_leave.
+    assert!(cs_2.auto_leave, "config should have auto_leave=true");
+    assert!(
+        !cs_2.voters_outgoing.is_empty(),
+        "should be in joint consensus (voters_outgoing non-empty)"
+    );
+
+    // commit_apply on the follower — auto_leave check is skipped (state != Leader).
+    nt.peers.get_mut(&2).unwrap().commit_apply(committed_2);
+
+    // BUG: no leave-joint entry was proposed because the auto_leave check
+    // at raft.rs:991 requires self.state == StateRole::Leader.
+    let last_index_2 = nt.peers[&2].raft_log.last_index();
+    assert_eq!(
+        last_index_2, enter_joint_index,
+        "BUG CONFIRMED: follower's commit_apply skips auto_leave (raft.rs:991 state != Leader). \
+         No leave-joint entry proposed — cluster stuck in joint consensus."
+    );
+
+    // ---- Part 2: Cluster cannot elect a new leader ----
+
+    // Node 3 also applies the conf change.
+    let committed_3 = nt.peers[&3].raft_log.committed;
+    nt.peers
+        .get_mut(&3)
+        .unwrap()
+        .apply_conf_change(&cc)
+        .unwrap();
+    nt.peers.get_mut(&3).unwrap().commit_apply(committed_3);
+
+    // Try to elect node 2 as the new leader.
+    let election_timeout = nt.peers[&2].election_timeout();
+    for _ in 0..2 * election_timeout {
+        nt.peers.get_mut(&2).unwrap().tick();
+    }
+
+    // Exchange vote messages between nodes 2 and 3.
+    let msgs = nt.peers.get_mut(&2).unwrap().read_messages();
+    for m in msgs {
+        if m.to == 3 {
+            let _ = nt.peers.get_mut(&3).unwrap().step(m);
+        }
+    }
+    let msgs = nt.peers.get_mut(&3).unwrap().read_messages();
+    for m in msgs {
+        if m.to == 2 {
+            let _ = nt.peers.get_mut(&2).unwrap().step(m);
+        }
+    }
+
+    // Joint consensus requires quorum from BOTH configs:
+    //   Incoming (new): {1,2,3,4,5} → quorum = 3. Nodes 2,3 = 2 votes. NOT enough.
+    //   Outgoing (old): {1,2,3}     → quorum = 2. Nodes 2,3 = 2 votes. Enough.
+    // Node 2 cannot become leader because it can't get quorum from the new config.
+    assert_ne!(
+        nt.peers[&2].state,
+        StateRole::Leader,
+        "BUG IMPACT: node 2 cannot become leader — joint consensus requires quorum \
+         from {{1,2,3,4,5}} but nodes 1,4,5 are unreachable. Cluster is stuck."
+    );
+
+    // The live cluster (nodes 2, 3) is now completely stuck:
+    // - Old leader (node 1) is isolated/crashed
+    // - No new leader can be elected (joint consensus quorum unreachable)
+    // - Still in joint consensus (auto_leave never triggered on any live node)
+    // - The only recovery is manual intervention to force a config change
+    let any_live_leader = (2..=3).any(|id| nt.peers[&id].state == StateRole::Leader);
+    assert!(
+        !any_live_leader,
+        "BUG CONFIRMED: no live leader — stuck in joint consensus indefinitely. \
+         Auto-leave at raft.rs:987 requires Leader state, but no leader can be elected \
+         because the joint config includes unreachable nodes."
+    );
+}
