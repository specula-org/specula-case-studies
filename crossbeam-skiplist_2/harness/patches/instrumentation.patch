+pub fn emit_iter_drop(
+    start: u64,
+    end: u64,
+    iter_id: u64,
+    head_decremented: bool,
+    tail_decremented: bool,
+    head_refcount: Option<usize>,
+    tail_refcount: Option<usize>,
+) {
