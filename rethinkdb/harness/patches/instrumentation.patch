+/* 3-node cluster for TLA+ trace validation. Smaller state space. */
+TPTEST(ClusteringRaft, TraceBasic3) {
+    dummy_raft_cluster_t cluster(3, dummy_raft_state_t(), nullptr);
+    do_writes_raft(&cluster, 10, 60000);
+}
+
+/* 3-node cluster with failover for TLA+ trace validation. */
+TPTEST(ClusteringRaft, TraceFailover3) {
+    std::vector<raft_member_id_t> member_ids;
+    dummy_raft_cluster_t cluster(3, dummy_raft_state_t(), &member_ids);
+    do_writes_raft(&cluster, 5, 60000);
+    /* Kill the leader (or first member) */
+    cluster.set_live(member_ids[0], dummy_raft_cluster_t::live_t::dead);
+    do_writes_raft(&cluster, 5, 60000);
+    /* Bring it back */
+    cluster.set_live(member_ids[0], dummy_raft_cluster_t::live_t::alive);
+    do_writes_raft(&cluster, 5, 60000);
+}
+
 }   /* namespace unittest */
 
