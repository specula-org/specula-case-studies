+    TEST_F(WarmrebootBugTest, Bug4_RealTimerRaceCausesDeletion)
+    {
+        const int entry_count = 5;
+        Table testTable(m_app_db.get(), APP_BUG_TEST_TABLE);
+
+        for (int i = 0; i < entry_count; i++)
+        {
+            string key = "race_entry_" + to_string(i);
+            testTable.set(key, {{"data", "race_val_" + to_string(i)}});
+        }
+
+        assist->readTablesToMap();
+        auto& cacheMap = assist->appTableCacheMap[APP_BUG_TEST_TABLE];
+        ASSERT_EQ(cacheMap.size(), static_cast<size_t>(entry_count));
+
+        for (int i = 0; i < entry_count; i++)
+        {
+            string key = "race_entry_" + to_string(i);
+            ASSERT_EQ(assist->getCacheEntryState(cacheMap[key]),
+                      AppRestartAssist::STALE);
+        }
+
+        assist->m_warmStartTimer.setInterval(timespec{0, 200 * 1000 * 1000});
+
+        Select s;
+        assist->startReconcileTimer(s);
+
+        atomic<int> replayed{0};
+        thread late_replay([&]() {
+            this_thread::sleep_for(chrono::milliseconds(500));
+
+            for (int i = 0; i < entry_count; i++)
+            {
+                string key = "race_entry_" + to_string(i);
+                assist->insertToMap(APP_BUG_TEST_TABLE, key,
+                                    {{"data", "race_val_" + to_string(i)}},
+                                    false);
+                replayed++;
+            }
+        });
+
+        struct ThreadJoiner
+        {
+            thread& t;
+            ~ThreadJoiner()
+            {
+                if (t.joinable())
+                {
+                    t.join();
+                }
+            }
+        } join_late_replay{late_replay};
+
+        Selectable* sel = nullptr;
+        int rc = s.select(&sel, 1000);
+        ASSERT_EQ(rc, Select::OBJECT);
+        ASSERT_TRUE(assist->checkReconcileTimer(sel));
+        assist->stopReconcileTimer(s);
+
+        const int replayed_when_reconcile_fired = replayed.load();
+        assist->reconcile();
+
+        late_replay.join();
+        m_app_db_pipeline->flush();
+
+        for (int i = 0; i < entry_count; i++)
+        {
+            string key = "race_entry_" + to_string(i);
+            vector<FieldValueTuple> fv;
+            EXPECT_FALSE(testTable.get(key, fv))
+                << "Timer-driven reconcile should have deleted " << key
+                << " from AppDB before late replay arrived; replayed.load() "
+                << "when reconcile fired = " << replayed_when_reconcile_fired
+                << " of " << entry_count;
+        }
+
+        EXPECT_LT(replayed_when_reconcile_fired, entry_count)
+            << "Race did not materialize: replayed.load() when reconcile "
+            << "fired = " << replayed_when_reconcile_fired
+            << " of " << entry_count << ", replayed.load() after join = "
+            << replayed.load();
+    }
