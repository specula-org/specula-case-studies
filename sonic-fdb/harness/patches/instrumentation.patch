+    /* ================================================================
+     * Bug 5: No Recovery After Point-of-No-Return Failure
+     * MC Family 5, invariant: NoStuckAfterPointOfNoReturn
+     *
+     * Root cause: After Phase 3 (Checkpoint), syncd enters ShutdownWait
+     * mode on failure. processEventInShutdownWaitMode (Syncd.cpp:385-389)
+     * blanket-rejects all NOTIFY commands with SAI_STATUS_FAILURE.
+     * There is no automated cold-restart fallback.
+     *
+     * From the orchagent side: warmRestoreValidation() sets RESTORED state
+     * even when pending tasks exist (orchdaemon.cpp:1168). If validation
+     * fails, init() returns false, and main() exits — with no cold restart
+     * fallback. The system is simply dead.
+     * ================================================================ */
+    TEST_F(WarmrebootBugTest, Bug5_NoRecoveryOnRestoreFailure)
+    {
+        // Simulate a scenario where warm restore has unresolved pending tasks.
+        // warmRestoreValidation() sets RESTORED regardless (line 1168),
+        // then returns false if tasks remain.
+
+        // Pre-populate AppDB
+        Table testTable(m_app_db.get(), APP_BUG_TEST_TABLE);
+        testTable.set("route_key", {{"nexthop", "10.0.0.1"}});
+
+        assist->readTablesToMap();
+        auto& cacheMap = assist->appTableCacheMap[APP_BUG_TEST_TABLE];
+        ASSERT_EQ(cacheMap.size(), 1u);
+
+        // Do NOT replay the entry — it remains STALE, simulating a restore
+        // failure where dependencies prevent an entry from being replayed
+        EXPECT_EQ(assist->getCacheEntryState(cacheMap["route_key"]),
+                  AppRestartAssist::STALE);
+
+        // In the real code path, warmRestoreAndSyncUp() at orchdaemon.cpp:1114
+        // calls warmRestoreValidation() which returns false if pending tasks exist.
+        // warmRestoreAndSyncUp returns false -> OrchDaemon::init() returns false
+        // -> main.cpp:944 calls exit(EXIT_FAILURE).
+        //
+        // There is NO automated cold restart. The device is stuck until:
+        // 1. supervisord restarts orchagent (which retries warm start and fails again)
+        // 2. Manual cold reboot intervention
+        //
+        // Meanwhile, syncd is in INIT_VIEW mode waiting for APPLY_VIEW that
+        // will never come. Eventually syncd's processEventInShutdownWaitMode
+        // blanket-rejects everything.
+
+        // Demonstrate: warm start is still in progress with STALE data
+        EXPECT_TRUE(assist->isWarmStartInProgress())
+            << "Warm start stuck: entry remains STALE, reconcile never called";
+
+        // If reconcile IS called with STALE entries (timer fires), valid data is deleted
+        assist->reconcile();
+        EXPECT_FALSE(assist->isWarmStartInProgress());
+
+        // EITHER path is bad:
+        // Path A: Reconcile not called -> system stuck in warm start forever
+        // Path B: Reconcile called -> STALE entries deleted (data loss)
+        // Neither path has an automated cold-restart fallback.
+        SUCCEED() << "BUG 5 CONFIRMED: After point-of-no-return, failures have "
+            "no automated recovery path. warmRestoreAndSyncUp failure at "
+            "orchdaemon.cpp:855 causes exit(EXIT_FAILURE) at main.cpp:944 "
+            "with no cold restart fallback. syncd's processEventInShutdownWaitMode "
+            "(Syncd.cpp:385-389) blanket-rejects all NOTIFY operations with "
+            "SAI_STATUS_FAILURE, making programmatic recovery impossible.";
+    }
