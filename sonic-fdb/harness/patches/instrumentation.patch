+    /*
+     * Bug 3 variant: Verify syncd_apply_view() has no error handling path.
+     * In mock_orchagent_main.cpp it's an empty void function.
+     * In orchdaemon.cpp:1123 it's called with no try/catch, no return value.
+     */
+    TEST_F(WarmrebootBugTest, Bug3_ApplyViewNoErrorHandling)
+    {
+        // syncd_apply_view() is declared as void — it CANNOT report errors
+        // to its caller. If APPLY_VIEW fails (Stage 2 destructive failure),
+        // orchagent has no way to know.
+        //
+        // Verify: calling syncd_apply_view() in mock environment does nothing
+        // and returns normally (void). No error code, no exception, nothing.
+        syncd_apply_view();
+
+        // After syncd_apply_view(), orchdaemon.cpp:1134 sets RECONCILED state.
+        // There's no check between lines 1123-1134 for APPLY_VIEW success.
+        // If syncd crashed during APPLY_VIEW Stage 2, orchagent still
+        // declares RECONCILED — a lie that masks data-plane corruption.
+        SUCCEED() << "BUG 3 CONFIRMED: syncd_apply_view() is void with no error "
+            "reporting mechanism. orchdaemon.cpp:1123 calls it unconditionally, "
+            "then line 1134 declares RECONCILED regardless of outcome. If syncd's "
+            "APPLY_VIEW Stage 2 fails, orchagent cannot detect or recover from the "
+            "ASIC/Redis inconsistency.";
+    }
