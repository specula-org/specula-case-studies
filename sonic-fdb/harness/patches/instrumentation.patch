+    /* ================================================================
+     * Bug 3: APPLY_VIEW Non-Atomic ASIC/Redis Update
+     * MC Family 3, invariant: AsicRedisConsistency
+     *
+     * Root cause: Syncd.cpp:4904 calls executeOperationsOnAsic() and
+     * Syncd.cpp:4909 calls updateRedisDatabase() as two separate operations.
+     * A crash between them leaves ASIC in new state but Redis in old state.
+     * The next warm boot reads stale Redis state for comparison.
+     *
+     * Since Syncd isn't linked into mock_tests, we demonstrate the bug
+     * pattern using the mock DB infrastructure: show that two-step updates
+     * to separate state stores are non-atomic and can diverge.
+     *
+     * Additionally: syncd_apply_view() in mock_orchagent_main.cpp is void
+     * with no error handling. orchdaemon.cpp:1123 calls it with no try/catch
+     * and no return value check. Any failure in APPLY_VIEW is undetectable
+     * by orchagent.
+     * ================================================================ */
+    TEST_F(WarmrebootBugTest, Bug3_NonAtomicAsicRedisUpdate)
+    {
+        // Simulate pre-reboot state in two separate "stores"
+        // (representing ASIC_DB and Redis state that syncd manages)
+        Table asicState(m_app_db.get(), "SIMULATED_ASIC_STATE");
+        Table redisState(m_app_db.get(), "SIMULATED_REDIS_STATE");
+
+        // Pre-reboot: both stores are consistent
+        asicState.set("route_1", {{"nexthop", "10.0.0.1"}, {"ifname", "Ethernet0"}});
+        redisState.set("route_1", {{"nexthop", "10.0.0.1"}, {"ifname", "Ethernet0"}});
+
+        // Verify initial consistency
+        vector<FieldValueTuple> asic_fv, redis_fv;
+        asicState.get("route_1", asic_fv);
+        redisState.get("route_1", redis_fv);
+        ASSERT_EQ(asic_fv.size(), redis_fv.size());
+
+        // === Simulate APPLY_VIEW Stage 2 ===
+        // Step 1: executeOperationsOnAsic() succeeds — ASIC gets new state
+        asicState.set("route_1", {{"nexthop", "10.0.0.2"}, {"ifname", "Ethernet4"}});
+
+        // Step 2: <<< CRASH HERE >>> — updateRedisDatabase() never runs
+        // (simulates power loss, kill -9, or exception between lines 4906 and 4909)
+        // redisState.set(...) is NOT called
+
+        // === Next warm boot: state divergence ===
+        vector<FieldValueTuple> asic_after, redis_after;
+        asicState.get("route_1", asic_after);
+        redisState.get("route_1", redis_after);
+
+        // ASIC has the new nexthop
+        string asic_nexthop, redis_nexthop;
+        for (auto& fv : asic_after)
+            if (fvField(fv) == "nexthop") asic_nexthop = fvValue(fv);
+        for (auto& fv : redis_after)
+            if (fvField(fv) == "nexthop") redis_nexthop = fvValue(fv);
+
+        EXPECT_NE(asic_nexthop, redis_nexthop)
+            << "BUG 3 CONFIRMED: After simulated crash between "
+               "executeOperationsOnAsic() (Syncd.cpp:4906) and "
+               "updateRedisDatabase() (Syncd.cpp:4909), ASIC state "
+               "(nexthop=" << asic_nexthop << ") diverges from Redis state "
+               "(nexthop=" << redis_nexthop << "). The next warm boot will "
+               "use stale Redis state for comparison, producing incorrect diffs. "
+               "Code comments at Syncd.cpp:4797-4799 acknowledge this: "
+               "'ASIC will be in inconsistent state'.";
+
+        EXPECT_EQ(asic_nexthop, "10.0.0.2");
+        EXPECT_EQ(redis_nexthop, "10.0.0.1");
+    }
