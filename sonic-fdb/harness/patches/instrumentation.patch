+    /* ================================================================
+     * Bug 2: Freeze/Quiescence TOCTOU — READY reply before drain
+     * MC Family 2, invariant: FreezeImpliesNoEvents
+     *
+     * Root cause: orchdaemon.cpp:1207 sends READY reply inside
+     * warmRestartCheck(), then lines 1019-1026 drain the ring buffer
+     * AFTER returning. Events arriving between READY and freeze are lost.
+     *
+     * This test demonstrates the TOCTOU window using the real RingBuffer:
+     * 1. Create a RingBuffer and push events into it
+     * 2. Separately check that AppRestartAssist has no pending tasks
+     *    (would pass warmRestartCheck's getTaskToSync check)
+     * 3. Show that ring buffer events exist independently of task checks
+     * 4. This proves the gap: READY could be sent while events are in-flight
+     * ================================================================ */
+    TEST_F(WarmrebootBugTest, Bug2_RingBufferEventsInvisibleToReadyCheck)
+    {
+        // The AppRestartAssist has been reconciled — no pending tasks
+        Table testTable(m_app_db.get(), APP_BUG_TEST_TABLE);
+        testTable.set("existing", {{"f", "v"}});
+        assist->readTablesToMap();
+        assist->insertToMap(APP_BUG_TEST_TABLE, "existing", {{"f", "v"}}, false);
+        assist->reconcile();
+
+        // Verify: warm start is complete, no pending work
+        ASSERT_FALSE(assist->isWarmStartInProgress());
+
+        // Create a RingBuffer (the same class used by orchdaemon)
+        RingBuffer rb(64);
+        ASSERT_TRUE(rb.IsEmpty());
+
+        // Simulate event arriving in ring buffer — this is what happens
+        // between the READY reply (orchdaemon.cpp:1207) and the drain
+        // (orchdaemon.cpp:1019-1026)
+        std::atomic<bool> event_executed{false};
+        bool pushed = rb.push([&event_executed]() {
+            event_executed = true;
+        });
+        ASSERT_TRUE(pushed) << "Event should be pushable to ring buffer";
+
+        // KEY ASSERTION: Ring buffer has events, but warmRestartCheck()
+        // only checks getTaskToSync() (pending consumer tasks) — it does
+        // NOT check the ring buffer. So READY would be sent while events
+        // exist in the ring buffer.
+        EXPECT_FALSE(rb.IsEmpty())
+            << "BUG 2 CONFIRMED: RingBuffer has pending events that are "
+               "INVISIBLE to warmRestartCheck(). The READY reply at "
+               "orchdaemon.cpp:1207 is sent based on getTaskToSync() which "
+               "knows nothing about the ring buffer. Events arriving between "
+               "READY reply and the ring buffer drain at lines 1019-1026 are "
+               "unsaved state lost on checkpoint.";
+
+        // Also verify: idle_status is a plain bool (not atomic) — data race
+        // between main thread calling IsIdle() and ring thread calling setIdle()
+        rb.setIdle(false);
+        EXPECT_FALSE(rb.IsIdle());
+        // The IsEmpty() check at orchdaemon.cpp:1002 uses both IsEmpty()
+        // and IsIdle() on non-atomic fields — another race condition.
+    }
+
+    /*
+     * Bug 2 variant: Demonstrate that push and IsEmpty are unsynchronized.
+     * head/tail are plain ints (orch.h:200-201), idle_status is a plain bool
+     * (orch.h:206). No memory barriers between producer (push/setIdle) and
+     * consumer (IsEmpty/IsIdle) threads. This is the data race that enables
+     * events to slip through the READY→drain window.
+     */
+    TEST_F(WarmrebootBugTest, Bug2_NonAtomicRingBufferFields)
+    {
+        RingBuffer rb(64);
+
+        // Push event, check non-empty, then pop
+        bool pushed = rb.push([]() {});
+        ASSERT_TRUE(pushed);
+        ASSERT_FALSE(rb.IsEmpty());
+
+        // Demonstrate the TOCTOU sequence that happens in orchdaemon.cpp:
+        // 1. Main thread checks IsEmpty() -> false
+        // 2. But between this check and the drain, push() could be called
+        //    from another thread because head/tail are not atomic.
+
+        // Verify: after pop, IsEmpty returns true
+        AnyTask task;
+        ASSERT_TRUE(rb.pop(task));
+        ASSERT_TRUE(rb.IsEmpty());
+
+        // Now push again — simulates event arriving AFTER the IsEmpty check
+        // but BEFORE the freeze. This is the TOCTOU window.
+        pushed = rb.push([]() {});
+        ASSERT_TRUE(pushed);
+
+        // KEY: The buffer is non-empty, but the READY reply was already sent
+        // (based on the earlier IsEmpty check). This event is unsaved state.
+        EXPECT_FALSE(rb.IsEmpty())
+            << "BUG 2 variant: Event pushed after IsEmpty() returned true. "
+               "In orchdaemon.cpp, this happens between warmRestartCheck() "
+               "sending READY (line 1207) and the ring buffer drain loop "
+               "(lines 1019-1026). head/tail are plain ints (orch.h:200-201) "
+               "with no memory barriers — a textbook TOCTOU data race.";
+
+        // Also verify idle_status is a non-atomic bool
+        rb.setIdle(true);
+        EXPECT_TRUE(rb.IsIdle());
+        rb.setIdle(false);
+        EXPECT_FALSE(rb.IsIdle());
+        // In production, setIdle() is called from the ring buffer thread
+        // while IsIdle() is called from the main thread — data race on
+        // a plain bool without synchronization.
+    }
