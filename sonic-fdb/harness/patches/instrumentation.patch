+        Table depTable(m_app_db.get(), "DEP_TABLE");
+        prereqTable.set("tunnel1", {{"vni", "10001"}});
+        depTable.set("fdb_entry1", {{"port", "Ethernet0"}, {"vlan", "100"}});
+
+        // Both read their tables
+        prereqAssist->readTablesToMap();
+        depAssist->readTablesToMap();
+
