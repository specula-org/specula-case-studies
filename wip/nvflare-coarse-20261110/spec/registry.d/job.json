{
 "groups": {
  "JobSP": {
   "process": "SP",
   "port": "pJobSP",
   "kinds": [
    "CHECK_RESOURCES",
    "CANCEL_RESOURCES",
    "DEPLOY_JOB",
    "START_JOB",
    "ABORT_JOB",
    "HEARTBEAT_STOP"
   ],
   "variants": {
    "C": {
     "module": "JobSP_C",
     "vars": [
      "jobSP_c"
     ]
    }
   },
   "guard": "~SPDown",
   "guard_except": [
    "ShutRestart"
   ]
  },
  "JobCP": {
   "process": "CP",
   "port": "pJobCP",
   "kinds": [
    "RESOURCES_OK",
    "CANCEL_ACK",
    "DEPLOY_REPLY",
    "START_REPLY",
    "OUTCOME",
    "HEARTBEAT"
   ],
   "variants": {
    "C": {
     "module": "JobCP_C",
     "vars": [
      "jobCP_c"
     ]
    }
   }
  },
  "RunCJ": {
   "process": "CJ",
   "port": "pRunCJ",
   "kinds": [
    "STARTED",
    "READY",
    "STOPPED"
   ],
   "variants": {
    "C": {
     "module": "RunCJ_C",
     "vars": [
      "runCJ_c"
     ]
    }
   }
  }
 }
}
