Proj_PaySrc == <<pPaySrc, SentKinds({"PAYLOAD_REPLY"})>>
Proj_PayRcv == <<pPayRcv, SentKinds({"PAYLOAD_PULL", "RECEIVER_CONFIRM", "RECEIVER_CANCEL"})>>
Proj_CommSJ == <<pCommSJ, SentKinds({"TASK_ASSIGNMENT", "TASK_CHECK_REPLY", "RESULT_RECEIPT"})>>
Proj_WfSJ == <<pWfSJ, SentKinds({"END_RUN", "SWARM_END_WF"})>>
