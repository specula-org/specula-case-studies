---------------------------- MODULE MixR ----------------------------
\* GENERATED by scripts/rarity.py from Mix.tla + rarity.json: the mix with a
\* bounded rare-event budget and price dedup. Do not edit.
EXTENDS Mix, JobPhase
CONSTANT RareBudget, FaultPhases
VARIABLE rare, paid
\* a sweep cell's fault occurs first in its lifecycle phase window (JobPhase in
\* FaultPhases); its consequences, and later occurrences, are unrestricted
InWindow == JobPhase \in FaultPhases
MaxFaultPhase == CHOOSE p \in FaultPhases : \A q \in FaultPhases : q <= p
\* no fault yet and the window has passed: nothing of this cell can happen any more
WindowCon == paid /= {} \/ JobPhase <= MaxFaultPhase
PricedFaults == {"abort", "abortCmdError", "acceptRaise", "admissionError", "archiveError", "busyReplace", "cancel", "cbFail", "cjCrash", "cpCrash", "ctrlLoss", "deadClient", "deleteJob", "deployError", "gatherRace", "gatherTimeout", "jobExitRace", "launchError", "learnFail", "minClients", "monitorStale", "netLoss", "netLossCommSJ", "netLossJobCP", "netLossJobSP", "netLossPayRcv", "netLossPaySrc", "netLossRunCJ", "netLossSwarm", "netLossTaskCJ", "netLossWfSJ", "outcomeReportFail", "outcomeTimeout", "payCallback", "payCompute", "payConsumer", "payDelete", "payProduce", "paySubmit", "podDeleteFail", "prepFail", "pullTimeout", "regIterRace", "resExpiry", "resultWaitTimeout", "rpcTimeout", "saveFail", "settleTimeout", "sjCrash", "sjSyncFail", "slowAdminStop", "slowEnvelope", "slowFinalize", "slowPublish", "slowSJTeardown", "slowShutdownAbort", "sourceFailure", "spCrash", "spShutdown", "startOverlap", "statusLost", "storeError", "submitTimeout", "swarmMsgFail", "taskDataFail", "taskDeadline", "taskStageFail", "taskTimeout", "tpAttachLate", "tpCrash", "tpReplyLost", "tpSilent", "trainerError", "transportFail", "txTimeout", "workerCrash", "workerFail"}
NormalFaults == Faults \ PricedFaults
CommSJ_C__N == INSTANCE CommSJ_C WITH Faults <- NormalFaults
JobCP_C__N == INSTANCE JobCP_C WITH Faults <- NormalFaults
JobSP_C__N == INSTANCE JobSP_C WITH Faults <- NormalFaults
Model_C__N == INSTANCE Model_C WITH Faults <- NormalFaults
Net_L__N == INSTANCE Net_L WITH Faults <- NormalFaults
PayRcv_C__N == INSTANCE PayRcv_C WITH Faults <- NormalFaults
PaySrc_C__N == INSTANCE PaySrc_C WITH Faults <- NormalFaults
Reg_C__N == INSTANCE Reg_C WITH Faults <- NormalFaults
RunCJ_C__N == INSTANCE RunCJ_C WITH Faults <- NormalFaults
Swarm_C__N == INSTANCE Swarm_C WITH Faults <- NormalFaults
TaskCJ_C__N == INSTANCE TaskCJ_C WITH Faults <- NormalFaults
Trainer_A__N == INSTANCE Trainer_A WITH Faults <- NormalFaults
WfSJ_C__N == INSTANCE WfSJ_C WITH Faults <- NormalFaults
Worker_C__N == INSTANCE Worker_C WITH Faults <- NormalFaults
RStep_JobSP_C_SendCheck == (/\ Grain["JobSP"] = "C" /\ ~SPDown /\ JobSP_C!SendCheck /\ UNCHANGED <<pJobCP, pRunCJ, pTaskCJ, pPaySrc, pPayRcv, pCommSJ, pWfSJ, pTrainer, pReg, pWorker, pModel, pSwarm, jobCP_c, runCJ_c, taskCJ_c, trainer_c, trainer_x, trainer_a, paySrc_c, payRcv_c, commSJ_c, wfSJ_c, reg_c, worker_c, model_c, swarm_c, net_l>> /\ Assert(NetOK("JobSP"), "net discipline: Step_JobSP_C_SendCheck") /\ rare' = rare /\ paid' = paid)
