\* private/fed/client/scheduler_cmds.py:117-121; app_common/resource_managers/auto_clean_resource_manager.py:153-164
StartJobProcessorAllocate(s, k) ==
    LET t == T0 IN
    /\ ResourceManagerUnlocked(s)
    /\ Fresh1(s, k, "START_JOB")
    /\ rm[s].reserved[t] # <<>>
    /\ jobCP_f' = [jobCP_f EXCEPT !.rm = [rm EXCEPT ![s].allocated[t] = rm[s].reserved[t], ![s].payload[t] = rm[s].reserved[t], ![s].reserved[t] = <<>>, ![s].ttl[t] = 0],
              !.client = [client EXCEPT ![s][t].pc = "allocated"],
              !.handled = Take(s, k)]
    /\ pJobCP' = [pJobCP EXCEPT ![s].allocated = TRUE]
    /\ UNCHANGED <<net>>

