    /\ rm[s].reserved[t] = <<>>
    /\ jobCP_f' = [jobCP_f EXCEPT !.client = [client EXCEPT ![s][t].pc = "error"],
              !.handled = Take(s, k),
              !.startReply[s] = "no"]
    /\ net' = Send(net, Reply("START_REPLY", s, "no"))
