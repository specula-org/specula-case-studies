    /\ client[s][t].pc = "snapshotted"
    /\ jobCP_f' = [jobCP_f EXCEPT !.client = [client EXCEPT ![s][t].spawned = TRUE, ![s][t].pc = "spawned"]]
    /\ pJobCP' = [pJobCP EXCEPT ![s].launch = client[s][t].generation]
    /\ UNCHANGED <<net>>

