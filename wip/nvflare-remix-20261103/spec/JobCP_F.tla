StartJobProcessorRollback(s) ==
    LET t == T0 IN
    /\ ResourceManagerUnlocked(s)
    /\ client[s][t].pc = "rollback"
    /\ rm[s].payload[t] # <<>>
    /\ jobCP_f' = [jobCP_f EXCEPT !.rm = [rm EXCEPT ![s].free = Reverse(rm[s].payload[t]) \o @, ![s].allocated[t] = <<>>, ![s].releases[t] = @+1],
              !.client = [client EXCEPT ![s][t].pc = "error"],
              !.startReply[s] = "no"]
    /\ net' = Send(net, Reply("START_REPLY", s, "no"))
    /\ pJobCP' = [pJobCP EXCEPT ![s].allocated = FALSE, ![s].freed = @ + 1]

\* private/fed/client/client_engine.py:382-382; private/fed/client/scheduler_cmds.py:138-140
\* The START handler thread replies once start_app returned (the waiter thread
\* is started); a restart the waiter thread begins in the meantime owns pc but
\* does not stop the handler's reply (replyDue; v5 fix: a restart claim before
\* the reply used to overwrite pc and the reply was never sent, so the server
\* waited for it forever -- hunt5 smoke deadlock).
StartJobProcessorReplySuccess(s) ==
    LET t == T0 IN
    /\ client[s][t].replyDue
    /\ jobCP_f' = [jobCP_f EXCEPT !.client = [client EXCEPT ![s][t].pc = IF @ = "replyReady" THEN "returned" ELSE @,
                                                          ![s][t].replyDue = FALSE],
              !.startReply[s] = "ok"]
    /\ net' = Send(net, Reply("START_REPLY", s, "ok"))
    /\ UNCHANGED <<pJobCP>>

\* private/fed/client/client_executor.py:430-444; private/fed/client/training_cmds.py:222-226  [X11: CJ STARTED notification with launch id g]
JobExecutorNotifyStarted(s, k) ==
    LET t == T0
        g == M(k).body IN
    /\ Fresh1(s, k, "STARTED")
    /\ client[s][t].handle # "none"
