    /\ client[s][t].logical="STARTING"
    /\ client[s][t].handle # "none"
    /\ ~client[s][t].terminateRequested
    /\ ~client[s][t].pendingAbort
    /\ jobCP_f' = [jobCP_f EXCEPT !.client = [client EXCEPT ![s][t].pendingAbort = client[s][t].handle="pending", ![s][t].terminateRequested = client[s][t].handle="attached"]]
