    /\ ~RegisteredAtSite(s,t[1])
    /\ jobCP_f' = [jobCP_f EXCEPT !.client = [client EXCEPT ![s][t].pc = "registered", ![s][t].handle = "pending", ![s][t].logical = "STARTING", ![s][t].generation = 1],
              !.hb[s] = 2]
    /\ net' = Send(net, HB(s, 2))
