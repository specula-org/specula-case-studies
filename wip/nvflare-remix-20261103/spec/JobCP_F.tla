\* private/fed/client/client_executor.py:765-768  [X10: rc from the CJ exit cause]
JobExecutorObserveExitCode(s, rc) ==
    LET t == T0 IN
    /\ ~ChildAlive(s,t)
    /\ client[s][t].cleanup="wait"
    /\ client[s][t].generation > 0
    /\ rc \in RcFor(CJExitCode(s, client[s][t].generation))
    /\ jobCP_f' = [jobCP_f EXCEPT !.client = [client EXCEPT ![s][t].rawExit = rc, ![s][t].exitCode = IF rc="generic" THEN "ok" ELSE rc, ![s][t].retryable = rc \in {"generic","failed"}, ![s][t].cleanup = "restartDecision"]]
    /\ pJobCP' = [pJobCP EXCEPT ![s].exitSeen[client[s][t].generation] = CJExitCode(s, client[s][t].generation)]
    /\ UNCHANGED <<net>>

\* private/fed/client/client_executor.py:722-733; app_common/job_launcher/process_launcher.py:80-118
ProcessHandleCheckRestart(s, safe) ==
    LET t == T0 IN
    /\ client[s][t].cleanup="restartDecision"
    /\ client[s][t].retryable
    /\ LeafSite
    /\ MaxRestartFailures>0
    /\ ~client[s][t].restartChecked
    /\ jobCP_f' = [jobCP_f EXCEPT !.client = [client EXCEPT ![s][t].restartSafe = safe, ![s][t].restartChecked = TRUE]]
    /\ UNCHANGED <<net, pJobCP>>

\* private/fed/client/client_executor.py:734-753
JobExecutorRestartClaim(s) ==
    LET t == T0 IN
    /\ client[s][t].cleanup="restartDecision"
    /\ RestartEligible(s,t)
    /\ client[s][t].generation < LaunchSlots
    /\ jobCP_f' = [jobCP_f EXCEPT !.client = [client EXCEPT ![s][t].generation = @+1, ![s][t].restartAttempts = @+1, ![s][t].ready = FALSE, ![s][t].handle = "pending", ![s][t].logical = "STARTING", ![s][t].attached = FALSE, ![s][t].pendingAbort = FALSE, ![s][t].terminateRequested = FALSE, ![s][t].exitObserved = FALSE, ![s][t].pc = "registered", ![s][t].cleanup = "relaunch"]]
    /\ UNCHANGED <<net, pJobCP>>

\* private/fed/client/client_executor.py:754-761; private/fed/client/client_executor.py:777
JobExecutorRestartContinue(s) ==
    LET t == T0 IN
    /\ client[s][t].pc="afterEvent"
    /\ client[s][t].cleanup="relaunch"
    /\ jobCP_f' = [jobCP_f EXCEPT !.client = [client EXCEPT ![s][t].pc = "returned", ![s][t].cleanup = "wait", ![s][t].exitCode = "ok", ![s][t].rawExit = "ok", ![s][t].retryable = FALSE, ![s][t].restartSafe = FALSE, ![s][t].restartChecked = FALSE]]
    /\ UNCHANGED <<net, pJobCP>>

\* private/fed/client/client_executor.py:771-776
JobExecutorRestartException(s) ==
    LET t == T0 IN
    /\ "launchError" \in Faults
    /\ client[s][t].cleanup="relaunch"
    /\ client[s][t].pc \in {"registered","snapshotted"}
    /\ jobCP_f' = [jobCP_f EXCEPT !.client = [client EXCEPT ![s][t].cleanup = "report", ![s][t].exitCode = "failed", ![s][t].exitObserved = TRUE],
              !.restartFailed[s] = TRUE]
    /\ UNCHANGED <<net, pJobCP>>

\* ---- CP process crash and restart (fault cpCrash, round 6). The new CP has
\* no run_processes, reservations, allocations or env; its CJs die with it
\* (Ports CJAlive, monitor_parent_process); its heartbeat no longer lists the
\* job (HEARTBEAT phase 3). Handled message keys stay handled.
CPCrashRestart(s) ==
    /\ "cpCrash" \in Faults /\ ~pJobCP[s].cpRestarted
    /\ \E k \in jobCP_f.handled[s] : k[1] = "START_JOB"
    /\ jobCP_f' = [jobCP_f EXCEPT !.client[s] = [u \in Tokens |-> EmptyClient],
                     !.rm[s] = InitValue.rm[s], !.resourceEnv[s] = <<>>,
                     !.startReply[s] = "none", !.restartFailed[s] = FALSE, !.hb[s] = 3]
    /\ pJobCP' = [pJobCP EXCEPT ![s].cpRestarted = TRUE, ![s].allocated = FALSE]
    /\ net' = Send(net, HB(s, 3))

Next ==
    \/ \E s \in Sites, k \in DOMAIN net :
        CheckResourceProcessorReserve(s, k)
        \/ CheckResourceProcessorUnavailable(s, k)
        \/ CancelResourceProcessorCancel(s, k)
        \/ ClientDeploySuccess(s, k)
        \/ ClientDeployError(s, k)
        \/ StartJobProcessorAllocate(s, k)
        \/ StartJobProcessorRejectToken(s, k)
        \/ JobExecutorNotifyStarted(s, k)
        \/ JobExecutorNotifyStopped(s, k)
        \/ ClientEngineAbortApp(s, k)
        \/ ClientEngineHeartbeatAbort(s, k)
        \/ JobExecutorNotifyReady(s, k)
        \/ JobExecutorIgnoreStaleStatus(s, k)
        \/ JobExecutorIgnoreStoppedStatus(s, k)
    \/ \E s \in Sites :
        AutoCleanResourceManagerTick(s)
        \/ AutoCleanResourceManagerFinishExpiry(s)
        \/ ListResourceConsumerConsume(s)
        \/ ClientEngineStartAppCheck(s)
        \/ ClientEngineStartAppReturnedError(s)
        \/ JobExecutorRegisterPendingHandle(s)
        \/ JobExecutorPrepareException(s)
        \/ ProcessJobLauncherSnapshotEnvironment(s)
        \/ OtherJobConsume(s)
        \/ ProcessJobLauncherSpawn(s)
        \/ ProcessJobLauncherSpawnException(s)
        \/ PendingJobHandleAttach(s)
        \/ JobExecutorApplyPendingAbort(s)
        \/ JobExecutorAfterJobLaunchEvent(s)
        \/ JobExecutorInstallCleanupWaiter(s)
        \/ JobExecutorWaiterInstallationException(s)
        \/ StartJobProcessorRollback(s)
        \/ StartJobProcessorReplySuccess(s)
        \/ JobExecutorWaitChildExit(s)
        \/ JobExecutorReportOutcome(s)
        \/ JobExecutorOutcomeReportReturned(s)
        \/ JobExecutorOutcomeReportException(s)
        \/ JobExecutorFreeAfterExit(s)
        \/ JobExecutorRemoveProcess(s)
        \/ JobExecutorJobCompletedEvent(s)
        \/ JobExecutorTerminateAfterGrace(s)
        \/ JobExecutorAbortStarting(s)
        \/ JobExecutorRestartClaim(s)
        \/ JobExecutorRestartContinue(s)
        \/ JobExecutorRestartException(s)
        \/ CPCrashRestart(s)
    \/ \E s \in Sites, rc \in {"ok", "generic", "failed", "aborted"} :
        JobExecutorObserveExitCode(s, rc)
    \/ \E s \in Sites, safe \in BOOLEAN :
        ProcessHandleCheckRestart(s, safe)
