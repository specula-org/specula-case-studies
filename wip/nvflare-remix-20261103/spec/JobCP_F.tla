    /\ client[s][t].abortRequested
    /\ client[s][t].handle = "attached"
    /\ ~client[s][t].terminateRequested
    /\ jobCP_f' = [jobCP_f EXCEPT !.client = [client EXCEPT ![s][t].terminateRequested = TRUE]]
    /\ pJobCP' = Kill(s,t)
    /\ UNCHANGED <<net>>

