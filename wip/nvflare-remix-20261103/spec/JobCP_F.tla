------------------------------ MODULE JobCP_F ------------------------------
\* Group JobCP, FINE variant. Process: CP(c). GENERATED by scripts/job_gen.py
\* from the job seed (inputs/seeds/job/spec/actions.json, seed group JOB_CP,
\* 45 actions; ClientChildExit moved to RunCJ). Seed variables rm, client,
\* resourceEnv are fields of jobCP_f and re-exposed as operators, so guards and
\* updates are the seed text. Cross-process re-encodings (hand overrides):
\*   seed network Check/Cancel/Deploy/Start/Stop/HeartbeatStop -> consume
\*     CHECK_RESOURCES/CANCEL_RESOURCES/DEPLOY_JOB/START_JOB/ABORT_JOB/
\*     HEARTBEAT_STOP (handled-key set); replies -> RESOURCES_OK/CANCEL_ACK/
\*     DEPLOY_REPLY/START_REPLY/OUTCOME with body;
\*   client.alive -> ChildAlive (Ports CJAlive of the current generation);
\*     spawn publishes pJobCP.launch (joint spawn); terminate kills
\*     (pJobCP.killed), seed terminate had no physical effect;
\*   X10 rc chosen by observer -> rc constrained by CJExitCode (RcFor);
\*   X11 spontaneous CJ status -> STARTED/READY/STOPPED messages with launch id;
\*   X4 outcome-reply absence test -> report returns (reply or timeout);
\*   X1/X2 heartbeat read of client.handle -> HEARTBEAT listing messages sent
\*     jointly with the run_processes change (no staleness, as in the seed);
\*   X12 can_restart oracle stays a free choice (no trainer marker in slice).
\* Faults: deployError, launchError (prepare/spawn/waiter/restart exceptions),
\* outcomeReportFail; childError is the RunCJ crash (cjCrash) itself.
EXTENDS Ports
VARIABLE jobCP_f

\* ---- slice profile of the seed constants (JobRefinement.tla) ----
T0 == <<JobId, 1>>
Tokens == {T0}
Pool == <<0>>
ReservationTTL == 1
MaxRestartFailures == MaxLaunch - 1
LaunchSlots == MaxLaunch
LeafSite == TRUE
Generations == 0..LaunchSlots
Reverse(q) == [i \in 1..Len(q) |-> q[Len(q)-i+1]]

\* ---- seed variables as operators over the private record ----
rm == jobCP_f.rm
client == jobCP_f.client
resourceEnv == jobCP_f.resourceEnv

EmptyClient == [pc |-> "idle", handle |-> "none",
                spawned |-> FALSE, binding |-> <<>>, waiter |-> FALSE,
                cleanup |-> "none", logical |-> "NOT_STARTED",
                abortRequested |-> FALSE, terminateRequested |-> FALSE,
                pendingAbort |-> FALSE, attached |-> FALSE,
                exitObserved |-> FALSE, exitCode |-> "ok", deployed |-> FALSE,
                generation |-> 0, restartAttempts |-> 0, ready |-> FALSE,
                rawExit |-> "ok", retryable |-> FALSE, restartSafe |-> FALSE, restartChecked |-> FALSE,
                replyDue |-> FALSE]
InitValue == [rm |-> [s \in Sites |-> [free |-> Pool,
                              reserved |-> [t \in Tokens |-> <<>>],
                              ttl |-> [t \in Tokens |-> 0],
                              allocated |-> [t \in Tokens |-> <<>>],
                              payload |-> [t \in Tokens |-> <<>>],
                              releases |-> [t \in Tokens |-> 0]]],
              client |-> [s \in Sites |-> [t \in Tokens |-> EmptyClient]],
              resourceEnv |-> [s \in Sites |-> <<>>],
              handled |-> [s \in Sites |-> {}],
              startReply |-> [s \in Sites |-> "none"],
              restartFailed |-> [s \in Sites |-> FALSE],
              hb |-> [s \in Sites |-> 0],
              otherJob |-> [s \in Sites |-> FALSE]]
Init == jobCP_f = InitValue

RegisteredAtSite(s,j) == \E t \in Tokens : t[1]=j /\ client[s][t].handle # "none"
ResourceManagerUnlocked(s) ==
    \A t \in Tokens : rm[s].reserved[t] # <<>> => rm[s].ttl[t] > 0
RestartEligible(s,t) ==
 /\ LeafSite /\ MaxRestartFailures>0 /\ client[s][t].retryable
 /\ client[s][t].restartChecked /\ client[s][t].restartSafe
 /\ ~client[s][t].abortRequested /\ client[s][t].logical # "STOPPED"
 /\ client[s][t].restartAttempts < MaxRestartFailures
 \* finite instance: no launch slot left means no restart (the CP then reports
 \* the failure); without this the generic deadlock check found a model-bound
 \* hang (restart eligible at generation = LaunchSlots, blind2 03:20)
 /\ client[s][t].generation < LaunchSlots

\* ---- port re-encodings ----
\* OS fact: the CJ of the current generation is alive (replaces client.alive).
ChildAlive(s,t) == CJAlive(s, client[s][t].generation)
\* Return codes the CP can observe for an exit cause (replaces the rc oracle):
\* normal exit -> 0; crash -> EXECUTION_ERROR (generic) or another failure;
\* terminated -> ABORTED rc file or a generic nonzero rc.
RcFor(x) == CASE x = "ok" -> {"ok"} [] x = "crash" -> {"generic", "failed"}
              [] OTHER -> {"aborted", "generic"}
OutcomeBody(s,t) == CASE client[s][t].exitCode = "ok" -> "ok"
                      [] client[s][t].exitCode = "aborted" -> "aborted"
                      [] OTHER -> "failed"
Fresh1(s, k, kind) == InInbox(k, CP(s), kind) /\ k \notin jobCP_f.handled[s]
Take(s, k) == [jobCP_f.handled EXCEPT ![s] = @ \cup {k}]
Reply(kind, s, body) == Msg(kind, CP(s), SP, <<JobId, s>>, body)
Kill(s,t) == IF ChildAlive(s,t) /\ client[s][t].generation \notin pJobCP[s].killed
             THEN [pJobCP EXCEPT ![s].killed = @ \cup {client[s][t].generation}]
             ELSE pJobCP
\* Heartbeat job listing (communicator.py:729-754): reported when the job
\* enters (2) or leaves (3) run_processes; the seed's SP read client.handle
\* atomically (X1/X2), so the report is joint with the registry change.
HB(s, ph) == Msg("HEARTBEAT", CP(s), SP, <<JobId, s, ph>>, ph)
StatusKinds == {"STARTED", "READY", "STOPPED"}
StatusMsg(s, k) == \E kind \in StatusKinds : Fresh1(s, k, kind)

\* ---- seed invariants (base.tla:1814-1931), group-local, alive -> ChildAlive ----
Units == {Pool[i] : i \in DOMAIN Pool}
SeqSet(q) == {q[i] : i \in DOMAIN q}
Count(q,u) == Cardinality({i \in DOMAIN q : q[i] = u})
RECURSIVE SumOn(_,_)
SumOn(ds,f) == IF ds = {} THEN 0
              ELSE LET d == CHOOSE x \in ds : TRUE
                   IN f[d] + SumOn(ds \ {d},f)
OwnershipCount(s,u) == Count(rm[s].free,u) +
    SumOn(Tokens,[t \in Tokens |-> Count(rm[s].reserved[t],u)+Count(rm[s].allocated[t],u)])
ResourceConservation == \A s \in Sites, u \in Units : OwnershipCount(s,u)=1
NoFreeWhileInUse ==
    \A s \in Sites, t \in Tokens : ChildAlive(s,t) =>
      \A u \in SeqSet(client[s][t].binding) :
        /\ Count(rm[s].free,u)=0
        /\ \A v \in Tokens \ {t} :
             Count(rm[s].reserved[v],u)+Count(rm[s].allocated[v],u)=0
StartupOwns(s,t) == client[s][t].pc \in
    {"allocated","consumed","checked","registered","snapshotted","spawned",
     "attachedAbort","attached","afterEvent","rollback"}
WaiterOwns(s,t) == client[s][t].waiter /\ client[s][t].cleanup # "done"
CleanupOwnerOrCompleted ==
    \A s \in Sites, t \in Tokens : rm[s].payload[t] # <<>> =>
      \/ StartupOwns(s,t)
      \/ WaiterOwns(s,t)
      \/ /\ ~ChildAlive(s,t) /\ rm[s].allocated[t] = <<>>
SingleSupportedStart == \A s \in Sites :
    Cardinality({t \in Tokens : client[s][t].spawned}) <= 1
WaitBeforeNormalFree == \A s \in Sites,t \in Tokens :
    client[s][t].cleanup \in {"free","pop","event","done"} => client[s][t].exitObserved
\* always-on seed MC invariants / hunt invariants (MC-2 lineage)
SeedInv == ResourceConservation /\ SingleSupportedStart /\ WaitBeforeNormalFree
SeedHuntInv == NoFreeWhileInUse /\ CleanupOwnerOrCompleted

\* ---- abstraction to JobCP_C ----
CoarseKinds == {"CHECK_RESOURCES", "CANCEL_RESOURCES", "DEPLOY_JOB", "START_JOB",
                "ABORT_JOB", "HEARTBEAT_STOP"}
AbsOf(f) == [c \in Sites |-> [
    handled |-> {k \in f.handled[c] : k[1] \in CoarseKinds},
    reserved |-> f.rm[c].reserved[T0] # <<>>,
    deployed |-> f.client[c][T0].deployed,
    st |-> IF f.startReply[c] = "ok" THEN "running"
           ELSE IF f.startReply[c] = "no" THEN "failed"
           ELSE IF f.client[c][T0].pc # "idle" THEN "starting" ELSE "idle",
    abortReq |-> f.client[c][T0].abortRequested,
    relaunching |-> f.client[c][T0].cleanup = "relaunch"
                    /\ CurLaunch(c) < f.client[c][T0].generation,
    orphan |-> f.client[c][T0].cleanup \notin {"none", "relaunch"}
               /\ f.client[c][T0].pc \in {"registered", "snapshotted"}
               /\ CurLaunch(c) < f.client[c][T0].generation,
    restartFailed |-> f.restartFailed[c],
    hb |-> f.hb[c]]]
\* Profile otherJob (H08): a second job B runs on the same CP with its own GPU
\* (unit OtherUnit, never in this job's pool). B's START handler writes the
\* CP-global CUDA_VISIBLE_DEVICES (gpu_resource_consumer.py:34) like ours does.
OtherUnit == 1
\* The env a live child was spawned with names only units allocated to it
\* (process_launcher.py:130 copies os.environ at every spawn, including the
\* restart path, client_executor.py:722-758, which does not consume again).
EnvMatchesAllocation ==
    \A s \in Sites, t \in Tokens :
        ChildAlive(s,t) /\ client[s][t].spawned /\ rm[s].payload[t] # <<>>
            => SeqSet(client[s][t].binding) \subseteq SeqSet(rm[s].payload[t])

AbsC == AbsOf(jobCP_f)
AbsCInit == [c \in Sites |-> [handled |-> {}, reserved |-> FALSE, deployed |-> FALSE,
                 st |-> "idle", abortReq |-> FALSE, relaunching |-> FALSE,
                 orphan |-> FALSE, restartFailed |-> FALSE, hb |-> 0]]


\* private/fed/client/scheduler_cmds.py:67-96; app_common/resource_managers/auto_clean_resource_manager.py:123-138; app_common/resource_managers/list_resource_manager.py:57-75
CheckResourceProcessorReserve(s, k) ==
    LET t == T0 IN
    /\ ResourceManagerUnlocked(s)
    /\ Fresh1(s, k, "CHECK_RESOURCES")
    /\ rm[s].free # <<>>
    /\ jobCP_f' = [jobCP_f EXCEPT !.rm = [rm EXCEPT ![s].free = Tail(@), ![s].reserved[t] = <<Head(rm[s].free)>>, ![s].ttl[t] = ReservationTTL],
              !.handled = Take(s, k)]
    /\ net' = Send(net, Reply("RESOURCES_OK", s, "ok"))
    /\ UNCHANGED <<pJobCP>>

\* private/fed/client/scheduler_cmds.py:86-96; app_common/resource_managers/auto_clean_resource_manager.py:123-138; app_common/resource_managers/list_resource_manager.py:57-67
CheckResourceProcessorUnavailable(s, k) ==
    LET t == T0 IN
    /\ ResourceManagerUnlocked(s)
    /\ Fresh1(s, k, "CHECK_RESOURCES")
    /\ rm[s].free = <<>>
    /\ jobCP_f' = [jobCP_f EXCEPT !.handled = Take(s, k)]
    /\ net' = Send(net, Reply("RESOURCES_OK", s, "no"))
    /\ UNCHANGED <<pJobCP>>

\* private/fed/client/scheduler_cmds.py:152-160; app_common/resource_managers/auto_clean_resource_manager.py:140-151; app_common/resource_managers/list_resource_manager.py:52-55
CancelResourceProcessorCancel(s, k) ==
    LET t == T0 IN
    /\ ResourceManagerUnlocked(s)
    /\ Fresh1(s, k, "CANCEL_RESOURCES")
    /\ jobCP_f' = [jobCP_f EXCEPT !.rm = [rm EXCEPT ![s].free = Reverse(rm[s].reserved[t]) \o @, ![s].reserved[t] = <<>>, ![s].ttl[t] = 0],
              !.handled = Take(s, k)]
    /\ net' = Send(net, Reply("CANCEL_ACK", s, None))
    /\ UNCHANGED <<pJobCP>>

\* app_common/resource_managers/auto_clean_resource_manager.py:102-113  [TTL scan; expiry before START gated by the resExpiry timing toggle]
AutoCleanResourceManagerTick(s) ==
    /\ "resExpiry" \in Faults
    /\ ResourceManagerUnlocked(s)
    /\ \E t \in Tokens : rm[s].ttl[t] > 0
    /\ jobCP_f' = [jobCP_f EXCEPT !.rm = [rm EXCEPT ![s].ttl = [t \in Tokens |-> IF rm[s].ttl[t]>0 THEN rm[s].ttl[t]-1 ELSE 0]]]
    /\ UNCHANGED <<net, pJobCP>>

\* app_common/resource_managers/auto_clean_resource_manager.py:105-116; app_common/resource_managers/list_resource_manager.py:52-55
AutoCleanResourceManagerFinishExpiry(s) ==
    LET t == T0 IN
    /\ rm[s].reserved[t] # <<>>
    /\ rm[s].ttl[t] = 0
    /\ jobCP_f' = [jobCP_f EXCEPT !.rm = [rm EXCEPT ![s].free = Reverse(rm[s].reserved[t]) \o @, ![s].reserved[t] = <<>>]]
    /\ UNCHANGED <<net, pJobCP>>

\* private/fed/client/training_cmds.py:100-153; private/fed/client/client_engine.py:462-480; private/fed/server/job_runner.py:301-318
ClientDeploySuccess(s, k) ==
    LET t == T0 IN
    /\ Fresh1(s, k, "DEPLOY_JOB")
    /\ jobCP_f' = [jobCP_f EXCEPT !.client = [client EXCEPT ![s][t].deployed = TRUE],
              !.handled = Take(s, k)]
    /\ net' = Send(net, Reply("DEPLOY_REPLY", s, "ok"))
    /\ UNCHANGED <<pJobCP>>

\* private/fed/client/training_cmds.py:100-153; private/fed/client/client_engine.py:462-480; private/fed/server/job_runner.py:301-318
ClientDeployError(s, k) ==
