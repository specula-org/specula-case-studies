        /\ JobSP_C!Init
        /\ JobSP_F!Init
        /\ JobCP_C!Init
        /\ JobCP_F!Init
        /\ RunCJ_C!Init
        /\ RunCJ_F!Init
        /\ TaskCJ_C!Init
        /\ TaskCJ_F!Init
        /\ Trainer_C!Init
        /\ Trainer_F!Init
        /\ Trainer_X!Init
        /\ Trainer_A!Init
        /\ PaySrc_C!Init
        /\ PaySrc_F!Init
        /\ PayRcv_C!Init
        /\ PayRcv_F!Init
        /\ CommSJ_C!Init
        /\ CommSJ_F!Init
        /\ WfSJ_C!Init
        /\ WfSJ_F!Init
        /\ Reg_C!Init
        /\ Reg_F!Init
        /\ Worker_C!Init
        /\ Worker_F!Init
        /\ Model_C!Init
        /\ Swarm_C!Init
        /\ Net_R!Init
        /\ Net_L!Init

Step_JobSP_C_SendCheck == (/\ Grain["JobSP"] = "C" /\ "JobSP" \notin DOMAIN SiteGrain /\ JobSP_C!SendCheck /\ UNCHANGED <<pJobCP, pRunCJ, pTaskCJ, pPaySrc, pPayRcv, pCommSJ, pWfSJ, pTrainer, pReg, pWorker, pModel, pSwarm, jobSP_f, jobCP_c, jobCP_f, runCJ_c, runCJ_f, taskCJ_c, taskCJ_f, trainer_c, trainer_f, trainer_x, trainer_a, paySrc_c, paySrc_f, payRcv_c, payRcv_f, commSJ_c, commSJ_f, wfSJ_c, wfSJ_f, reg_c, reg_f, worker_c, worker_f, model_c, swarm_c, net_r, net_l>> /\ Assert(NetOK("JobSP"), "net discipline: Step_JobSP_C_SendCheck"))
