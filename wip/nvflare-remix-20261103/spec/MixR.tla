---------------------------- MODULE MixR ----------------------------
\* GENERATED by scripts/rarity.py from Mix.tla + rarity.json: the mix with a
\* bounded rare-event budget. Do not edit.
EXTENDS Mix
CONSTANT RareBudget
VARIABLE rare
PricedFaults == {"abort", "abortCmdError", "admissionError", "archiveError", "cancel", "cbFail", "cjCrash", "cpCrash", "deadClient", "deleteJob", "deployError", "jobExitRace", "launchError", "minClients", "monitorStale", "netLoss", "outcomeReportFail", "outcomeTimeout", "payCallback", "payCompute", "payConsumer", "payDelete", "payProduce", "paySubmit", "prepFail", "pullTimeout", "resExpiry", "resultWaitTimeout", "rpcTimeout", "sjCrash", "slowAdminStop", "slowEnvelope", "slowFinalize", "slowSJTeardown", "slowShutdownAbort", "sourceFailure", "spCrash", "spShutdown", "statusLost", "storeError", "submitTimeout", "taskTimeout", "tpSilent", "trainerError", "transportFail", "txTimeout"}
NormalFaults == Faults \ PricedFaults
CommSJ_C__N == INSTANCE CommSJ_C WITH Faults <- NormalFaults
CommSJ_F__N == INSTANCE CommSJ_F WITH Faults <- NormalFaults
JobCP_C__N == INSTANCE JobCP_C WITH Faults <- NormalFaults
JobCP_F__N == INSTANCE JobCP_F WITH Faults <- NormalFaults
JobSP_C__N == INSTANCE JobSP_C WITH Faults <- NormalFaults
