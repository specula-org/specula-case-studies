    /\ M(k).body = "failed"
    /\ s \in jobs[t[1]].pending
    /\ LET n == [jobSP_f EXCEPT !.jobs = [jobs EXCEPT ![t[1]].pending = IF jobs[t[1]].serverRegistered \/ jobs[t[1]].running THEN {} ELSE @ \ {s}, ![t[1]].outcomeKey = IF jobs[t[1]].serverRegistered \/ jobs[t[1]].running THEN FALSE ELSE @, ![t[1]].serverFailed = @ \/ jobs[t[1]].serverRegistered \/ jobs[t[1]].running, ![t[1]].serverAborted = IF jobs[t[1]].serverRegistered \/ jobs[t[1]].running THEN FALSE ELSE @, ![t[1]].serverStop = @ \/ jobs[t[1]].serverRegistered],
                 !.handled = @ \cup {k},
                 !.outcomes[s] = "failed",
                 !.abortSent = @ \cup (IF jobs[t[1]].serverRegistered THEN jobs[t[1]].deployed ELSE {})] IN
       /\ jobSP_f' = Fin(n)
       /\ pJobSP' = PortOf(Fin(n))
    /\ net' = IF jobs[t[1]].serverRegistered THEN CmdAllS("ABORT_JOB", jobs[t[1]].deployed, "outcome") ELSE net

