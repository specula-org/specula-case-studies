\* private/fed/server/fed_server.py:943-961; private/fed/server/job_runner.py:903-933
ServerEngineReceiveAbortedOutcome(s, k) ==
    LET t == T0 IN
    /\ FromCP(s, k, "OUTCOME")
    /\ M(k).body = "aborted"
    /\ s \in jobs[t[1]].pending
    /\ LET n == [jobSP_f EXCEPT !.jobs = [jobs EXCEPT ![t[1]].pending = IF jobs[t[1]].serverRegistered \/ jobs[t[1]].running THEN {} ELSE @ \ {s}, ![t[1]].outcomeKey = IF jobs[t[1]].serverRegistered \/ jobs[t[1]].running THEN FALSE ELSE @, ![t[1]].serverFailed = @ \/ jobs[t[1]].serverRegistered \/ jobs[t[1]].running, ![t[1]].serverAborted = IF (jobs[t[1]].serverRegistered \/ jobs[t[1]].running) /\ ~jobs[t[1]].serverFailed THEN TRUE ELSE @, ![t[1]].serverStop = @ \/ jobs[t[1]].serverRegistered],
                 !.handled = @ \cup {k},
                 !.outcomes[s] = "aborted",
                 !.abortSent = @ \cup (IF jobs[t[1]].serverRegistered THEN jobs[t[1]].deployed ELSE {})] IN
       /\ jobSP_f' = Fin(n)
       /\ pJobSP' = PortOf(Fin(n))
    /\ net' = IF jobs[t[1]].serverRegistered THEN CmdAllS("ABORT_JOB", jobs[t[1]].deployed, "outcome") ELSE net

\* private/fed/server/fed_server.py:943-945
ServerEngineIgnoreOutcome(s, k) ==
    LET t == T0 IN
    /\ s \notin jobs[t[1]].pending
    /\ FromCP(s, k, "OUTCOME")
    /\ LET n == [jobSP_f EXCEPT !.handled = @ \cup {k}] IN
       /\ jobSP_f' = Fin(n)
       /\ pJobSP' = PortOf(Fin(n))
    /\ UNCHANGED <<net>>

\* private/fed/server/fed_server.py:1054-1103; private/fed/server/job_runner.py:903-933; private/fed/server/job_runner.py:136-142  [X2: CP listing from the latest heartbeat]
ServerEngineResolveMissingOutcome(s) ==
    LET t == T0 IN
    /\ ~jobs[t[1]].serverRegistered
    /\ s \in jobs[t[1]].pending
    /\ HBView(s) \in {0, 3}
    /\ t[2]=scheduler.issued[t[1]]
    /\ LET n == [jobSP_f EXCEPT !.jobs = [jobs EXCEPT ![t[1]].pending = IF jobs[t[1]].running /\ ~jobs[t[1]].serverFailed THEN {} ELSE @ \ {s}, ![t[1]].outcomeKey = IF jobs[t[1]].running /\ ~jobs[t[1]].serverFailed THEN FALSE ELSE @, ![t[1]].serverFailed = @ \/ jobs[t[1]].running, ![t[1]].serverAborted = IF jobs[t[1]].running /\ ~jobs[t[1]].serverFailed THEN FALSE ELSE @]] IN
       /\ jobSP_f' = Fin(n)
       /\ pJobSP' = PortOf(Fin(n))
    /\ UNCHANGED <<net>>

