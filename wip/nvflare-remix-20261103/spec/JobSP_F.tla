    /\ FromCP(s, k, "RESOURCES_OK")
    /\ M(k).body = "ok"
    /\ LET n == [jobSP_f EXCEPT !.rpc = [rpc EXCEPT ![s][t].check = IF rpc[s][t].check = "waiting" THEN "ok" ELSE rpc[s][t].check],
                 !.handled = @ \cup {k}] IN
       /\ jobSP_f' = Fin(n)
       /\ pJobSP' = PortOf(Fin(n))
    /\ UNCHANGED <<net>>

