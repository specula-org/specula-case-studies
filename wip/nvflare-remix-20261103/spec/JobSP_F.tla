    /\ jobs[j].serverStop \/ jobs[j].adminPC="stopWait" \/ (scheduler.current=j /\ scheduler.pc="failStopWait")
    /\ jobs[j].serverSpawned
    /\ ~jobs[j].serverRegistered
    /\ LET n == [jobSP_f EXCEPT !.jobs = [jobs EXCEPT ![j].serverTerminated = TRUE]] IN
       /\ jobSP_f' = Fin(n)
       /\ pJobSP' = PortOf(Fin(n))
    /\ UNCHANGED <<net>>

