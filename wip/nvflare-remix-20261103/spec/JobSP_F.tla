ServerEngineReceiveOutcome(s, k) ==
    LET t == T0 IN
    /\ FromCP(s, k, "OUTCOME")
    /\ M(k).body = "ok"
    /\ s \in jobs[t[1]].pending
    /\ LET n == [jobSP_f EXCEPT !.jobs = [jobs EXCEPT ![t[1]].pending = @ \ {s}],
                 !.handled = @ \cup {k},
                 !.outcomes[s] = "ok"] IN
       /\ jobSP_f' = Fin(n)
       /\ pJobSP' = PortOf(Fin(n))
    /\ UNCHANGED <<net>>

