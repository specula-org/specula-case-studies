\* ---- admin delete_job (fault deleteJob) and the scheduling loop (thread audit T1)
\* job_cmds.py:509-537: refused only for DISPATCHED/RUNNING, so a queued job, or
\* one being deployed (still SUBMITTED), can be deleted (store object removed).
AdminDeleteJob ==
    LET j == JobId IN
    /\ "deleteJob" \in Faults
    /\ ~jobs[j].deleted /\ jobs[j].status = "SUBMITTED"
    /\ LET n == [jobSP_f EXCEPT !.jobs = [jobs EXCEPT ![j].deleted = TRUE]] IN
       /\ jobSP_f' = Fin(n)
       /\ pJobSP' = PortOf(Fin(n))
    /\ UNCHANGED <<net>>

\* job_def_manager.py:517-531, job_runner.py:703: the delete lands between the
\* scan's listing and its meta read; StorageException outside the try (T1).
JobRunnerScanDeleted ==
    LET j == JobId IN
    /\ "deleteJob" \in Faults
    /\ scheduler.pc = "idle" /\ Cardinality(scheduler.scheduled) < MaxJobs
    /\ ~jobs[j].deleted /\ jobs[j].status = "SUBMITTED"
    /\ LET n == [jobSP_f EXCEPT !.jobs = [jobs EXCEPT ![j].deleted = TRUE],
                 !.scheduler = [scheduler EXCEPT !.pc = "crashed"]] IN
       /\ jobSP_f' = Fin(n)
       /\ pJobSP' = PortOf(Fin(n))
    /\ UNCHANGED <<net>>

\* job_runner.py:733-735,769: inside the try, the store access for a deleted job
\* raises (claim check, DISPATCHED/RUNNING write) and the except branch runs.
JobRunnerDeletedInTry ==
    /\ scheduler.pc \in {"claimStart", "writeDispatched", "persistDeploy", "writeRunning"}
    /\ jobs[CurrentJob].deleted
    /\ LET n == [jobSP_f EXCEPT !.scheduler = [scheduler EXCEPT !.pc = "failRemove"]] IN
       /\ jobSP_f' = Fin(n)
       /\ pJobSP' = PortOf(Fin(n))
    /\ UNCHANGED <<net>>

\* job_runner.py:794-797: the except branch's own _check_job_status raises for a
\* deleted job; no handler, the scheduling loop ends (T1-b).
JobRunnerFailureStatusDeleted ==
    /\ scheduler.pc = "failStatus"
    /\ jobs[CurrentJob].deleted
    /\ LET n == [jobSP_f EXCEPT !.scheduler = [scheduler EXCEPT !.pc = "crashed"]] IN
       /\ jobSP_f' = Fin(n)
       /\ pJobSP' = PortOf(Fin(n))
    /\ UNCHANGED <<net>>

