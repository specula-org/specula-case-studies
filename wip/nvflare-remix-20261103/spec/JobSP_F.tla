    /\ jobs[j].serverSpawned
    /\ LET n == [jobSP_f EXCEPT !.jobs = [jobs EXCEPT ![j].serverTerminated = TRUE],
                 !.sjKilled = @ \/ SJAlive] IN
       /\ jobSP_f' = Fin(n)
       /\ pJobSP' = PortOf(Fin(n))
    /\ UNCHANGED <<net>>

