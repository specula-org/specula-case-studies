\* app_common/job_schedulers/job_scheduler.py:214-304; app_common/job_schedulers/job_scheduler.py:394-420  [seed MC budget AdmissionErrorLimit = 1 (the exception can recur at history)]
DefaultJobSchedulerAdmissionException ==
    /\ "admissionError" \in Faults
    /\ jobSP_f.admissionErrors < 1
    /\ scheduler.pc \in {"checkWait","history"}
    /\ WaitDone(CurrentToken,"check",Sites)
    /\ LET n == [jobSP_f EXCEPT !.jobs = [jobs EXCEPT ![CurrentJob].dispatch = ReplySites(CurrentToken,"check","ok")],
                 !.scheduler = [scheduler EXCEPT !.pc = "cancelSend", !.result = "admission_error"],
                 !.admissionErrors = @ + 1] IN
       /\ jobSP_f' = Fin(n)
       /\ pJobSP' = PortOf(Fin(n))
    /\ UNCHANGED <<net>>

\* private/fed/server/job_runner.py:714-723
JobRunnerCheckSubmitted ==
