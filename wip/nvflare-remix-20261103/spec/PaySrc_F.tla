InitValue == [si \in Sites |-> [ln \in Launches |-> [a \in Attempts |-> SrcInit0]]]
Init == paySrc_f = InitValue

\* download_service.py:270-298,1315-1401; via_downloader.py:513-650: new_transaction +
\* add_object under the table/outcome locks before the payload is exposed; the
\* result sender attaches the first waiter (seed Init state).
\* REMIX: replaces the seed's pre-registered Init; driven by the round-a submission
\* (one transaction Tx(si, ln, a) per round).
Register(si, ln, a) ==
    LET st == paySrc_f[si][ln][a]
        sub == pTaskCJ[si][ln].submission
    IN
    /\ sub /= None /\ sub.assignment.attempt = a
    /\ pPaySrc[si][ln].tx[a].registered = None /\ CJAlive(si, ln) /\ ~st.reg
    /\ pPaySrc' = TxUpd(si, ln, a, [pPaySrc[si][ln].tx[a] EXCEPT !.registered =
          [ref |-> Ref(si, ln, a), source |-> CJ(si), launch |-> ln, value |-> sub.value]])
    /\ paySrc_f' = [paySrc_f EXCEPT ![si][ln][a].reg = TRUE]
    /\ UNCHANGED net

\* download_service.py:1681-1699,822-833: admit a pull while holding the table and operation locks
\* REMIX: consumes PAYLOAD_PULL mk (seed: pullPC[p] = "sent" /\ futureStarted[p]); request state n-1.
HandleDownloadBegin(si, ln, a, p, mk) ==
    LET st == paySrc_f[si][ln][a] IN
    /\ st.reg /\ CJAlive(si, ln) /\ ~DSShutdownPending(si, ln)
    /\ ForMe(si, ln, a, mk, "PAYLOAD_PULL") /\ p[2] = RcvOf(M(mk).from)
    /\ st.hpc[p] \in {"idle", "done"}
    /\ st.live /\ ~st.closed /\ ~st.tableLocked
    /\ paySrc_f' = [paySrc_f EXCEPT ![si][ln][a] = [st EXCEPT
          !.handled = @ \cup {mk}, !.ops = @ \cup {Pull(p)}, !.hpc[p] = "markTx",
          !.hreq[p] = mk, !.hidx[p] = M(mk).body.n - 1]]
    /\ UNCHANGED <<pPaySrc, net>>

\* download_service.py:1681-1707: after ref retirement, return retained finished status or missing-ref error; includes a late first acquisition
\* REMIX: consumes PAYLOAD_PULL mk and sends PAYLOAD_REPLY; "missing" = ReturnCode.INVALID_REQUEST.
HandleDownloadMissing(si, ln, a, p, mk) ==
    LET st == paySrc_f[si][ln][a]
        rc == IF ~st.shutdown /\ st.tombstoneAt >= 0 /\ st.now - st.tombstoneAt <= FinishedRefsTTL
              THEN (IF st.status[p] = "success" THEN "eof" ELSE "error") ELSE "missing"
    IN
    /\ st.reg /\ CJAlive(si, ln) /\ ~DSShutdownPending(si, ln)
    /\ ForMe(si, ln, a, mk, "PAYLOAD_PULL") /\ p[2] = RcvOf(M(mk).from)
    /\ (~st.live \/ st.closed)
    /\ (~st.tableLocked)
    /\ paySrc_f' = [paySrc_f EXCEPT ![si][ln][a].handled = @ \cup {mk}]
    /\ net' = Send(net, ReplyMsg(si, mk, RcWire(rc), None, None))
    /\ UNCHANGED pPaySrc

\* download_service.py:1701,300-301,774-775: update the sliding global inactivity clock
HandleDownloadMarkActive(si, ln, a, p) ==
    LET st == paySrc_f[si][ln][a]
    IN
    /\ st.reg /\ CJAlive(si, ln)
    /\ ~DSShutdownPending(si, ln)
    /\ (st.hpc[p] = "markTx")
    /\ paySrc_f' = [paySrc_f EXCEPT ![si][ln][a] = [st EXCEPT
          !.txLast = st.now,
          !.hpc[p] = "sampleRef"]]
    /\ UNCHANGED <<pPaySrc, net>>

\* download_service.py:mark_receiver_active:443: sample now before acquiring the ref progress lock
RefSampleReceiverTime(si, ln, a, p) ==
    LET st == paySrc_f[si][ln][a]
    IN
    /\ st.reg /\ CJAlive(si, ln)
    /\ ~DSShutdownPending(si, ln)
    /\ (st.hpc[p] = "sampleRef")
    /\ paySrc_f' = [paySrc_f EXCEPT ![si][ln][a] = [st EXCEPT
          !.pullTime[p] = st.now,
          !.hpc[p] = "markRef"]]
    /\ UNCHANGED <<pPaySrc, net>>

\* download_service.py:mark_receiver_active:444-445: publish saved request time under progress lock after any lock wait
RefMarkReceiverActive(si, ln, a, p) ==
    LET st == paySrc_f[si][ln][a]
    IN
    /\ st.reg /\ CJAlive(si, ln)
    /\ ~DSShutdownPending(si, ln)
    /\ (st.hpc[p] = "markRef")
    /\ paySrc_f' = [paySrc_f EXCEPT ![si][ln][a] = [st EXCEPT
          !.refLast[p] = st.pullTime[p],
          !.hpc[p] = "markReceiver"]]
    /\ UNCHANGED <<pPaySrc, net>>

\* download_service.py:445-450: publish the same captured time under transaction stats lock
TransactionMarkReceiverActive(si, ln, a, p) ==
    LET st == paySrc_f[si][ln][a]
    IN
    /\ st.reg /\ CJAlive(si, ln)
    /\ ~DSShutdownPending(si, ln)
    /\ (st.hpc[p] = "markReceiver")
    /\ paySrc_f' = [paySrc_f EXCEPT ![si][ln][a] = [st EXCEPT
          !.receiverLast[p[2]] = st.pullTime[p],
          !.acquired = @ \cup {p[2]},
          !.hpc[p] = "startProgress"]]
    /\ UNCHANGED <<pPaySrc, net>>

\* download_service.py:1703,517-542: request ACTIVE progress before produce
HandleDownloadActiveProgress(si, ln, a, p) ==
    LET st == paySrc_f[si][ln][a]
    IN
    /\ st.reg /\ CJAlive(si, ln)
    /\ ~DSShutdownPending(si, ln)
    /\ (st.hpc[p] = "startProgress")
    /\ (st.pub[Pull(p)].pc = "idle")
    /\ paySrc_f' = [paySrc_f EXCEPT ![si][ln][a] = [st EXCEPT
          !.pub[Pull(p)] = RequestPub(p, "active", 0, FALSE),
          !.hpc[p] = "produce"]]
    /\ UNCHANGED <<pPaySrc, net>>

\* download_service.py:1707-1716,1724,1751-1775: ordinary produce returns DATA then EOF; transport contents abstracted
HandleDownloadProduce(si, ln, a, p) ==
    LET st == paySrc_f[si][ln][a]
    IN
    /\ st.reg /\ CJAlive(si, ln)
    /\ ~DSShutdownPending(si, ln)
    /\ (st.hpc[p] = "produce")
    /\ (st.pub[Pull(p)].pc = "idle")
    /\ paySrc_f' = [paySrc_f EXCEPT ![si][ln][a] = [st EXCEPT
          !.rc[p] = IF st.hidx[p] < ChunkCount THEN "data" ELSE "eof",
          !.hpc[p] = IF st.hidx[p] < ChunkCount THEN "dataProgress" ELSE "served"]]
    /\ UNCHANGED <<pPaySrc, net>>

\* download_service.py:1715-1722: ordinary produce exception prepares FAILED progress and PROCESS_EXCEPTION
HandleDownloadProduceException(si, ln, a, p) ==
    LET st == paySrc_f[si][ln][a]
    IN
    /\ "payProduce" \in Faults
    /\ st.reg /\ CJAlive(si, ln)
    /\ ~DSShutdownPending(si, ln)
    /\ (st.hpc[p] = "produce")
    /\ (st.pub[Pull(p)].pc = "idle")
    /\ paySrc_f' = [paySrc_f EXCEPT ![si][ln][a] = [st EXCEPT
          !.rc[p] = "exception",
          !.pub[Pull(p)] = RequestPub(p, "failed", 0, TRUE),
          !.hpc[p] = "end"]]
    /\ UNCHANGED <<pPaySrc, net>>

\* download_service.py:369-397,1728-1732: record a provisional serve or return no nonce when already final
RefObjServed(si, ln, a, p) ==
    LET st == paySrc_f[si][ln][a]
    IN
    /\ st.reg /\ CJAlive(si, ln)
    /\ ~DSShutdownPending(si, ln)
    /\ (st.hpc[p] = "served")
    /\ paySrc_f' = [paySrc_f EXCEPT ![si][ln][a] = [st EXCEPT
          !.provisional[p] = IF st.status[p] = "none" THEN (IF st.rc[p] = "eof" THEN "success" ELSE "failed") ELSE "none",
          !.pending[p] = st.status[p] = "none",
          !.nonce[p] = st.status[p] = "none",
          !.hpc[p] = "terminalProgress"]]
    /\ UNCHANGED <<pPaySrc, net>>

\* download_service.py:1733-1749: choose progress from returned serve nonce and producer RC, outside progress lock
HandleDownloadTerminalProgress(si, ln, a, p) ==
    LET st == paySrc_f[si][ln][a]
    IN
    /\ st.reg /\ CJAlive(si, ln)
    /\ ~DSShutdownPending(si, ln)
    /\ (st.hpc[p] = "terminalProgress")
    /\ (st.pub[Pull(p)].pc = "idle")
    /\ paySrc_f' = [paySrc_f EXCEPT ![si][ln][a] = [st EXCEPT
          !.pub[Pull(p)] = RequestPub(p, IF st.nonce[p] THEN "active" ELSE IF st.rc[p] = "eof" THEN "completed" ELSE "failed", 0, TRUE),
          !.hpc[p] = "end"]]
    /\ UNCHANGED <<pPaySrc, net>>

\* download_service.py:1752-1775: count one abstract data unit and prepare ACTIVE progress
HandleDownloadDataProgress(si, ln, a, p) ==
    LET st == paySrc_f[si][ln][a]
    IN
    /\ st.reg /\ CJAlive(si, ln)
    /\ ~DSShutdownPending(si, ln)
    /\ (st.hpc[p] = "dataProgress")
    /\ (st.pub[Pull(p)].pc = "idle")
    /\ paySrc_f' = [paySrc_f EXCEPT ![si][ln][a] = [st EXCEPT
          !.pub[Pull(p)] = RequestPub(p, "active", 1, FALSE),
          !.nonce[p] = FALSE,
          !.hpc[p] = "end"]]
    /\ UNCHANGED <<pPaySrc, net>>

\* download_service.py:1750,1768-1779,835-839: finally leaves the operation gate before the reply becomes receivable
\* REMIX: sends PAYLOAD_REPLY for the admitted request (seed: reply[p] := rc, replyNonce[p] := nonce[p]).
HandleDownloadEndOp(si, ln, a, p) ==
    LET st == paySrc_f[si][ln][a] IN
    /\ st.reg /\ CJAlive(si, ln) /\ ~DSShutdownPending(si, ln)
    /\ (st.hpc[p] = "end")
    /\ (st.pub[Pull(p)].pc = "idle")
    /\ paySrc_f' = [paySrc_f EXCEPT ![si][ln][a] = [st EXCEPT
          !.ops = @ \ {Pull(p)}, !.hpc[p] = "done"]]
    /\ net' = Send(net, ReplyMsg(si, st.hreq[p], RcWire(st.rc[p]),
                 IF st.rc[p] = "data" THEN pPaySrc[si][ln].tx[a].registered.value ELSE None,
                 IF st.nonce[p] THEN ServeNonce(si, ln, a) ELSE None))
    /\ UNCHANGED pPaySrc

\* download_service.py:1782-1799,822-833: admit confirmation, preserving nonce requirement for the later final-status lock
\* REMIX: consumes RECEIVER_CONFIRM mk; its (status, nonce) is captured into fconf (seed read SJ state at commit).
HandleConfirmBegin(si, ln, a, p, mk) ==
    LET st == paySrc_f[si][ln][a] IN
    /\ st.reg /\ CJAlive(si, ln) /\ ~DSShutdownPending(si, ln)
    /\ ForMe(si, ln, a, mk, "RECEIVER_CONFIRM") /\ p[2] = RcvOf(M(mk).from)
    /\ (st.fpc[Confirm(p)] = "idle")
    /\ (st.live) /\ (~st.closed) /\ (~st.tableLocked)
    /\ paySrc_f' = [paySrc_f EXCEPT ![si][ln][a] = [st EXCEPT
          !.handled = @ \cup {mk}, !.ops = @ \cup {Confirm(p)}, !.ftodo[Confirm(p)] = {p},
          !.fpc[Confirm(p)] = "select",
          !.fconf[Confirm(p)] = [status |-> M(mk).body.status, nonce |-> M(mk).body.nonce]]]
    /\ UNCHANGED <<pPaySrc, net>>

\* download_service.py:1783-1793: drop confirmation after retirement/closed gate
\* REMIX: consumes RECEIVER_CONFIRM mk.
HandleConfirmLate(si, ln, a, p, mk) ==
    LET st == paySrc_f[si][ln][a] IN
    /\ st.reg /\ CJAlive(si, ln) /\ ~DSShutdownPending(si, ln)
    /\ ForMe(si, ln, a, mk, "RECEIVER_CONFIRM") /\ p[2] = RcvOf(M(mk).from)
    /\ (~st.live \/ st.closed)
    /\ (~st.tableLocked)
    /\ paySrc_f' = [paySrc_f EXCEPT ![si][ln][a].handled = @ \cup {mk}]
    /\ UNCHANGED <<pPaySrc, net>>

\* download_service.py:1814-1827,822-833: admit cancellation before testing transaction-level acquisition
\* REMIX: consumes RECEIVER_CANCEL mk from receiver rv (wire keyed by (ref, requester), no nonce).
HandleCancelBegin(si, ln, a, rv, mk) ==
    LET st == paySrc_f[si][ln][a] IN
    /\ st.reg /\ CJAlive(si, ln) /\ ~DSShutdownPending(si, ln)
    /\ ForMe(si, ln, a, mk, "RECEIVER_CANCEL") /\ rv = RcvOf(M(mk).from)
    /\ (st.fpc[Cancel(rv)] = "idle")
    /\ (st.live) /\ (~st.closed) /\ (~st.tableLocked)
    /\ paySrc_f' = [paySrc_f EXCEPT ![si][ln][a] = [st EXCEPT
          !.handled = @ \cup {mk}, !.ops = @ \cup {Cancel(rv)}, !.fpc[Cancel(rv)] = "acquired"]]
