\* download_service.py:313-335: atomic dedup, pending guard, pop, status record and downloaded_to_all latch
\* REMIX: CONFIRM content (status, nonce) captured at admission replaces the SJ fields read by reference
RefFinalizeReceiverCommit(si, ln, a, t) ==
    LET st == paySrc_f[si][ln][a]
        p == st.fp[t]
        value == IF t \in Confirmers THEN st.fconf[t].status ELSE "failed"
        won == st.status[p] = "none" /\ (t \notin Confirmers \/ (st.pending[p] /\ st.fconf[t].nonce = ServeNonce(si, ln, a)))
        m == IF won THEN [st.status EXCEPT ![p] = value] ELSE st.status
        all == won /\ ~st.allDone[p[1]] /\ RefFinished(m, p[1])
    IN
    /\ st.reg /\ CJAlive(si, ln)
    /\ ~DSShutdownPending(si, ln)
    /\ (st.fpc[t] = "commit")
    /\ paySrc_f' = [paySrc_f EXCEPT ![si][ln][a] = [st EXCEPT
          !.status = m,
          !.provisional[p] = IF won THEN "none" ELSE @,
          !.pending[p] = IF won THEN FALSE ELSE @,
          !.allDone[p[1]] = @ \/ all,
          !.fwon[t] = won,
          !.faccepted[t] = @ \/ won,
          !.fall[t] = all,
          !.cb[t] = IF won THEN Callback("one", p[1]) ELSE @,
          !.fpc[t] = IF won THEN "one" ELSE "advance"]]
    /\ UNCHANGED <<pPaySrc, net>>

