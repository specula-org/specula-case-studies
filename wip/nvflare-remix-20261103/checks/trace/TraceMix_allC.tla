Spec == Init /\ [][Next]_allVars
AtBoundAny == (GrainHas("TaskCJ", "C") /\ TaskCJ_C!AtBound) \/ (GrainHas("TaskCJ", "F") /\ TaskCJ_F!AtBound)
SiteSplittable == {"JobCP", "RunCJ", "TaskCJ", "Trainer", "PaySrc"}
ASSUME DOMAIN SiteGrain \subseteq SiteSplittable

\* Port projection of a group: its port variable and the messages it sent.
SentKinds(ks) == {net[k].msg : k \in {k2 \in DOMAIN net : net[k2].msg.kind \in ks}}
Proj_JobSP == <<pJobSP, SentKinds({"CHECK_RESOURCES", "CANCEL_RESOURCES", "DEPLOY_JOB", "START_JOB", "ABORT_JOB", "HEARTBEAT_STOP"})>>
Proj_JobCP == <<pJobCP, SentKinds({"RESOURCES_OK", "CANCEL_ACK", "DEPLOY_REPLY", "START_REPLY", "OUTCOME", "HEARTBEAT"})>>
Proj_RunCJ == <<pRunCJ, SentKinds({"STARTED", "READY", "STOPPED"})>>
Proj_TaskCJ == <<pTaskCJ, SentKinds({"GET_TASK", "TASK_CHECK", "RESULT_ENVELOPE"})>>
Proj_Trainer == <<pTrainer, SentKinds({})>>
Proj_PaySrc == <<pPaySrc, SentKinds({"PAYLOAD_REPLY"})>>
Proj_PayRcv == <<pPayRcv, SentKinds({"PAYLOAD_PULL", "RECEIVER_CONFIRM", "RECEIVER_CANCEL"})>>
Proj_CommSJ == <<pCommSJ, SentKinds({"TASK_ASSIGNMENT", "TASK_CHECK_REPLY", "RESULT_RECEIPT"})>>
Proj_WfSJ == <<pWfSJ, SentKinds({"END_RUN"})>>
Proj_Reg == <<pReg, SentKinds({})>>
CONSTANTS s1, s2
VARIABLE tpos, sil
MCGrain == [JobSP |-> "C", JobCP |-> "C", RunCJ |-> "C", TaskCJ |-> "C", Trainer |-> "C", PaySrc |-> "C", PayRcv |-> "C", CommSJ |-> "C", WfSJ |-> "C", Reg |-> "C", Net |-> "R"]
MCFaults == {}
MCSiteGrain == [g \in {} |-> 0]
Became(e) == ~e /\ e'
NewMsg(kind, from, to) == \E k \in DOMAIN net' \ DOMAIN net :
    net'[k].msg.kind = kind /\ net'[k].msg.from = from /\ net'[k].msg.to = to
TR == <<[a |-> "Reserve", c |-> s1],
    [a |-> "Reserve", c |-> s2],
    [a |-> "ServerLaunch", c |-> None],
    [a |-> "SendStart", c |-> s1],
    [a |-> "SendStart", c |-> s2],
    [a |-> "Allocate", c |-> s1],
    [a |-> "Launch", c |-> s1],
    [a |-> "Allocate", c |-> s2],
    [a |-> "Launch", c |-> s2],
    [a |-> "WorkflowOpened", c |-> None],
    [a |-> "ScheduleTask", c |-> None],
    [a |-> "InitializeRunner", c |-> s1],
    [a |-> "SendReady", c |-> s1],
    [a |-> "RequestTask", c |-> s1],
    [a |-> "PublishAssignment", c |-> s1],
    [a |-> "InitializeRunner", c |-> s2],
    [a |-> "SendReady", c |-> s2],
    [a |-> "RequestTask", c |-> s2],
    [a |-> "PublishAssignment", c |-> s2],
    [a |-> "BuildSubmission", c |-> s1],
    [a |-> "RegisterResultPayload", c |-> s1],
    [a |-> "PublishResultEnvelope", c |-> s1],
    [a |-> "BuildSubmission", c |-> s2],
    [a |-> "ReceiveEnvelope", c |-> s1],
    [a |-> "RequestPayload", c |-> s1],
    [a |-> "AcquirePayload", c |-> s1],
    [a |-> "RegisterResultPayload", c |-> s2],
    [a |-> "PublishResultEnvelope", c |-> s2],
    [a |-> "ReceiveEnvelope", c |-> s2],
    [a |-> "RequestPayload", c |-> s2],
    [a |-> "RequestPayload", c |-> s1],
    [a |-> "AcquirePayload", c |-> s1],
    [a |-> "MaterializeResult", c |-> s1],
    [a |-> "SendConfirm", c |-> s1],
    [a |-> "ReleaseSource", c |-> s1],
    [a |-> "RecordTransferOutcome", c |-> s1],
    [a |-> "AcquirePayload", c |-> s2],
    [a |-> "ClaimResult", c |-> s1],
    [a |-> "RequestPayload", c |-> s2],
    [a |-> "PublishDecision", c |-> s1],
    [a |-> "FinishContributionCallback", c |-> s1],
    [a |-> "PublishReceipt", c |-> s1],
    [a |-> "AcquirePayload", c |-> s2],
    [a |-> "MaterializeResult", c |-> s2],
    [a |-> "SendConfirm", c |-> s2],
    [a |-> "ClaimResult", c |-> s2],
    [a |-> "PublishDecision", c |-> s2],
    [a |-> "FinishContributionCallback", c |-> s2],
    [a |-> "PublishReceipt", c |-> s2],
    [a |-> "PublishAggregate", c |-> None],
    [a |-> "SaveModel", c |-> None],
    [a |-> "WorkflowDone", c |-> None],
    [a |-> "SendEndRun", c |-> s1],
    [a |-> "SendEndRun", c |-> s2],
    [a |-> "StopClientRunner", c |-> s1],
    [a |-> "ObserveChildExit", c |-> s1],
    [a |-> "ReportOutcome", c |-> s1],
    [a |-> "ReleaseSource", c |-> s2],
    [a |-> "RecordTransferOutcome", c |-> s2],
    [a |-> "ServerExit", c |-> None],
    [a |-> "ObserveOutcome", c |-> s1],
    [a |-> "FreeAllocation", c |-> s1],
    [a |-> "StopClientRunner", c |-> s2],
    [a |-> "ObserveChildExit", c |-> s2],
    [a |-> "ReportOutcome", c |-> s2],
    [a |-> "ObserveOutcome", c |-> s2],
    [a |-> "FinalizeJob", c |-> None],
    [a |-> "FreeAllocation", c |-> s2]>>
Ev(e) == LET c == e.c IN CASE e.a = "AcquirePayload" -> NewMsg("PAYLOAD_REPLY", CJ(c), SJ)
    [] e.a = "Allocate" -> Became(pJobCP[c].allocated)
    [] e.a = "BuildSubmission" -> (pTaskCJ[c][1].submission = None /\ pTaskCJ'[c][1].submission /= None)
    [] e.a = "ClaimResult" -> (c \notin pCommSJ.claimed /\ c \in pCommSJ'.claimed)
    [] e.a = "FinalizeJob" -> (pJobSP.terminal = "none" /\ pJobSP'.terminal /= "none")
    [] e.a = "FinishContributionCallback" -> (c \notin pCommSJ.finished /\ c \in pCommSJ'.finished)
    [] e.a = "FreeAllocation" -> (pJobCP[c].freed = 0 /\ pJobCP'[c].freed = 1)
    [] e.a = "InitializeRunner" -> (pRunCJ[c][1].state = "none" /\ pRunCJ'[c][1].state /= "none")
    [] e.a = "Launch" -> (pJobCP[c].launch = 0 /\ pJobCP'[c].launch = 1)
    [] e.a = "MaterializeResult" -> (pPayRcv[c].status /= "materialized" /\ pPayRcv'[c].status = "materialized")
    [] e.a = "ObserveChildExit" -> (pJobCP[c].exitSeen[1] = "none" /\ pJobCP'[c].exitSeen[1] /= "none")
    [] e.a = "ObserveOutcome" -> (pJobSP.outcomes[c] = "none" /\ pJobSP'.outcomes[c] /= "none")
    [] e.a = "PublishAggregate" -> (pWfSJ.aggregate = None /\ pWfSJ'.aggregate /= None)
    [] e.a = "PublishAssignment" -> NewMsg("TASK_ASSIGNMENT", SJ, CJ(c))
    [] e.a = "PublishDecision" -> (c \notin pWfSJ.accepted /\ c \in pWfSJ'.accepted)
    [] e.a = "PublishReceipt" -> NewMsg("RESULT_RECEIPT", SJ, CJ(c))
    [] e.a = "PublishResultEnvelope" -> NewMsg("RESULT_ENVELOPE", CJ(c), SJ)
    [] e.a = "ReceiveEnvelope" -> (pCommSJ.envelopes[c] = None /\ pCommSJ'.envelopes[c] /= None)
    [] e.a = "RecordTransferOutcome" -> (pPaySrc[c][1].outcome = "none" /\ pPaySrc'[c][1].outcome /= "none")
    [] e.a = "RegisterResultPayload" -> (pPaySrc[c][1].registered = None /\ pPaySrc'[c][1].registered /= None)
    [] e.a = "ReleaseSource" -> Became(pPaySrc[c][1].released)
    [] e.a = "ReportOutcome" -> NewMsg("OUTCOME", CP(c), SP)
    [] e.a = "RequestPayload" -> NewMsg("PAYLOAD_PULL", SJ, CJ(c))
    [] e.a = "RequestTask" -> NewMsg("GET_TASK", CJ(c), SJ)
    [] e.a = "Reserve" -> NewMsg("RESOURCES_OK", CP(c), SP)
    [] e.a = "SaveModel" -> Became(pWfSJ.saved)
    [] e.a = "ScheduleTask" -> (pWfSJ.scheduled = 0 /\ pWfSJ'.scheduled = 1)
    [] e.a = "SendConfirm" -> NewMsg("RECEIVER_CONFIRM", SJ, CJ(c))
    [] e.a = "SendEndRun" -> NewMsg("END_RUN", SJ, CJ(c))
    [] e.a = "SendReady" -> NewMsg("READY", CJ(c), CP(c))
    [] e.a = "SendStart" -> NewMsg("START_JOB", SP, CP(c))
    [] e.a = "ServerExit" -> (pWfSJ.sj /= "exited" /\ pWfSJ'.sj = "exited")
    [] e.a = "ServerLaunch" -> Became(pJobSP.sjLaunched)
    [] e.a = "StopClientRunner" -> (pRunCJ[c][1].state /= "stopping" /\ pRunCJ'[c][1].state = "stopping")
    [] e.a = "WorkflowDone" -> Became(pWfSJ.done)
    [] e.a = "WorkflowOpened" -> Became(pWfSJ.open)
    [] OTHER -> FALSE
\* the observable vocabulary: any instance of any mapped event, any site
AnyObs == \/ \E s \in {"AcquirePayload", "Allocate", "BuildSubmission", "ClaimResult", "FinishContributionCallback", "FreeAllocation", "InitializeRunner", "Launch", "MaterializeResult", "ObserveChildExit", "ObserveOutcome", "PublishAssignment", "PublishDecision", "PublishReceipt", "PublishResultEnvelope", "ReceiveEnvelope", "RecordTransferOutcome", "RegisterResultPayload", "ReleaseSource", "ReportOutcome", "RequestPayload", "RequestTask", "Reserve", "SendConfirm", "SendEndRun", "SendReady", "SendStart", "StopClientRunner"}, c \in Sites : Ev([a |-> s, c |-> c])
          \/ \E s \in {"FinalizeJob", "PublishAggregate", "SaveModel", "ScheduleTask", "ServerExit", "ServerLaunch", "WorkflowDone", "WorkflowOpened"} : Ev([a |-> s, c |-> None])
TInit == Init /\ tpos = 1 /\ sil = 0
Match(p, d) == CASE d = 0 -> ~AnyObs
                 [] d = 1 -> p <= Len(TR) /\ Ev(TR[p]) /\ ~(p + 1 <= Len(TR) /\ Ev(TR[p+1]))
                 [] d = 2 -> p + 1 <= Len(TR) /\ Ev(TR[p]) /\ Ev(TR[p+1]) /\ ~(p + 2 <= Len(TR) /\ Ev(TR[p+2]))
                 [] d = 3 -> p + 2 <= Len(TR) /\ Ev(TR[p]) /\ Ev(TR[p+1]) /\ Ev(TR[p+2])
\* sil counts consecutive silent steps (bounded by CONSTRAINT SilentBound); one step may produce up to 3 consecutive observed events (e.g. WorkflowDone + the END_RUN broadcast)
TNext == \E p \in {tpos}, d \in {0, 1, 2, 3}, q \in {sil} : tpos' = p + d /\ sil' = (IF d = 0 THEN q + 1 ELSE 0) /\ (
    \/ (Step_JobSP_C_SendCheck /\ Match(p, d))
    \/ (Step_JobSP_C_AdmitCancel /\ Match(p, d))
    \/ (Step_JobSP_C_Blocked /\ Match(p, d))
    \/ (Step_JobSP_C_DeploySend /\ Match(p, d))
    \/ (Step_JobSP_C_WriteDispatched /\ Match(p, d))
    \/ (Step_JobSP_C_Spawn /\ Match(p, d))
    \/ (Step_JobSP_C_SendStart /\ Match(p, d))
    \/ (Step_JobSP_C_RegisterRunning /\ Match(p, d))
    \/ (Step_JobSP_C_StartEval /\ Match(p, d))
    \/ (Step_JobSP_C_FilterPending /\ Match(p, d))
    \/ (Step_JobSP_C_WriteRunning /\ Match(p, d))
    \/ (Step_JobSP_C_Fail /\ Match(p, d))
    \/ (Step_JobSP_C_FailStop /\ Match(p, d))
    \/ (Step_JobSP_C_FailCancel /\ Match(p, d))
    \/ (Step_JobSP_C_FailStatus /\ Match(p, d))
    \/ (Step_JobSP_C_OtherLaunch /\ Match(p, d))
    \/ (Step_JobSP_C_OtherExit /\ Match(p, d))
    \/ (Step_JobSP_C_OtherComplete /\ Match(p, d))
    \/ (Step_JobSP_C_OtherDelete /\ Match(p, d))
    \/ (Step_JobSP_C_ObserveSJExit /\ Match(p, d))
    \/ (Step_JobSP_C_ObserveSJExitStatusLost /\ Match(p, d))
    \/ (Step_JobSP_C_Terminate /\ Match(p, d))
    \/ (Step_JobSP_C_RemoveAfterTerminate /\ Match(p, d))
    \/ (Step_JobSP_C_AbortRead /\ Match(p, d))
    \/ (Step_JobSP_C_AbortRunningSend /\ Match(p, d))
    \/ (Step_JobSP_C_AbortRunningNoSJ /\ Match(p, d))
    \/ (Step_JobSP_C_MarkAborted /\ Match(p, d))
    \/ (Step_JobSP_C_ShutStart /\ Match(p, d))
    \/ (Step_JobSP_C_ShutStop /\ Match(p, d))
    \/ (Step_JobSP_C_ShutDone /\ Match(p, d))
    \/ (Step_JobSP_C_SelectCompletion /\ Match(p, d))
    \/ (Step_JobSP_C_OutcomeGraceExpired /\ Match(p, d))
    \/ (Step_JobSP_C_Classify /\ Match(p, d))
    \/ (Step_JobSP_C_PublishTerminal /\ Match(p, d))
    \/ (Step_JobSP_C_RemoveCompleted /\ Match(p, d))
    \/ (Step_JobSP_C_RemoveCompletedMissing /\ Match(p, d))
    \/ (Step_JobSP_C_Delete /\ Match(p, d))
    \/ (Step_JobSP_C_DeletedCrash /\ Match(p, d))
    \/ (Step_JobSP_C_SPCrashRestart /\ Match(p, d))
    \/ (Step_JobSP_C_HeartbeatStop /\ Match(p, d))
    \/ (Step_JobSP_C_ResolveMissingOutcome /\ Match(p, d))
    \/ (Step_JobSP_C_RecvOutcome /\ Match(p, d))
    \/ (Step_JobSP_F_DefaultJobSchedulerBeginPass /\ Match(p, d))
    \/ (Step_JobSP_F_ShutdownStart /\ Match(p, d))
    \/ (Step_JobSP_F_ShutdownIterError /\ Match(p, d))
    \/ (Step_JobSP_F_ShutdownStopJobAny /\ Match(p, d))
    \/ (Step_JobSP_F_ShutdownEnd /\ Match(p, d))
    \/ (Step_JobSP_F_DefaultJobSchedulerEndPass /\ Match(p, d))
    \/ (Step_JobSP_F_DefaultJobSchedulerSkipBackoff /\ Match(p, d))
    \/ (Step_JobSP_F_DefaultJobSchedulerBackoffElapsed /\ Match(p, d))
    \/ (Step_JobSP_F_DefaultJobSchedulerExhausted /\ Match(p, d))
    \/ (Step_JobSP_F_DefaultJobSchedulerTryJob /\ Match(p, d))
    \/ (Step_JobSP_F_ServerEngineCheckClientResources /\ Match(p, d))
    \/ (Step_JobSP_F_AdminCheckTimeout /\ Match(p, d))
    \/ (Step_JobSP_F_AdminDeployTimeout /\ Match(p, d))
    \/ (Step_JobSP_F_AdminStartTimeout /\ Match(p, d))
    \/ (Step_JobSP_F_AdminCancelTimeout /\ Match(p, d))
    \/ (Step_JobSP_F_DefaultJobSchedulerEvaluateResources /\ Match(p, d))
