Step_WfSJ_C_Count == \E c \in Sites : (/\ Grain["WfSJ"] = "C" /\ "WfSJ" \notin DOMAIN SiteGrain /\ WfSJ_C!Count(c) /\ UNCHANGED <<pJobSP, pJobCP, pRunCJ, pTaskCJ, pPaySrc, pPayRcv, pCommSJ, pTrainer, jobSP_c, jobSP_f, jobCP_c, jobCP_f, runCJ_c, runCJ_f, taskCJ_c, trainer_c, trainer_f, paySrc_c, paySrc_f, payRcv_c, payRcv_f, commSJ_c, net_r, net_l>> /\ Assert(NetOK("WfSJ"), "net discipline: Step_WfSJ_C_Count"))
Step_WfSJ_C_Accept == \E c \in Sites : (/\ Grain["WfSJ"] = "C" /\ "WfSJ" \notin DOMAIN SiteGrain /\ WfSJ_C!Accept(c) /\ UNCHANGED <<pJobSP, pJobCP, pRunCJ, pTaskCJ, pPaySrc, pPayRcv, pCommSJ, pTrainer, jobSP_c, jobSP_f, jobCP_c, jobCP_f, runCJ_c, runCJ_f, taskCJ_c, trainer_c, trainer_f, paySrc_c, paySrc_f, payRcv_c, payRcv_f, commSJ_c, net_r, net_l>> /\ Assert(NetOK("WfSJ"), "net discipline: Step_WfSJ_C_Accept"))
Step_WfSJ_C_Return == \E c \in Sites : (/\ Grain["WfSJ"] = "C" /\ "WfSJ" \notin DOMAIN SiteGrain /\ WfSJ_C!Return(c) /\ UNCHANGED <<pJobSP, pJobCP, pRunCJ, pTaskCJ, pPaySrc, pPayRcv, pCommSJ, pTrainer, jobSP_c, jobSP_f, jobCP_c, jobCP_f, runCJ_c, runCJ_f, taskCJ_c, trainer_c, trainer_f, paySrc_c, paySrc_f, payRcv_c, payRcv_f, commSJ_c, net_r, net_l>> /\ Assert(NetOK("WfSJ"), "net discipline: Step_WfSJ_C_Return"))
Step_Net_L_Lose == \E k \in DOMAIN net : (/\ Grain["Net"] = "L" /\ "Net" \notin DOMAIN SiteGrain /\ Net_L!Lose(k) /\ UNCHANGED <<pJobSP, pJobCP, pRunCJ, pTaskCJ, pPaySrc, pPayRcv, pCommSJ, pWfSJ, pTrainer, jobSP_c, jobSP_f, jobCP_c, jobCP_f, runCJ_c, runCJ_f, taskCJ_c, trainer_c, trainer_f, paySrc_c, paySrc_f, payRcv_c, payRcv_f, commSJ_c, wfSJ_c, net_r>> /\ Assert(NetLossOK, "net discipline: Step_Net_L_Lose"))

