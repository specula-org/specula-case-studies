---- MODULE TraceMix_allC ----
\* Mix copy + port-level trace cursor (see gen_trace.py)
\* GENERATED by scripts/gen_mix.py from spec/registry.json. Do not edit.
\* Grain maps each group to one of its variants; unselected variants keep
\* their private variables at Init (constant), so they add no states.
EXTENDS Ports, TLC, TLC
CONSTANT Grain, SiteGrain
VARIABLES jobSP_c, jobSP_f, jobCP_c, jobCP_f, runCJ_c, runCJ_f, taskCJ_c, trainer_c, trainer_f, paySrc_c, paySrc_f, payRcv_c, payRcv_f, commSJ_c, wfSJ_c, net_r, net_l
privVars == <<jobSP_c, jobSP_f, jobCP_c, jobCP_f, runCJ_c, runCJ_f, taskCJ_c, trainer_c, trainer_f, paySrc_c, paySrc_f, payRcv_c, payRcv_f, commSJ_c, wfSJ_c, net_r, net_l>>
allVars == <<portVars, privVars>>
Groups == {"JobSP", "JobCP", "RunCJ", "TaskCJ", "Trainer", "PaySrc", "PayRcv", "CommSJ", "WfSJ", "Net"}
VariantsOf == [g \in Groups |-> CASE g = "JobSP" -> {"C", "F"}
    [] g = "JobCP" -> {"C", "F"}
    [] g = "RunCJ" -> {"C", "F"}
    [] g = "TaskCJ" -> {"C"}
    [] g = "Trainer" -> {"C", "F"}
    [] g = "PaySrc" -> {"C", "F"}
    [] g = "PayRcv" -> {"C", "F"}
    [] g = "CommSJ" -> {"C"}
    [] g = "WfSJ" -> {"C"}
    [] g = "Net" -> {"R", "L"}]
\* Grain[g]: variant per group. SiteGrain: optional per-site override, a function
\* from a subset of the per-site groups to [Sites -> variant] (per-site grain).
ASSUME DOMAIN Grain = Groups /\ \A g \in Groups : Grain[g] \in VariantsOf[g]
ASSUME DOMAIN SiteGrain \subseteq Groups /\ \A g \in DOMAIN SiteGrain : SiteGrain[g] \in [Sites -> VariantsOf[g]]
GrainAt(g, c) == IF g \in DOMAIN SiteGrain THEN SiteGrain[g][c] ELSE Grain[g]
GrainHas(g, v) == IF g \in DOMAIN SiteGrain THEN \E c \in Sites : SiteGrain[g][c] = v ELSE Grain[g] = v
SitesFor(g, v) == {c \in Sites : GrainAt(g, c) = v}
KindOwner(kind) == CASE kind \in {"CHECK_RESOURCES", "CANCEL_RESOURCES", "DEPLOY_JOB", "START_JOB", "ABORT_JOB", "HEARTBEAT_STOP"} -> "JobSP"
    [] kind \in {"RESOURCES_OK", "CANCEL_ACK", "DEPLOY_REPLY", "START_REPLY", "OUTCOME", "HEARTBEAT"} -> "JobCP"
    [] kind \in {"STARTED", "READY", "STOPPED"} -> "RunCJ"
    [] kind \in {"GET_TASK", "TASK_CHECK", "RESULT_ENVELOPE"} -> "TaskCJ"
    [] kind \in {"PAYLOAD_REPLY"} -> "PaySrc"
    [] kind \in {"PAYLOAD_PULL", "RECEIVER_CONFIRM", "RECEIVER_CANCEL"} -> "PayRcv"
    [] kind \in {"TASK_ASSIGNMENT", "TASK_CHECK_REPLY", "RESULT_RECEIPT"} -> "CommSJ"
    [] kind \in {"END_RUN"} -> "WfSJ"
    [] OTHER -> "none"
\* Net discipline (asserted on every step): existing messages are immutable;
\* new keys carry only kinds owned by the stepping group and start not-lost;
\* only the Net group flips lost flags (FALSE -> TRUE) and adds nothing.
NetKeep == DOMAIN net \subseteq DOMAIN net' /\ \A k \in DOMAIN net : net'[k] = net[k]
NetOK(g) == NetKeep /\ \A k \in DOMAIN net' \ DOMAIN net :
    KindOwner(net'[k].msg.kind) = g /\ ~net'[k].lost /\ net'[k].msg.from \in Processes
NetLossOK == DOMAIN net' = DOMAIN net /\ \A k \in DOMAIN net :
    net'[k].msg = net[k].msg /\ (net[k].lost => net'[k].lost)
JobSP_C == INSTANCE JobSP_C
JobSP_F == INSTANCE JobSP_F
JobCP_C == INSTANCE JobCP_C
JobCP_F == INSTANCE JobCP_F
RunCJ_C == INSTANCE RunCJ_C
RunCJ_F == INSTANCE RunCJ_F
TaskCJ_C == INSTANCE TaskCJ_C
Trainer_C == INSTANCE Trainer_C
Trainer_F == INSTANCE Trainer_F
PaySrc_C == INSTANCE PaySrc_C
PaySrc_F == INSTANCE PaySrc_F
PayRcv_C == INSTANCE PayRcv_C
PayRcv_F == INSTANCE PayRcv_F
CommSJ_C == INSTANCE CommSJ_C
WfSJ_C == INSTANCE WfSJ_C
Net_R == INSTANCE Net_R
Net_L == INSTANCE Net_L

Init == /\ PortsInit
        /\ JobSP_C!Init
        /\ JobSP_F!Init
        /\ JobCP_C!Init
        /\ JobCP_F!Init
        /\ RunCJ_C!Init
        /\ RunCJ_F!Init
        /\ TaskCJ_C!Init
        /\ Trainer_C!Init
        /\ Trainer_F!Init
        /\ PaySrc_C!Init
        /\ PaySrc_F!Init
        /\ PayRcv_C!Init
        /\ PayRcv_F!Init
        /\ CommSJ_C!Init
        /\ WfSJ_C!Init
        /\ Net_R!Init
        /\ Net_L!Init

Step_JobSP_C_SendCheck == (/\ Grain["JobSP"] = "C" /\ "JobSP" \notin DOMAIN SiteGrain /\ JobSP_C!SendCheck /\ UNCHANGED <<pJobCP, pRunCJ, pTaskCJ, pPaySrc, pPayRcv, pCommSJ, pWfSJ, pTrainer, jobSP_f, jobCP_c, jobCP_f, runCJ_c, runCJ_f, taskCJ_c, trainer_c, trainer_f, paySrc_c, paySrc_f, payRcv_c, payRcv_f, commSJ_c, wfSJ_c, net_r, net_l>> /\ Assert(NetOK("JobSP"), "net discipline: Step_JobSP_C_SendCheck"))
