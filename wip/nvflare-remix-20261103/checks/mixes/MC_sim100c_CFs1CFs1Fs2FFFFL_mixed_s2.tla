MCGrain == [JobSP |-> "C", JobCP |-> "C", RunCJ |-> "C", TaskCJ |-> "C", Trainer |-> "C", PaySrc |-> "F", PayRcv |-> "F", CommSJ |-> "F", WfSJ |-> "F", Net |-> "L"]
MCSiteGrain == ("JobCP" :> (s1 :> "F" @@ s2 :> "C") @@ "TaskCJ" :> (s1 :> "F" @@ s2 :> "C") @@ "Trainer" :> (s1 :> "C" @@ s2 :> "F"))
MCFaults == {"abort", "cbFail", "cjCrash", "deadClient", "pullTimeout", "resExpiry", "rpcTimeout", "slowAdminStop", "slowSJTeardown", "submitTimeout", "taskTimeout", "txTimeout"}
