+/*
+ * TLA+ trace emitter for Besu QBFT consensus (Round-2 spec).
+ *
+ * Emits NDJSON lines compatible with Trace.tla. Activated by:
+ *   -Dtla.trace.file=/path/to/trace.ndjson
+ * When unset, all methods are no-ops.
+ *
+ * Schema (matches .specula-output/spec/Trace.tla):
+ *   {"tag":"trace","ts":"<iso>","event":{
+ *     "name":"<ActionName>",
+ *     "node":"<sN>",
+ *     "state":{
+ *       "heightManagerHeight":<int>,
+ *       "chainHeight":<int>,
+ *       "currentRound":<int|"Nil">,
+ *       "proposalAccepted":<bool>,
+ *       "prepared":<bool>,
+ *       "committed":<bool>,
+ *       "blockImported":<bool>
+ *     },
+ *     "msg":{"type":"<MsgType>","sender":"<sN>","height":<int>,"round":<int>}
+ *   }}
+ */
+package org.hyperledger.besu.consensus.qbft.core.statemachine;
+
+import org.hyperledger.besu.consensus.common.bft.ConsensusRoundIdentifier;
+import org.hyperledger.besu.consensus.common.bft.messagewrappers.BftMessage;
+import org.hyperledger.besu.datatypes.Address;
+
+import java.io.BufferedWriter;
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Paths;
+import java.time.Instant;
+import java.util.Locale;
+import java.util.Optional;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.atomic.AtomicReference;
+
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+
+/** Static TLA+ trace emitter. Thread-safe via a single mutex on the writer. */
+public final class TlaTracer {
+
+  private static final Logger LOG = LoggerFactory.getLogger(TlaTracer.class);
+  private static final AtomicReference<BufferedWriter> WRITER = new AtomicReference<>();
+
+  // Address (hex lowercase) -> TLA+ name ("s1".."s4").
+  private static final java.util.Map<String, String> ADDRESS_MAP = new ConcurrentHashMap<>();
+
+  // Per-node sidecar: tracks chainHeight and blockImported (not directly accessible
+  // from QbftBlockHeightManager, since QbftFinalState does not expose blockchain).
+  private static final java.util.Map<String, Long> CHAIN_HEIGHT = new ConcurrentHashMap<>();
+  private static final java.util.Map<String, Boolean> BLOCK_IMPORTED = new ConcurrentHashMap<>();
+
+  private TlaTracer() {}
+
+  /** Open the trace file. Invoked once per scenario. */
+  public static void init() {
+    final String path = System.getProperty("tla.trace.file");
+    if (path == null || path.isEmpty()) {
+      return;
+    }
+    try {
+      WRITER.set(Files.newBufferedWriter(Paths.get(path), StandardCharsets.UTF_8));
+    } catch (final IOException e) {
+      throw new RuntimeException("Failed to open TLA trace file: " + path, e);
+    }
+  }
+
+  /** Flush and close the trace file. Also clears all sidecar state. */
+  public static void close() {
+    final BufferedWriter w = WRITER.getAndSet(null);
+    if (w != null) {
+      try {
+        w.flush();
+        w.close();
+      } catch (final IOException e) {
+        LOG.warn("Failed to close TLA trace file", e);
+      }
+    }
+    ADDRESS_MAP.clear();
+    CHAIN_HEIGHT.clear();
+    BLOCK_IMPORTED.clear();
+  }
+
+  static boolean isEnabled() {
+    return WRITER.get() != null;
+  }
+
+  /** Register the mapping from a Besu Address to its TLA+ spec name ("s1", etc.). */
+  public static void registerNode(final Address addr, final String tlaName) {
+    ADDRESS_MAP.put(addr.toHexString().toLowerCase(Locale.ROOT), tlaName);
+  }
+
+  /** Look up the TLA+ name for a given Besu Address. Falls back to hex. */
+  public static String nid(final Address addr) {
+    if (addr == null) {
+      return "unknown";
+    }
+    final String hex = addr.toHexString().toLowerCase(Locale.ROOT);
+    return ADDRESS_MAP.getOrDefault(hex, hex);
+  }
+
+  // ---------------------------------------------------------------------------
+  // Sidecar updates
+  // ---------------------------------------------------------------------------
+
+  /**
+   * Record that a block was successfully imported at the given height by the given local
+   * node. Sets blockImported=true and chainHeight=height for this node.
+   * Called from QbftRound.importBlockToChain when result == true.
+   */
+  public static void recordBlockImported(final Address localAddr, final long height) {
+    final String key = nid(localAddr);
+    CHAIN_HEIGHT.put(key, height);
+    BLOCK_IMPORTED.put(key, Boolean.TRUE);
+  }
+
+  /**
+   * Record that a new chain head was observed (via the BFT event-queue NewChainHead).
+   * Resets blockImported=false for the new height window and sets chainHeight to the
+   * advertised number. Called from QbftController.handleNewBlockEvent after
+   * startNewHeightManager returns.
+   */
+  public static void recordNewChainHead(final Address localAddr, final long height) {
+    final String key = nid(localAddr);
+    CHAIN_HEIGHT.put(key, height);
+    BLOCK_IMPORTED.put(key, Boolean.FALSE);
+  }
+
+  private static long chainHeightFor(final Address localAddr) {
+    return CHAIN_HEIGHT.getOrDefault(nid(localAddr), 0L);
+  }
+
+  private static boolean blockImportedFor(final Address localAddr) {
+    return BLOCK_IMPORTED.getOrDefault(nid(localAddr), Boolean.FALSE);
+  }
+
+  // ---------------------------------------------------------------------------
+  // Emit entrypoints
+  // ---------------------------------------------------------------------------
+
+  /**
+   * Emit an event from the QbftBlockHeightManager context. Captures the full
+   * post-state (heightManagerHeight, currentRound, proposalAccepted, prepared,
+   * committed, plus the chainHeight/blockImported sidecars).
+   *
+   * @param eventName one of "StartRound0", "HandleProposal", "HandlePrepare",
+   *                  "HandleCommit", "HandleRoundChange", "RoundExpiry"
+   * @param manager   the active QbftBlockHeightManager
+   * @param localAddr the local node Address
+   * @param msg       optional BFT message that triggered this event (null for none)
+   */
+  public static void emitFromManager(
+      final String eventName,
+      final BaseQbftBlockHeightManager manager,
+      final Address localAddr,
+      final BftMessage<?> msg) {
+    if (!isEnabled()) {
+      return;
+    }
+
+    final long heightManagerHeight = manager.getChainHeight();
+    final Optional<QbftRound> r = manager.getCurrentRound();
+
+    final String currentRoundStr;
+    final boolean proposalAccepted;
+    final boolean prepared;
+    final boolean committed;
+    if (r.isPresent()) {
+      final QbftRound qr = r.get();
+      currentRoundStr = Integer.toString(qr.getRoundIdentifier().getRoundNumber());
+      final RoundState rs = qr.getRoundState();
+      proposalAccepted = rs.getProposedBlock().isPresent();
+      prepared = rs.isPrepared();
+      committed = rs.isCommitted();
+    } else {
+      currentRoundStr = "\"Nil\"";
+      proposalAccepted = false;
+      prepared = false;
+      committed = false;
+    }
+
+    final long chainHeight = chainHeightFor(localAddr);
+    final boolean blockImported = blockImportedFor(localAddr);
+
+    writeEvent(
+        eventName,
+        nid(localAddr),
+        heightManagerHeight,
+        chainHeight,
+        currentRoundStr,
+        proposalAccepted,
+        prepared,
+        committed,
+        blockImported,
+        msg);
+  }
+
+  /**
+   * Emit the StartNewHeightManager event from the QbftController context.
+   * At this point the new manager has been created, message replay is done, and
+   * the new height window is open (currentRound is empty).
+   */
+  public static void emitStartNewHeightManager(
+      final BaseQbftBlockHeightManager manager, final Address localAddr) {
+    emitFromManager("StartNewHeightManager", manager, localAddr, null);
+  }
+
+  // ---------------------------------------------------------------------------
+  // JSON writer
+  // ---------------------------------------------------------------------------
+
+  private static void writeEvent(
+      final String eventName,
+      final String nodeId,
+      final long heightManagerHeight,
+      final long chainHeight,
+      final String currentRoundJson, // either an int literal or the quoted "Nil" string
+      final boolean proposalAccepted,
+      final boolean prepared,
+      final boolean committed,
+      final boolean blockImported,
+      final BftMessage<?> msg) {
+
+    final StringBuilder sb = new StringBuilder(256);
+    sb.append("{\"tag\":\"trace\",\"ts\":\"")
+        .append(Instant.now().toString())
+        .append("\",\"event\":{\"name\":\"")
+        .append(eventName)
+        .append("\",\"node\":\"")
+        .append(nodeId)
+        .append("\",\"state\":{\"heightManagerHeight\":")
+        .append(heightManagerHeight)
+        .append(",\"chainHeight\":")
+        .append(chainHeight)
+        .append(",\"currentRound\":")
+        .append(currentRoundJson)
+        .append(",\"proposalAccepted\":")
+        .append(proposalAccepted)
+        .append(",\"prepared\":")
+        .append(prepared)
+        .append(",\"committed\":")
+        .append(committed)
+        .append(",\"blockImported\":")
+        .append(blockImported)
+        .append("}");
+
+    if (msg != null) {
+      final String msgType = msgTypeName(msg);
+      final ConsensusRoundIdentifier rid = msg.getRoundIdentifier();
+      sb.append(",\"msg\":{\"type\":\"")
+          .append(msgType)
+          .append("\",\"sender\":\"")
+          .append(nid(msg.getAuthor()))
+          .append("\",\"height\":")
+          .append(rid.getSequenceNumber())
+          .append(",\"round\":")
+          .append(rid.getRoundNumber())
+          .append("}");
+    }
+
+    sb.append("}}");
+    writeLine(sb.toString());
+  }
+
+  private static String msgTypeName(final BftMessage<?> msg) {
+    final String cls = msg.getClass().getSimpleName();
+    // Class names: Proposal, Prepare, Commit, RoundChange -> spec types
+    if ("Proposal".equals(cls)) {
+      return "ProposalMsg";
+    }
+    if ("Prepare".equals(cls)) {
+      return "PrepareMsg";
+    }
+    if ("Commit".equals(cls)) {
+      return "CommitMsg";
+    }
+    if ("RoundChange".equals(cls)) {
+      return "RoundChangeMsg";
+    }
+    return cls + "Msg";
+  }
+
+  private static void writeLine(final String json) {
+    final BufferedWriter w = WRITER.get();
+    if (w == null) {
+      return;
+    }
+    synchronized (w) {
+      try {
+        w.write(json);
+        w.newLine();
+        w.flush();
+      } catch (final IOException e) {
+        LOG.warn("Failed to write TLA trace line", e);
+      }
+    }
+  }
+}
