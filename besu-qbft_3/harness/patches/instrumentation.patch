+++ b/consensus/qbft-core/src/integration-test/java/org/hyperledger/besu/consensus/qbft/core/test/TlaTraceTest.java
@@ -0,0 +1,212 @@
+/*
+ * Integration test that exercises the real QBFT state machine and produces
+ * NDJSON trace files for TLA+ Trace.tla validation.
+ *
+ * Activate via: -Dtla.trace.file=<path>
+ * Each @Test sets its own trace file before running.
+ */
+package org.hyperledger.besu.consensus.qbft.core.test;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import org.hyperledger.besu.consensus.common.bft.ConsensusRoundIdentifier;
+import org.hyperledger.besu.consensus.common.bft.events.BlockTimerExpiry;
+import org.hyperledger.besu.consensus.common.bft.events.RoundExpiry;
+import org.hyperledger.besu.consensus.qbft.core.statemachine.TlaTracer;
+import org.hyperledger.besu.consensus.qbft.core.support.RoundSpecificPeers;
+import org.hyperledger.besu.consensus.qbft.core.support.TestContext;
+import org.hyperledger.besu.consensus.qbft.core.support.TestContextBuilder;
+import org.hyperledger.besu.consensus.qbft.core.support.ValidatorPeer;
+import org.hyperledger.besu.consensus.qbft.core.types.QbftBlock;
+import org.hyperledger.besu.consensus.qbft.core.types.QbftNewChainHead;
+
+import java.time.Clock;
+import java.time.Instant;
+import java.time.ZoneId;
+import java.util.Optional;
+
+import org.junit.jupiter.api.AfterAll;
+import org.junit.jupiter.api.Test;
+
+/** Generates NDJSON traces from the real QBFT state machine for TLA+ Trace.tla validation. */
+public class TlaTraceTest {
+
+  private static final int NETWORK_SIZE = 4;
+  private static final long BLOCK_TIMESTAMP = 100;
+  private static final Clock FIXED_CLOCK =
+      Clock.fixed(Instant.ofEpochSecond(BLOCK_TIMESTAMP), ZoneId.systemDefault());
+
+  /** Directory for trace output files (resolved from gradle working dir). */
+  private static final String TRACE_DIR = System.getProperty("user.dir") + "/";
+
+  @AfterAll
+  static void closeTracer() {
+    TlaTracer.close();
+  }
+
+  /** Start a fresh trace file. Closes any prior tracer state. */
+  private static void startTrace(final String filename) {
+    TlaTracer.close();
+    System.setProperty("tla.trace.file", TRACE_DIR + filename);
+    TlaTracer.init();
+  }
+
+  /**
+   * Scenario 1: local node is the proposer for height 1 round 0.
+   * Generates:
+   *   StartRound0 (local-as-proposer) → HandlePrepare × 2 →
+   *   HandleCommit × 2 (last one triggers block import) → StartNewHeightManager
+   */
+  @Test
+  void localProposerHappyPath() {
+    startTrace("besu_qbft_local_proposer.ndjson");
+
+    final TestContext context =
+        new TestContextBuilder()
+            .validatorCount(NETWORK_SIZE)
+            .indexOfFirstLocallyProposedBlock(1) // local is proposer for height 1
+            .clock(FIXED_CLOCK)
+            .buildAndStart();
+    registerNodes(context);
+
+    final ConsensusRoundIdentifier roundId = new ConsensusRoundIdentifier(1, 0);
+    final RoundSpecificPeers peers = context.roundSpecificPeers(roundId);
+    final QbftBlock block = context.createBlockForProposalFromChainHead(BLOCK_TIMESTAMP);
+
+    // 1. Block timer fires; local node proposes (self-prepare + self-commit included).
+    context.getController().handleBlockTimerExpiry(new BlockTimerExpiry(roundId));
+    peers.clearReceivedMessages();
+
+    // 2. Two peers send Prepare (quorum=3 with local's self-prepare); local sends Commit.
+    peers.getNonProposing(0).injectPrepare(roundId, block.getHash());
+    peers.getNonProposing(1).injectPrepare(roundId, block.getHash());
+    peers.clearReceivedMessages();
+
+    // 3. Two peers send Commit (quorum reached); block is imported.
+    peers.getNonProposing(0).injectCommit(roundId, block);
+    peers.getNonProposing(1).injectCommit(roundId, block);
+    assertThat(context.getCurrentChainHeight()).isEqualTo(1);
+    peers.clearReceivedMessages();
+
+    // 4. NewChainHead event signals the new height window opens.
+    context.getController().handleNewBlockEvent(new QbftNewChainHead(block.getHeader()));
+  }
+
+  /**
+   * Scenario 2: local node is NOT proposer; remote peer 'proposer' broadcasts.
+   * Generates:
+   *   HandleProposal (from proposer) → HandlePrepare × 2 →
+   *   HandleCommit × 2 → StartNewHeightManager
+   */
+  @Test
+  void localNonProposerHappyPath() {
+    startTrace("besu_qbft_remote_proposer.ndjson");
+
+    final TestContext context =
+        new TestContextBuilder()
+            .validatorCount(NETWORK_SIZE)
+            .indexOfFirstLocallyProposedBlock(0) // local is NOT proposer for height 1
+            .clock(FIXED_CLOCK)
+            .buildAndStart();
+    registerNodes(context);
+
+    final ConsensusRoundIdentifier roundId = new ConsensusRoundIdentifier(1, 0);
+    final RoundSpecificPeers peers = context.roundSpecificPeers(roundId);
+    final ValidatorPeer proposer = peers.getProposer();
+    final QbftBlock block =
+        context.createBlockForProposalFromChainHead(BLOCK_TIMESTAMP, proposer.getNodeAddress());
+
+    // 1. Block timer fires for non-proposer (starts round 0, no proposal sent).
+    context.getController().handleBlockTimerExpiry(new BlockTimerExpiry(roundId));
+    peers.clearReceivedMessages();
+
+    // 2. Remote proposer's Proposal arrives; local accepts, broadcasts Prepare.
+    proposer.injectProposal(roundId, block);
+    peers.clearReceivedMessages();
+
+    // 3. Two non-proposing peers send Prepare; local hits prepared quorum, broadcasts Commit.
+    peers.getNonProposing(0).injectPrepare(roundId, block.getHash());
+    peers.getNonProposing(1).injectPrepare(roundId, block.getHash());
+    peers.clearReceivedMessages();
+
+    // 4. Two non-proposing peers send Commit; with proposer's commit-on-proposal-accept and
+    //    local's auto-commit-on-prepare, quorum reached → import.
+    peers.getNonProposing(0).injectCommit(roundId, block);
+    peers.getNonProposing(1).injectCommit(roundId, block);
+    assertThat(context.getCurrentChainHeight()).isEqualTo(1);
+    peers.clearReceivedMessages();
+
+    // 5. NewChainHead opens height 2.
+    context.getController().handleNewBlockEvent(new QbftNewChainHead(block.getHeader()));
+  }
+
+  /**
+   * Scenario 3: round 0 times out, RoundChange to round 1.
+   * Generates:
+   *   StartRound0 → RoundExpiry → HandleRoundChange (× number of peer RCs)
+   */
+  @Test
+  void roundChangeAfterTimeout() {
+    startTrace("besu_qbft_round_change.ndjson");
+
+    final TestContext context =
+        new TestContextBuilder()
+            .validatorCount(NETWORK_SIZE)
+            .indexOfFirstLocallyProposedBlock(1) // local proposer for height 1 round 0
+            .clock(FIXED_CLOCK)
+            .buildAndStart();
+    registerNodes(context);
+
+    final ConsensusRoundIdentifier round0 = new ConsensusRoundIdentifier(1, 0);
+    final ConsensusRoundIdentifier round1 = new ConsensusRoundIdentifier(1, 1);
+    final RoundSpecificPeers peers = context.roundSpecificPeers(round0);
+
+    // 1. Block timer for round 0; local proposes.
+    context.getController().handleBlockTimerExpiry(new BlockTimerExpiry(round0));
+    peers.clearReceivedMessages();
+
+    // 2. Round 0 timer expires; local node sends RoundChange and steps to round 1.
+    context.getController().handleRoundExpiry(new RoundExpiry(round0));
+    peers.clearReceivedMessages();
+
+    // 3. Two peers also send RoundChange for round 1; this is processed as HandleRoundChange.
+    peers.getNonProposing(0).injectRoundChange(round1, Optional.empty());
+    peers.getNonProposing(1).injectRoundChange(round1, Optional.empty());
+  }
+
+  /**
+   * Register stable address→TLA-name mappings.
+   *
+   * <p>Local node is always "s1". Remote peers (in the order of `remotePeers.values()`) become
+   * "s2", "s3", "s4". This produces a deterministic 4-node namespace for the trace.
+   *
+   * <p>Note: the spec's Proposer(h, r) is determined by ServerSeq, which in TLC for
+   * Server = {s1..s4} typically yields <<s1, s2, s3, s4>>. Whether the trace's claimed proposer
+   * matches what Trace.tla computes depends on Phase 3 alignment (e.g., overriding ServerSeq).
+   */
+  private void registerNodes(final TestContext context) {
+    TlaTracer.registerNode(context.getLocalNodeParams().getAddress(), "s1");
+    final RoundSpecificPeers peers =
+        context.roundSpecificPeers(new ConsensusRoundIdentifier(1, 0));
+    int idx = 2;
+    // Proposer first if it is a remote peer (getProposer() returns null when local is proposer).
+    if (peers.getProposer() != null && idx <= NETWORK_SIZE) {
+      TlaTracer.registerNode(peers.getProposer().getNodeAddress(), "s" + idx);
+      idx++;
+    }
+    // Then non-proposing peers in their order; nonProposingPeers may overlap with proposer
+    // when local is non-proposer, so skip any already-registered peer.
+    for (int i = 0; idx <= NETWORK_SIZE; i++) {
+      try {
+        final ValidatorPeer p = peers.getNonProposing(i);
+        if (peers.getProposer() != null && p.getNodeAddress().equals(peers.getProposer().getNodeAddress())) {
+          continue;
+        }
+        TlaTracer.registerNode(p.getNodeAddress(), "s" + idx);
+        idx++;
+      } catch (final IndexOutOfBoundsException e) {
+        break;
+      }
+    }
+  }
+}
